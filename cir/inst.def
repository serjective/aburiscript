#ifndef ABURI_CIR_INST
#error "Define ABURI_CIR_INST before including cir/inst.def"
#endif

ABURI_CIR_INST(Invalid, "invalid", OperandShape::None, ResultShape::NoResult, "Placeholder for an absent or invalid instruction.")
ABURI_CIR_INST(Param, "param", OperandShape::OneEntity, ResultShape::Explicit, "Function or block parameter value; operand names the backing entity.")
ABURI_CIR_INST(IntegerLiteral, "integer_literal", OperandShape::None, ResultShape::BuiltinInt, "Integer literal value with canonical spelling in the payload.")
ABURI_CIR_INST(BooleanLiteral, "boolean_literal", OperandShape::None, ResultShape::BuiltinBool, "Boolean literal value with canonical spelling in the payload.")
ABURI_CIR_INST(NullptrLiteral, "nullptr_literal", OperandShape::None, ResultShape::Explicit, "nullptr literal; produces a nullptr_t prvalue.")
ABURI_CIR_INST(FloatingLiteral, "floating_literal", OperandShape::None, ResultShape::Explicit, "Floating literal value with canonical spelling and a floating result type.")
ABURI_CIR_INST(CharacterLiteral, "character_literal", OperandShape::None, ResultShape::Explicit, "Character literal value with decoded bytes and canonical spelling.")
ABURI_CIR_INST(StringLiteral, "string_literal", OperandShape::None, ResultShape::Explicit, "String literal object; produces place<char[N]> including the terminator.")
ABURI_CIR_INST(NameRef, "name_ref", OperandShape::OneName, ResultShape::Explicit, "Reference to a named value or placeholder name.")
ABURI_CIR_INST(LocalPlace, "local_place", OperandShape::OneEntity, ResultShape::Explicit, "Addressable storage for a local entity, producing place<T>.")
ABURI_CIR_INST(GlobalPlace, "global_place", OperandShape::OneEntity, ResultShape::Explicit, "Addressable storage for a global or static entity, producing place<T>.")
ABURI_CIR_INST(Load, "load", OperandShape::OnePlace, ResultShape::PlaceObject, "Low-level read from a place<T> operand and produce the stored value.")
ABURI_CIR_INST(LValueToRValue, "lvalue_to_rvalue", OperandShape::OnePlace, ResultShape::PlaceObject, "Apply source-language lvalue-to-rvalue conversion to a place<T> operand.")
ABURI_CIR_INST(FunctionToPointer, "function_to_pointer", OperandShape::OneEntity, ResultShape::Explicit, "Convert a function designator entity to a pointer-to-function value.")
ABURI_CIR_INST(MemberPointerValue, "member_pointer_value", OperandShape::OneEntity, ResultShape::Explicit, "Convert a member designator entity to a symbolic pointer-to-member value.")
ABURI_CIR_INST(LabelAddress, "label_address", OperandShape::None, ResultShape::Explicit, "Address of a local label as a void* value for GNU computed goto.")
ABURI_CIR_INST(Store, "store", OperandShape::PlaceValue, ResultShape::NoResult, "Write a value operand into a place<T> operand; produces no value.")
ABURI_CIR_INST(ZeroObject, "zero_object", OperandShape::OnePlace, ResultShape::NoResult, "Zero-initialize the complete object denoted by a place<T> operand.")
ABURI_CIR_INST(StackAlloc, "stack_alloc", OperandShape::TypeValue, ResultShape::Explicit, "Allocate runtime-sized automatic storage: type operand is the object type, value operand the total byte size; produces place<T>.")
ABURI_CIR_INST(StackSave, "stack_save", OperandShape::None, ResultShape::Explicit, "Capture the current stack pointer for later restoration.")
ABURI_CIR_INST(StackRestore, "stack_restore", OperandShape::OneValue, ResultShape::NoResult, "Restore the stack pointer captured by stack_save.")
ABURI_CIR_INST(LifetimeStart, "lifetime_start", OperandShape::VariadicValues, ResultShape::NoResult, "Mark the start of a local place operand's live range so backends may overlap disjoint stack slots; operandless after suppression (a label made the enclosing scope jump-enterable).")
ABURI_CIR_INST(LifetimeEnd, "lifetime_end", OperandShape::VariadicValues, ResultShape::NoResult, "Mark the end of a local place operand's live range; only emitted on the normal scope-exit path (its absence is conservative).")
ABURI_CIR_INST(AtomicLoad, "atomic_load", OperandShape::OnePlace, ResultShape::PlaceObject, "Atomically read from a place<T> operand with the payload memory order.")
ABURI_CIR_INST(AtomicStore, "atomic_store", OperandShape::PlaceValue, ResultShape::NoResult, "Atomically write a value operand into a place<T> operand with the payload memory order.")
ABURI_CIR_INST(AtomicRmw, "atomic_rmw", OperandShape::PlaceValue, ResultShape::PlaceObject, "Atomic read-modify-write on a place<T> operand; payload selects the operation and order, result is the prior T value. Pointer Add/Sub take a pointer-width byte delta as the value operand.")
ABURI_CIR_INST(AtomicCmpXchg, "atomic_cmpxchg", OperandShape::VariadicValues, ResultShape::Explicit, "Atomic compare-exchange: place, expected place, desired value; stores the prior value into the expected place and yields bool success.")
ABURI_CIR_INST(AtomicFence, "atomic_fence", OperandShape::None, ResultShape::NoResult, "Thread fence with the payload memory order.")
ABURI_CIR_INST(ComplexMake, "complex_make", OperandShape::TwoValues, ResultShape::Explicit, "Compose a _Complex value from real and imaginary element operands.")
ABURI_CIR_INST(ComplexReal, "complex_real", OperandShape::OneValue, ResultShape::Explicit, "Extract the real element of a _Complex value operand.")
ABURI_CIR_INST(ComplexImag, "complex_imag", OperandShape::OneValue, ResultShape::Explicit, "Extract the imaginary element of a _Complex value operand.")
ABURI_CIR_INST(ComplexRealPlace, "complex_real_place", OperandShape::OnePlace, ResultShape::Explicit, "Form a place<elem> for the real element of a _Complex place operand.")
ABURI_CIR_INST(ComplexImagPlace, "complex_imag_place", OperandShape::OnePlace, ResultShape::Explicit, "Form a place<elem> for the imaginary element of a _Complex place operand.")
ABURI_CIR_INST(AddrOf, "addr_of", OperandShape::OnePlace, ResultShape::PointerToPlaceObject, "Take the address of a place<T> operand and produce pointer-to-T.")
ABURI_CIR_INST(Deref, "deref", OperandShape::OneValue, ResultShape::PlaceOfPointerPointee, "Dereference a pointer operand and produce place<T>.")
ABURI_CIR_INST(FieldAddr, "field_addr", OperandShape::PlaceEntity, ResultShape::Explicit, "Form a place<T> for a field within a base place operand.")
ABURI_CIR_INST(DataMemberPointerPlace, "data_member_pointer_place", OperandShape::TwoValues, ResultShape::Explicit, "Form a place<T> by applying a pointer-to-data-member value to a base place.")
ABURI_CIR_INST(MemberFunctionPointerCallee, "member_function_pointer_callee", OperandShape::TwoValues, ResultShape::Explicit, "Resolve the callable function pointer from an adjusted object pointer and pointer-to-member-function value.")
ABURI_CIR_INST(MemberFunctionPointerThis, "member_function_pointer_this", OperandShape::TwoValues, ResultShape::Explicit, "Apply a pointer-to-member-function this-adjustment to an object pointer.")
ABURI_CIR_INST(ArrayElementPlace, "array_element_place", OperandShape::BaseIndex, ResultShape::Explicit, "Form a place<T> for an array or pointer subscript base and index.")
ABURI_CIR_INST(VectorElementPlace, "vector_element_place", OperandShape::BaseIndex, ResultShape::Explicit, "Form a non-addressable place<T> for a vector lane within a vector place.")
ABURI_CIR_INST(VectorExtract, "vector_extract", OperandShape::BaseIndex, ResultShape::Explicit, "Extract one lane from a vector value.")
ABURI_CIR_INST(SizeofType, "sizeof_type", OperandShape::OneType, ResultShape::Explicit, "Compute sizeof for the type operand.")
ABURI_CIR_INST(AlignofType, "alignof_type", OperandShape::OneType, ResultShape::Explicit, "Compute alignof for the type operand.")
ABURI_CIR_INST(UnaryOp, "unary", OperandShape::OneValue, ResultShape::Explicit, "Apply a unary operator descriptor to one value operand.")
ABURI_CIR_INST(BinaryOp, "binary", OperandShape::TwoValues, ResultShape::Explicit, "Apply a binary operator descriptor to two value operands.")
ABURI_CIR_INST(Cast, "cast", OperandShape::TypeValue, ResultShape::Explicit, "Convert one value operand to the target type operand.")
ABURI_CIR_INST(Call, "call", OperandShape::CalleeAndArguments, ResultShape::Explicit, "Call a direct entity operand or indirect callee value with argument operands.")
ABURI_CIR_INST(VaStart, "va_start", OperandShape::OnePlace, ResultShape::Explicit, "Initialize a source-language va_list object.")
ABURI_CIR_INST(VaArg, "va_arg", OperandShape::TypeValue, ResultShape::Explicit, "Read the next value of the type operand from a source-language va_list object.")
ABURI_CIR_INST(VaEnd, "va_end", OperandShape::OnePlace, ResultShape::Explicit, "Clean up a source-language va_list object.")
ABURI_CIR_INST(VaCopy, "va_copy", OperandShape::TwoValues, ResultShape::Explicit, "Copy a source-language va_list object.")
ABURI_CIR_INST(BuiltinCall, "builtin_call", OperandShape::VariadicValues, ResultShape::Explicit, "Evaluate a source builtin operation selected by the instruction payload.")
ABURI_CIR_INST(InlineAsm, "inline_asm", OperandShape::VariadicValues, ResultShape::NoResult, "GNU inline assembly statement or expression without output values.")
ABURI_CIR_INST(ConstructInPlace, "construct_in_place", OperandShape::PlaceEntityAndArguments, ResultShape::NoResult, "Construct an object in the destination place operand.")
ABURI_CIR_INST(Destroy, "destroy", OperandShape::PlaceOptionalEntity, ResultShape::NoResult, "Destroy the object at the place operand.")
ABURI_CIR_INST(DependentCall, "dependent_call", OperandShape::NameAndArguments, ResultShape::Explicit, "Call whose callee remains dependent or unresolved by name.")
ABURI_CIR_INST(DependentRegion, "dependent_region", OperandShape::VariadicValues, ResultShape::NoResult, "Template pattern hole: a dependent region whose token range re-collects at instantiation; an optional place operand receives an initializer hole's value.")
ABURI_CIR_INST(EhAllocException, "eh_alloc_exception", OperandShape::OneType, ResultShape::Explicit, "Allocate the exception object buffer for a throw; produces place<T> backed by the EH runtime allocator.")
ABURI_CIR_INST(EhLandingPad, "eh_landing_pad", OperandShape::None, ResultShape::Explicit, "Landing pad header: first instruction of an unwind-edge target block; clause list in the payload; produces the in-flight exception pointer.")
ABURI_CIR_INST(EhSelector, "eh_selector", OperandShape::OneValue, ResultShape::Explicit, "Type-selector word of the enclosing landing pad; must immediately follow it.")
ABURI_CIR_INST(EhTypeId, "eh_typeid_for", OperandShape::OneEntity, ResultShape::BuiltinInt, "Selector value a landing pad produces when the operand typeinfo clause matches.")
ABURI_CIR_INST(CatchBegin, "catch_begin", OperandShape::OneValue, ResultShape::Explicit, "Enter a handler: adjusts the exception pointer to the caught object.")
ABURI_CIR_INST(CatchEnd, "catch_end", OperandShape::None, ResultShape::NoResult, "Leave a handler; releases the exception object if it was the last reference.")
ABURI_CIR_INST(ReflectValue, "reflect_value", OperandShape::TypeOrEntity, ResultShape::Explicit, "C++26 reflection operator (^^): produce the std::meta::info handle for the type or entity operand; consteval-only.")
ABURI_CIR_INST(CoroBegin, "coro_begin", OperandShape::OneValue, ResultShape::Explicit, "Canonical coroutine frame pointer (void*) derived from the raw allocation operand; exactly one per pre-split coroutine function; the coro split pass's anchor.")
ABURI_CIR_INST(CoroFrameSize, "coro_frame_size", OperandShape::None, ResultShape::Explicit, "Coroutine frame size in bytes (usize); a placeholder the coro split pass materializes as an integer literal after frame layout.")
ABURI_CIR_INST(CoroFrameAlign, "coro_frame_align", OperandShape::None, ResultShape::Explicit, "Coroutine frame alignment in bytes (usize); materialized by the coro split pass after frame layout.")
ABURI_CIR_INST(CoroPromisePlace, "coro_promise_place", OperandShape::OneValue, ResultShape::Explicit, "place<P> of the promise object inside the frame-pointer operand; the coro split pass rewrites it to pointer arithmetic over the frame record.")
ABURI_CIR_INST(CoroSave, "coro_save", OperandShape::None, ResultShape::NoResult, "Commit suspended-at-index state (payload index/kind) BEFORE await_suspend runs; the frame-spill boundary. The Final kind also nulls the frame resume pointer so done() holds.")
ABURI_CIR_INST(CoroTransfer, "coro_transfer", OperandShape::OneValue, ResultShape::NoResult, "Symmetric transfer: resume the coroutine whose frame pointer is the operand; must immediately precede a coro_suspend terminator in a block with no unwind target.")
ABURI_CIR_INST(ObjCMessageSend, "objc_msg_send", OperandShape::VariadicValues, ResultShape::Explicit, "Objective-C dynamic dispatch: optional receiver value plus argument values with selector/receiver-kind payload; the objc lowering pass expands it to a selref load and objc_msgSend-family call.")
ABURI_CIR_INST(ObjCIvarAddr, "objc_ivar_addr", OperandShape::PlaceEntity, ResultShape::Explicit, "Non-fragile ivar access: object-pointer value operand plus ObjCIvar entity operand; produces place<T> via an OBJC_IVAR_$_ offset-variable load, never a static offset.")
ABURI_CIR_INST(ObjCSelectorLiteral, "objc_selector_literal", OperandShape::None, ResultShape::Explicit, "@selector(...) literal: SEL value loaded from the uniqued selector reference named by the payload.")
ABURI_CIR_INST(ObjCStringLiteral, "objc_string_literal", OperandShape::None, ResultShape::Explicit, "@\"...\" constant string: NSString* address of the synthesized __CFConstantString object; bytes ride LiteralPayload.")
ABURI_CIR_INST(ObjCArcOp, "objc_arc_op", OperandShape::VariadicValues, ResultShape::Explicit, "ARC reference-counting operation on the operand values; the payload picks the flavor and the objc lowering pass expands it to the matching objc_* runtime call.")
ABURI_CIR_INST(Error, "error", OperandShape::None, ResultShape::NoResult, "Error marker instruction used to keep partial CIR inspectable.")
