consteval _ABURI_META_VECTOR_TYPE members_of(info reflection) {
    _ABURI_META_VECTOR_TYPE result;
    unsigned long count = __metafn_range_count(0, reflection);
    for (unsigned long index = 0; index < count; ++index) {
        result.push_back(__metafn_range_at(0, reflection, index));
    }
    return result;
}

