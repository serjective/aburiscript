#ifndef ADINKRA_ARRAY
#define ADINKRA_ARRAY

#include <__adinkra/config>
#include <algorithm>
#include <compare>
#include <cstddef>
#include <iterator>
#include <stdexcept>
#include <type_traits>
#include <utility>

_ADINKRA_BEGIN_NAMESPACE_STD

template<class Type, size_t Size>
struct array {
    using value_type = Type;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using reference = Type&;
    using const_reference = const Type&;
    using pointer = Type*;
    using const_pointer = const Type*;
    using iterator = Type*;
    using const_iterator = const Type*;
    using reverse_iterator = std::reverse_iterator<iterator>;
    using const_reverse_iterator = std::reverse_iterator<const_iterator>;

    Type elements[Size == 0 ? 1 : Size];

    constexpr void fill(const Type& value) {
        std::fill_n(begin(), Size, value);
    }

    constexpr void swap(array& other)
        noexcept(noexcept(std::swap(declval<Type&>(), declval<Type&>()))) {
        std::swap_ranges(begin(), end(), other.begin());
    }

    constexpr iterator begin() noexcept { return elements; }
    constexpr const_iterator begin() const noexcept { return elements; }
    constexpr iterator end() noexcept { return elements + Size; }
    constexpr const_iterator end() const noexcept { return elements + Size; }
    constexpr reverse_iterator rbegin() noexcept {
        return reverse_iterator(end());
    }
    constexpr const_reverse_iterator rbegin() const noexcept {
        return const_reverse_iterator(end());
    }
    constexpr reverse_iterator rend() noexcept {
        return reverse_iterator(begin());
    }
    constexpr const_reverse_iterator rend() const noexcept {
        return const_reverse_iterator(begin());
    }

    constexpr const_iterator cbegin() const noexcept { return begin(); }
    constexpr const_iterator cend() const noexcept { return end(); }
    constexpr const_reverse_iterator crbegin() const noexcept {
        return rbegin();
    }
    constexpr const_reverse_iterator crend() const noexcept {
        return rend();
    }

    _ADINKRA_NODISCARD constexpr bool empty() const noexcept {
        return Size == 0;
    }

    _ADINKRA_NODISCARD constexpr size_type size() const noexcept {
        return Size;
    }

    _ADINKRA_NODISCARD constexpr size_type max_size() const noexcept {
        return Size;
    }

    constexpr reference operator[](size_type index) noexcept {
        return elements[index];
    }

    constexpr const_reference operator[](size_type index) const noexcept {
        return elements[index];
    }

    constexpr reference at(size_type index) {
        if (index >= Size) {
            throw out_of_range("array::at");
        }
        return elements[index];
    }

    constexpr const_reference at(size_type index) const {
        if (index >= Size) {
            throw out_of_range("array::at");
        }
        return elements[index];
    }

    constexpr reference front() noexcept { return elements[0]; }
    constexpr const_reference front() const noexcept { return elements[0]; }
    constexpr reference back() noexcept { return elements[Size - 1]; }
    constexpr const_reference back() const noexcept {
        return elements[Size - 1];
    }
    constexpr pointer data() noexcept { return elements; }
    constexpr const_pointer data() const noexcept { return elements; }
};

template<class Type, class... Rest>
array(Type, Rest...) -> array<Type, 1 + sizeof...(Rest)>;

template<class Type, size_t Size>
_ADINKRA_NODISCARD constexpr bool
operator==(const array<Type, Size>& left,
           const array<Type, Size>& right) {
    return std::equal(left.begin(), left.end(), right.begin());
}

template<class Type, size_t Size>
_ADINKRA_NODISCARD constexpr auto
operator<=>(const array<Type, Size>& left,
            const array<Type, Size>& right) {
    using Result = compare_three_way_result_t<Type>;
    for (size_t index = 0; index < Size; ++index) {
        if (auto result = left[index] <=> right[index]; result != 0) {
            return result;
        }
    }
    return Result::equivalent;
}

template<class Type, size_t Size>
constexpr void swap(array<Type, Size>& left, array<Type, Size>& right)
    noexcept(noexcept(left.swap(right))) {
    left.swap(right);
}

template<size_t Index, class Type, size_t Size>
constexpr Type& get(array<Type, Size>& value) noexcept {
    static_assert(Index < Size);
    return value[Index];
}

template<size_t Index, class Type, size_t Size>
constexpr const Type& get(const array<Type, Size>& value) noexcept {
    static_assert(Index < Size);
    return value[Index];
}

template<size_t Index, class Type, size_t Size>
constexpr Type&& get(array<Type, Size>&& value) noexcept {
    return std::move(get<Index>(value));
}

_ADINKRA_END_NAMESPACE_STD

_ADINKRA_BEGIN_NAMESPACE_STD_UNVERSIONED

template<class Type, size_t Size>
struct tuple_size<array<Type, Size>> : integral_constant<size_t, Size> {};

template<size_t Index, class Type, size_t Size>
struct tuple_element<Index, array<Type, Size>> {
    static_assert(Index < Size);
    using type = Type;
};

_ADINKRA_END_NAMESPACE_STD_UNVERSIONED

_ADINKRA_BEGIN_NAMESPACE_STD

template<class Type, size_t Size>
_ADINKRA_NODISCARD constexpr array<remove_cv_t<Type>, Size>
to_array(Type (&source)[Size]) {
    return [&]<size_t... Indexes>(index_sequence<Indexes...>) {
        return array<remove_cv_t<Type>, Size>{{source[Indexes]...}};
    }(make_index_sequence<Size>{});
}

template<class Type, size_t Size>
_ADINKRA_NODISCARD constexpr array<remove_cv_t<Type>, Size>
to_array(Type (&&source)[Size]) {
    return [&]<size_t... Indexes>(index_sequence<Indexes...>) {
        return array<remove_cv_t<Type>, Size>{{
            std::move(source[Indexes])...
        }};
    }(make_index_sequence<Size>{});
}

_ADINKRA_END_NAMESPACE_STD

#endif
