enum syntax_option_type : unsigned {
    icase = 1U << 0,
    nosubs = 1U << 1,
    optimize = 1U << 2,
    collate = 1U << 3,
    ECMAScript = 1U << 4,
    basic = 1U << 5,
    extended = 1U << 6,
    awk = 1U << 7,
    grep = 1U << 8,
    egrep = 1U << 9,
    multiline = 1U << 10
};

constexpr syntax_option_type operator|(
    syntax_option_type left, syntax_option_type right) noexcept {
    return static_cast<syntax_option_type>(
        static_cast<unsigned>(left) |
        static_cast<unsigned>(right));
}

constexpr syntax_option_type operator&(
    syntax_option_type left, syntax_option_type right) noexcept {
    return static_cast<syntax_option_type>(
        static_cast<unsigned>(left) &
        static_cast<unsigned>(right));
}

constexpr syntax_option_type operator^(
    syntax_option_type left, syntax_option_type right) noexcept {
    return static_cast<syntax_option_type>(
        static_cast<unsigned>(left) ^
        static_cast<unsigned>(right));
}

constexpr syntax_option_type operator~(
    syntax_option_type value) noexcept {
    return static_cast<syntax_option_type>(
        ~static_cast<unsigned>(value));
}

constexpr syntax_option_type& operator|=(
    syntax_option_type& left, syntax_option_type right) noexcept {
    return left = left | right;
}

constexpr syntax_option_type& operator&=(
    syntax_option_type& left, syntax_option_type right) noexcept {
    return left = left & right;
}

constexpr syntax_option_type& operator^=(
    syntax_option_type& left, syntax_option_type right) noexcept {
    return left = left ^ right;
}

