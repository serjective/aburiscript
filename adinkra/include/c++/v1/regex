template<class Character>
class regex_traits {
public:
    using char_type = Character;
    using string_type = basic_string<char_type>;
    using locale_type = locale;
    using char_class_type = uint64_t;

    regex_traits() = default;

    static size_t length(const char_type* value) {
        return char_traits<char_type>::length(value);
    }

    char_type translate(char_type value) const {
        return value;
    }

    char_type translate_nocase(char_type value) const {
        return std::tolower(value, locale_);
    }

    template<class ForwardIterator>
    string_type transform(
        ForwardIterator first, ForwardIterator last) const {
        const string_type value(first, last);
        return use_facet<collate<char_type>>(locale_).transform(
            value.data(), value.data() + value.size());
    }

    template<class ForwardIterator>
    string_type transform_primary(
        ForwardIterator first, ForwardIterator last) const {
        const string_type value(first, last);
        string_type result =
            use_facet<collate<char_type>>(locale_).transform(
                value.data(), value.data() + value.size());
        if constexpr (sizeof(char_type) == 1) {
            if (result.size() == 12) {
                result[11] = result[3];
            } else if (result.size() != 1) {
                result.clear();
            }
        } else {
            if (result.size() == 3) {
                result[2] = result[0];
            } else if (result.size() != 1) {
                result.clear();
            }
        }
        return result;
    }

    template<class ForwardIterator>
    string_type lookup_collatename(
        ForwardIterator first, ForwardIterator last) const {
        if (first == last) {
            return string_type();
        }
        ForwardIterator next = first;
        ++next;
        if (next == last) {
            return string_type(1, *first);
        }
        struct entry {
            const char* name;
            char_type value;
        };
        const entry entries[] = {
            {"NUL", static_cast<char_type>('\0')},
            {"alert", static_cast<char_type>('\a')},
            {"backspace", static_cast<char_type>('\b')},
            {"tab", static_cast<char_type>('\t')},
            {"carriage-return", static_cast<char_type>('\r')},
            {"newline", static_cast<char_type>('\n')},
            {"vertical-tab", static_cast<char_type>('\v')},
            {"form-feed", static_cast<char_type>('\f')},
            {"space", static_cast<char_type>(' ')},
            {"exclamation-mark", static_cast<char_type>('!')},
            {"quotation-mark", static_cast<char_type>('"')},
            {"number-sign", static_cast<char_type>('#')},
            {"dollar-sign", static_cast<char_type>('$')},
            {"percent-sign", static_cast<char_type>('%')},
            {"ampersand", static_cast<char_type>('&')},
            {"apostrophe", static_cast<char_type>('\'')},
            {"left-parenthesis", static_cast<char_type>('(')},
            {"right-parenthesis", static_cast<char_type>(')')},
            {"asterisk", static_cast<char_type>('*')},
            {"plus-sign", static_cast<char_type>('+')},
            {"comma", static_cast<char_type>(',')},
            {"hyphen-minus", static_cast<char_type>('-')},
            {"hyphen", static_cast<char_type>('-')},
            {"full-stop", static_cast<char_type>('.')},
            {"period", static_cast<char_type>('.')},
            {"slash", static_cast<char_type>('/')},
            {"solidus", static_cast<char_type>('/')},
            {"zero", static_cast<char_type>('0')},
            {"one", static_cast<char_type>('1')},
            {"two", static_cast<char_type>('2')},
            {"three", static_cast<char_type>('3')},
            {"four", static_cast<char_type>('4')},
            {"five", static_cast<char_type>('5')},
            {"six", static_cast<char_type>('6')},
            {"seven", static_cast<char_type>('7')},
            {"eight", static_cast<char_type>('8')},
            {"nine", static_cast<char_type>('9')},
            {"colon", static_cast<char_type>(':')},
            {"semicolon", static_cast<char_type>(';')},
            {"less-than-sign", static_cast<char_type>('<')},
            {"equals-sign", static_cast<char_type>('=')},
            {"greater-than-sign", static_cast<char_type>('>')},
            {"question-mark", static_cast<char_type>('?')},
            {"commercial-at", static_cast<char_type>('@')},
            {"left-square-bracket", static_cast<char_type>('[')},
            {"backslash", static_cast<char_type>('\\')},
            {"reverse-solidus", static_cast<char_type>('\\')},
            {"right-square-bracket", static_cast<char_type>(']')},
            {"circumflex-accent", static_cast<char_type>('^')},
            {"circumflex", static_cast<char_type>('^')},
            {"low-line", static_cast<char_type>('_')},
            {"underscore", static_cast<char_type>('_')},
            {"grave-accent", static_cast<char_type>('`')},
            {"left-brace", static_cast<char_type>('{')},
            {"left-curly-bracket", static_cast<char_type>('{')},
            {"vertical-line", static_cast<char_type>('|')},
            {"right-brace", static_cast<char_type>('}')},
            {"right-curly-bracket", static_cast<char_type>('}')},
            {"tilde", static_cast<char_type>('~')}
        };
        for (const entry& current : entries) {
            basic_string<char_type> name;
            const char* source = current.name;
            while (*source != '\0') {
                name.push_back(static_cast<char_type>(*source++));
            }
            if (string_type(first, last) == name) {
                return string_type(1, current.value);
            }
        }
        return string_type();
    }

    template<class ForwardIterator>
    char_class_type lookup_classname(
        ForwardIterator first,
        ForwardIterator last,
        bool icase_value = false) const {
        using namespace __regex_detail;
        char_class_type result = 0;
        if (name_equal(first, last, "alnum")) {
            result = class_alnum;
        } else if (name_equal(first, last, "alpha")) {
            result = class_alpha;
        } else if (name_equal(first, last, "blank")) {
            result = class_blank;
        } else if (name_equal(first, last, "cntrl")) {
            result = class_cntrl;
        } else if (name_equal(first, last, "digit") ||
                   name_equal(first, last, "d")) {
            result = class_digit;
        } else if (name_equal(first, last, "graph")) {
            result = class_graph;
        } else if (name_equal(first, last, "lower")) {
            result = class_lower;
        } else if (name_equal(first, last, "print")) {
            result = class_print;
        } else if (name_equal(first, last, "punct")) {
            result = class_punct;
        } else if (name_equal(first, last, "space") ||
                   name_equal(first, last, "s")) {
            result = class_space;
        } else if (name_equal(first, last, "upper")) {
            result = class_upper;
        } else if (name_equal(first, last, "xdigit")) {
            result = class_xdigit;
        } else if (name_equal(first, last, "word") ||
                   name_equal(first, last, "w")) {
            result = class_word | class_alnum |
                     class_upper | class_lower;
        }
        if (icase_value &&
            (result & (class_lower | class_upper)) != 0) {
            result |= class_alpha;
        }
        return result;
    }

    bool isctype(
        char_type value, char_class_type classification) const {
        using namespace __regex_detail;
        const char_class_type standard =
            classification &
            (class_space | class_print | class_cntrl |
             class_upper | class_lower | class_alpha |
             class_digit | class_punct | class_xdigit |
             class_blank);
        if (standard != 0 &&
            use_facet<ctype<char_type>>(locale_).is(
                standard, value)) {
            return true;
        }
        return (classification & class_word) != 0 &&
               (std::isalnum(value, locale_) ||
                value == static_cast<char_type>('_'));
    }

    int value(char_type character, int radix) const {
        int result = -1;
        if (character >= static_cast<char_type>('0') &&
            character <= static_cast<char_type>('9')) {
            result = character - static_cast<char_type>('0');
        } else if (character >= static_cast<char_type>('a') &&
                   character <= static_cast<char_type>('z')) {
            result = character - static_cast<char_type>('a') + 10;
        } else if (character >= static_cast<char_type>('A') &&
                   character <= static_cast<char_type>('Z')) {
            result = character - static_cast<char_type>('A') + 10;
        }
        return result >= 0 && result < radix ? result : -1;
    }

    locale_type imbue(locale_type value) {
        locale_type previous = locale_;
        locale_ = value;
        return previous;
    }

    locale_type getloc() const {
        return locale_;
    }

private:
    locale_type locale_;
};

template<class Character, class Traits = regex_traits<Character>>
class basic_regex {
public:
    using value_type = Character;
    using traits_type = Traits;
    using string_type = basic_string<value_type>;
    using flag_type = regex_constants::syntax_option_type;
    using locale_type = typename traits_type::locale_type;

    static constexpr flag_type icase = regex_constants::icase;
    static constexpr flag_type nosubs = regex_constants::nosubs;
    static constexpr flag_type optimize = regex_constants::optimize;
    static constexpr flag_type collate = regex_constants::collate;
    static constexpr flag_type ECMAScript = regex_constants::ECMAScript;
    static constexpr flag_type basic = regex_constants::basic;
    static constexpr flag_type extended = regex_constants::extended;
    static constexpr flag_type awk = regex_constants::awk;
    static constexpr flag_type grep = regex_constants::grep;
    static constexpr flag_type egrep = regex_constants::egrep;
    static constexpr flag_type multiline = regex_constants::multiline;

    basic_regex() noexcept = default;

    explicit basic_regex(
        const value_type* expression,
        flag_type flags = ECMAScript) {
        assign(expression, flags);
    }

    basic_regex(
        const value_type* expression,
        size_t count,
        flag_type flags = ECMAScript) {
        assign(expression, count, flags);
    }

    basic_regex(
        initializer_list<value_type> expression,
        flag_type flags = ECMAScript) {
        assign(expression, flags);
    }

    template<class StringTraits, class Allocator>
    explicit basic_regex(
        const basic_string<
            value_type, StringTraits, Allocator>& expression,
        flag_type flags = ECMAScript) {
        assign(expression.data(), expression.size(), flags);
    }

    template<class ForwardIterator>
    basic_regex(
        ForwardIterator first,
        ForwardIterator last,
        flag_type flags = ECMAScript) {
        assign(first, last, flags);
    }

    basic_regex(const basic_regex& other)
        : compiled_(other.compiled_),
          traits_(other.traits_),
          flags_(other.flags_) {
        __regex_runtime::retain(compiled_);
    }

    basic_regex(basic_regex&& other) noexcept
        : compiled_(std::exchange(other.compiled_, nullptr)),
          traits_(std::move(other.traits_)),
          flags_(other.flags_) {}

    ~basic_regex() {
        __regex_runtime::release(compiled_);
    }

    basic_regex& operator=(const basic_regex& other) {
        if (this != &other) {
            basic_regex replacement(other);
            swap(replacement);
        }
        return *this;
    }

    basic_regex& operator=(basic_regex&& other) noexcept {
        if (this != &other) {
            __regex_runtime::release(compiled_);
            compiled_ = std::exchange(other.compiled_, nullptr);
            traits_ = std::move(other.traits_);
            flags_ = other.flags_;
        }
        return *this;
    }

    basic_regex& assign(const basic_regex& other) {
        return *this = other;
    }

    basic_regex& assign(basic_regex&& other) noexcept {
        return *this = std::move(other);
    }

    basic_regex& operator=(const value_type* expression) {
        return assign(expression);
    }

    basic_regex& operator=(initializer_list<value_type> expression) {
        return assign(expression);
    }

    template<class StringTraits, class Allocator>
    basic_regex& operator=(
        const basic_string<
            value_type, StringTraits, Allocator>& expression) {
        return assign(expression);
    }

    basic_regex& assign(
        const value_type* expression,
        flag_type flags = ECMAScript) {
        return assign(
            expression, traits_type::length(expression), flags);
    }

    basic_regex& assign(
        const value_type* expression,
        size_t count,
        flag_type flags = ECMAScript) {
        return assign(expression, expression + count, flags);
    }

    template<class StringTraits, class Allocator>
    basic_regex& assign(
        const basic_string<
            value_type, StringTraits, Allocator>& expression,
        flag_type flags = ECMAScript) {
        return assign(
            expression.begin(), expression.end(), flags);
    }

    basic_regex& assign(
        initializer_list<value_type> expression,
        flag_type flags = ECMAScript) {
        return assign(expression.begin(), expression.end(), flags);
    }

    template<class ForwardIterator>
    basic_regex& assign(
        ForwardIterator first,
        ForwardIterator last,
        flag_type flags = ECMAScript) {
        const vector<uint32_t> pattern =
            __regex_detail::make_code_units(first, last);
        __regex_detail::traits_state<value_type, traits_type>
            state{traits_};
        const __regex_runtime::traits adapter =
            __regex_detail::make_traits(state);
        __regex_runtime::error error{};
        __regex_runtime::program* replacement =
            __regex_runtime::compile(
                pattern.data(), pattern.size(),
                static_cast<unsigned>(flags), adapter, error);
        if (replacement == nullptr) {
            throw regex_error(
                static_cast<regex_constants::error_type>(
                    error.code));
        }
        __regex_runtime::release(compiled_);
        compiled_ = replacement;
        flags_ = static_cast<flag_type>(
            __regex_runtime::flags(compiled_));
        return *this;
    }

    unsigned mark_count() const noexcept {
        return static_cast<unsigned>(
            __regex_runtime::mark_count(compiled_));
    }

    flag_type flags() const noexcept {
        return flags_;
    }

    locale_type imbue(locale_type value) {
        locale_type previous = traits_.imbue(value);
        __regex_runtime::release(compiled_);
        compiled_ = nullptr;
        return previous;
    }

    locale_type getloc() const {
        return traits_.getloc();
    }

    void swap(basic_regex& other) noexcept(
        noexcept(std::swap(traits_, other.traits_))) {
        std::swap(compiled_, other.compiled_);
        std::swap(traits_, other.traits_);
        std::swap(flags_, other.flags_);
    }

    const __regex_runtime::program* __program() const noexcept {
        return compiled_;
    }

private:
    __regex_runtime::program* compiled_ = nullptr;
    traits_type traits_;
    flag_type flags_ = ECMAScript;
};

