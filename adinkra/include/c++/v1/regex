template<class BidirectionalIterator,
         class Character = typename iterator_traits<
             BidirectionalIterator>::value_type,
         class Traits = regex_traits<Character>>
class regex_token_iterator {
public:
    using regex_type = basic_regex<Character, Traits>;
    using value_type = sub_match<BidirectionalIterator>;
    using difference_type = ptrdiff_t;
    using pointer = const value_type*;
    using reference = const value_type&;
    using iterator_category = forward_iterator_tag;
    using iterator_concept = input_iterator_tag;

    regex_token_iterator() = default;

    regex_token_iterator(
        BidirectionalIterator first,
        BidirectionalIterator last,
        const regex_type& expression,
        int submatch = 0,
        regex_constants::match_flag_type flags =
            regex_constants::match_default)
        : current_(first, last, expression, flags),
          end_iterator_(),
          end_(last) {
        submatches_.push_back(submatch);
        initialize();
    }

    template<size_t Count>
    regex_token_iterator(
        BidirectionalIterator first,
        BidirectionalIterator last,
        const regex_type& expression,
        const int (&submatches)[Count],
        regex_constants::match_flag_type flags =
            regex_constants::match_default)
        : current_(first, last, expression, flags),
          end_iterator_(),
          submatches_(submatches, submatches + Count),
          end_(last) {
        initialize();
    }

    regex_token_iterator(
        BidirectionalIterator first,
        BidirectionalIterator last,
        const regex_type& expression,
        const vector<int>& submatches,
        regex_constants::match_flag_type flags =
            regex_constants::match_default)
        : current_(first, last, expression, flags),
          end_iterator_(),
          submatches_(submatches),
          end_(last) {
        initialize();
    }

    regex_token_iterator(
        BidirectionalIterator first,
        BidirectionalIterator last,
        const regex_type& expression,
        initializer_list<int> submatches,
        regex_constants::match_flag_type flags =
            regex_constants::match_default)
        : current_(first, last, expression, flags),
          end_iterator_(),
          submatches_(submatches),
          end_(last) {
        initialize();
    }

    reference operator*() const {
        return value_;
    }

    pointer operator->() const {
        return &value_;
    }

    regex_token_iterator& operator++() {
        if (done_) {
            return *this;
        }
        if (suffix_emitted_) {
            done_ = true;
            return *this;
        }
        ++submatch_index_;
        if (submatch_index_ < submatches_.size()) {
            set_value();
            return *this;
        }

        submatch_index_ = 0;
        if (current_ != end_iterator_) {
            last_end_ = (*current_)[0].second;
            ++current_;
        }
        if (current_ != end_iterator_) {
            set_value();
            return *this;
        }

        if (has_unmatched_ && !suffix_emitted_ &&
            last_end_ != end_) {
            value_.first = last_end_;
            value_.second = end_;
            value_.matched = true;
            suffix_emitted_ = true;
            return *this;
        }
        done_ = true;
        return *this;
    }

    regex_token_iterator operator++(int) {
        regex_token_iterator result(*this);
        ++*this;
        return result;
    }

    friend bool operator==(
        const regex_token_iterator& left,
        const regex_token_iterator& right) {
        if (left.done_ || right.done_) {
            return left.done_ == right.done_;
        }
        return left.current_ == right.current_ &&
               left.submatch_index_ == right.submatch_index_ &&
               left.suffix_emitted_ == right.suffix_emitted_;
    }

    friend bool operator==(
        const regex_token_iterator& value,
        default_sentinel_t) noexcept {
        return value.done_;
    }

    friend bool operator==(
        default_sentinel_t,
        const regex_token_iterator& value) noexcept {
        return value.done_;
    }

private:
    regex_iterator<
        BidirectionalIterator, Character, Traits> current_;
    regex_iterator<
        BidirectionalIterator, Character, Traits> end_iterator_;
    vector<int> submatches_;
    size_t submatch_index_ = 0;
    BidirectionalIterator end_{};
    BidirectionalIterator last_end_{};
    value_type value_;
    bool has_unmatched_ = false;
    bool suffix_emitted_ = false;
    bool done_ = true;

    void initialize() {
        if (submatches_.empty()) {
            done_ = true;
            return;
        }
        for (int index : submatches_) {
            has_unmatched_ = has_unmatched_ || index == -1;
        }
        if (current_ == end_iterator_) {
            done_ = true;
            return;
        }
        last_end_ = (*current_).prefix().first;
        done_ = false;
        set_value();
    }

    void set_value() {
        const int index = submatches_[submatch_index_];
        value_ = index == -1
            ? (*current_).prefix()
            : (*current_)[static_cast<size_t>(index)];
    }
};

using cregex_token_iterator =
    regex_token_iterator<const char*>;
using wcregex_token_iterator =
    regex_token_iterator<const wchar_t*>;
using sregex_token_iterator =
    regex_token_iterator<string::const_iterator>;
using wsregex_token_iterator =
    regex_token_iterator<wstring::const_iterator>;

template<class OutputIterator, class BidirectionalIterator,
         class Character, class RegexTraits,
         class StringTraits, class StringAllocator>
OutputIterator regex_replace(
    OutputIterator output,
    BidirectionalIterator first,
    BidirectionalIterator last,
    const basic_regex<Character, RegexTraits>& expression,
    const basic_string<
        Character, StringTraits, StringAllocator>& format_value,
    regex_constants::match_flag_type flags =
        regex_constants::match_default) {
    match_results<BidirectionalIterator> matches;
    BidirectionalIterator search_first = first;
    bool found = false;
    while (regex_search(
        search_first, last, matches, expression,
        found
            ? flags | regex_constants::match_prev_avail
            : flags)) {
        found = true;
        if ((flags & regex_constants::format_no_copy) ==
            regex_constants::match_default) {
            for (auto current = matches.prefix().first;
                 current != matches.prefix().second; ++current) {
                *output++ = *current;
            }
        }
        output = matches.format(output, format_value, flags);
        search_first = matches[0].second;
        if ((flags & regex_constants::format_first_only) !=
            regex_constants::match_default) {
            break;
        }
        if (matches[0].first == matches[0].second) {
            if (search_first == last) {
                break;
            }
            if ((flags & regex_constants::format_no_copy) ==
                regex_constants::match_default) {
                *output++ = *search_first;
            }
            ++search_first;
        }
    }
    if ((flags & regex_constants::format_no_copy) ==
        regex_constants::match_default) {
        while (search_first != last) {
            *output++ = *search_first++;
        }
    }
    return output;
}

