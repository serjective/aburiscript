template<class BidirectionalIterator>
class sub_match : public pair<
    BidirectionalIterator, BidirectionalIterator> {
public:
    using value_type =
        typename iterator_traits<BidirectionalIterator>::value_type;
    using difference_type =
        typename iterator_traits<BidirectionalIterator>::difference_type;
    using iterator = BidirectionalIterator;
    using string_type = basic_string<value_type>;

    bool matched = false;

    difference_type length() const {
        return matched
            ? std::distance(this->first, this->second)
            : 0;
    }

    string_type str() const {
        return matched
            ? string_type(this->first, this->second)
            : string_type();
    }

    operator string_type() const {
        return str();
    }

    int compare(const sub_match& other) const {
        return compare_ranges(
            this->first, matched ? this->second : this->first,
            other.first,
            other.matched ? other.second : other.first);
    }

    int compare(const string_type& other) const {
        return compare_ranges(
            this->first, matched ? this->second : this->first,
            other.begin(), other.end());
    }

    int compare(const value_type* other) const {
        return compare_ranges(
            this->first, matched ? this->second : this->first,
            other, other + char_traits<value_type>::length(other));
    }

    void swap(sub_match& other) noexcept(
        noexcept(std::swap(
            declval<BidirectionalIterator&>(),
            declval<BidirectionalIterator&>()))) {
        std::swap(this->first, other.first);
        std::swap(this->second, other.second);
        std::swap(matched, other.matched);
    }

private:
    template<class LeftIterator, class RightIterator>
    static int compare_ranges(
        LeftIterator left,
        LeftIterator left_end,
        RightIterator right,
        RightIterator right_end) {
        while (left != left_end && right != right_end) {
            if (*left < *right) {
                return -1;
            }
            if (*right < *left) {
                return 1;
            }
            ++left;
            ++right;
        }
        return left == left_end
            ? right == right_end ? 0 : -1
            : 1;
    }
};

