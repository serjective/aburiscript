namespace __regex_detail {

inline void throw_match_error(
    __regex_runtime::match_status status) {
    if (status == __regex_runtime::match_status::error_complexity) {
        throw regex_error(regex_constants::error_complexity);
    }
    if (status == __regex_runtime::match_status::error_stack) {
        throw regex_error(regex_constants::error_stack);
    }
}

template<class BidirectionalIterator, class Allocator,
         class Character, class Traits>
bool execute(
    BidirectionalIterator first,
    BidirectionalIterator last,
    match_results<BidirectionalIterator, Allocator>* results,
    const basic_regex<Character, Traits>& expression,
    regex_constants::match_flag_type flags,
    bool require_full_match) {
    const vector<uint32_t> input = make_code_units(first, last);
    vector<__regex_runtime::span> spans(
        expression.mark_count() + 1);
    uint32_t previous = 0;
    bool has_previous = false;
    if ((flags & regex_constants::match_prev_avail) !=
        regex_constants::match_default) {
        BidirectionalIterator before = first;
        --before;
        previous = to_code_unit(*before);
        has_previous = true;
    }
    const __regex_runtime::match_status status =
        __regex_runtime::search(
            expression.__program(),
            input.data(), input.size(),
            previous, has_previous,
            static_cast<unsigned>(flags),
            require_full_match,
            spans.data(), spans.size());
    throw_match_error(status);
    if (status != __regex_runtime::match_status::matched) {
        if (results != nullptr) {
            results->__set_no_match(last);
        }
        return false;
    }
    if (results != nullptr) {
        results->__assign(
            first, last, spans.data(), spans.size());
    }
    return true;
}

} // namespace __regex_detail

template<class BidirectionalIterator, class Allocator,
         class Character, class Traits>
bool regex_match(
    BidirectionalIterator first,
    BidirectionalIterator last,
    match_results<BidirectionalIterator, Allocator>& results,
    const basic_regex<Character, Traits>& expression,
    regex_constants::match_flag_type flags =
        regex_constants::match_default) {
    return __regex_detail::execute(
        first, last, &results, expression, flags, true);
}

