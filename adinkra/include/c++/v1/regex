enum error_type {
    error_collate,
    error_ctype,
    error_escape,
    error_backref,
    error_brack,
    error_paren,
    error_brace,
    error_badbrace,
    error_range,
    error_space,
    error_badrepeat,
    error_complexity,
    error_stack
};

} // namespace regex_constants

inline const char* __regex_error_message(
    regex_constants::error_type code) noexcept {
    switch (code) {
    case regex_constants::error_collate:
        return "invalid collating element";
    case regex_constants::error_ctype:
        return "invalid character class or grammar";
    case regex_constants::error_escape:
        return "invalid escape sequence";
    case regex_constants::error_backref:
        return "invalid backreference";
    case regex_constants::error_brack:
        return "mismatched bracket expression";
    case regex_constants::error_paren:
        return "mismatched parenthesis";
    case regex_constants::error_brace:
        return "mismatched brace quantifier";
    case regex_constants::error_badbrace:
        return "invalid brace quantifier";
    case regex_constants::error_range:
        return "invalid character range";
    case regex_constants::error_space:
        return "insufficient space to compile regular expression";
    case regex_constants::error_badrepeat:
        return "invalid repetition";
    case regex_constants::error_complexity:
        return "regular expression exceeded complexity limit";
    case regex_constants::error_stack:
        return "regular expression exceeded stack limit";
    }
    return "regular expression error";
}

class regex_error : public runtime_error {
public:
    explicit regex_error(regex_constants::error_type code)
        : runtime_error(__regex_error_message(code)), code_(code) {}

    regex_constants::error_type code() const noexcept {
        return code_;
    }

private:
    regex_constants::error_type code_;
};

namespace __regex_detail {

constexpr unsigned match_iterator_progress = 1U << 31;

constexpr uint64_t class_alnum = ctype_base::alnum;
constexpr uint64_t class_alpha = ctype_base::alpha;
constexpr uint64_t class_blank = ctype_base::blank;
constexpr uint64_t class_cntrl = ctype_base::cntrl;
constexpr uint64_t class_digit = ctype_base::digit;
constexpr uint64_t class_graph = ctype_base::graph;
constexpr uint64_t class_lower = ctype_base::lower;
constexpr uint64_t class_print = ctype_base::print;
constexpr uint64_t class_punct = ctype_base::punct;
constexpr uint64_t class_space = ctype_base::space;
constexpr uint64_t class_upper = ctype_base::upper;
constexpr uint64_t class_xdigit = ctype_base::xdigit;
constexpr uint64_t class_word = 1ULL << 12;

template<class Character>
uint32_t to_code_unit(Character value) {
    using unsigned_type = make_unsigned_t<Character>;
    return static_cast<uint32_t>(
        static_cast<unsigned_type>(value));
}

template<class Character>
Character from_code_unit(uint32_t value) {
    return static_cast<Character>(value);
}

template<class Iterator>
bool name_equal(
    Iterator first,
    Iterator last,
    const char* name) {
    using Character =
        typename iterator_traits<Iterator>::value_type;
    while (first != last && *name != '\0') {
        Character value = *first++;
        if (value >= static_cast<Character>('A') &&
            value <= static_cast<Character>('Z')) {
            value = static_cast<Character>(
                value - static_cast<Character>('A') +
                static_cast<Character>('a'));
        }
        if (value != static_cast<Character>(*name++)) {
            return false;
        }
    }
    return first == last && *name == '\0';
}

template<class Iterator>
vector<uint32_t> make_code_units(Iterator first, Iterator last) {
    vector<uint32_t> result;
    const auto length = std::distance(first, last);
    if (length > 0) {
        result.reserve(static_cast<size_t>(length));
    }
    while (first != last) {
        result.push_back(to_code_unit(*first++));
    }
    return result;
}

template<class Character, class Traits>
struct traits_state {
    Traits value;
};

template<class Character, class Traits>
void* clone_traits(const void* context) {
    return new traits_state<Character, Traits>(
        *static_cast<const traits_state<Character, Traits>*>(context));
}

template<class Character, class Traits>
void destroy_traits(void* context) {
    delete static_cast<traits_state<Character, Traits>*>(context);
}

template<class Character, class Traits>
uint32_t translate_traits(
    const void* context, uint32_t character, bool icase_value) {
    const Traits& value =
        static_cast<const traits_state<Character, Traits>*>(
            context)->value;
    const Character converted =
        from_code_unit<Character>(character);
    return to_code_unit(
        icase_value
            ? value.translate_nocase(converted)
            : value.translate(converted));
}

template<class Character, class Traits>
bool class_traits(
    const void* context,
    uint32_t character,
    const uint32_t* name,
    size_t name_size,
    bool icase_value) {
    const Traits& value =
        static_cast<const traits_state<Character, Traits>*>(
            context)->value;
    basic_string<Character> converted;
    converted.reserve(name_size);
    for (size_t index = 0; index < name_size; ++index) {
        converted.push_back(from_code_unit<Character>(name[index]));
    }
    const auto classification = value.lookup_classname(
        converted.begin(), converted.end(), icase_value);
    return value.isctype(
        from_code_unit<Character>(character), classification);
}

template<class Character, class Traits>
bool valid_class_traits(
    const void* context,
    const uint32_t* name,
    size_t name_size,
    bool icase_value) {
    const Traits& value =
        static_cast<const traits_state<Character, Traits>*>(
            context)->value;
    basic_string<Character> converted;
    converted.reserve(name_size);
    for (size_t index = 0; index < name_size; ++index) {
        converted.push_back(from_code_unit<Character>(name[index]));
    }
    return value.lookup_classname(
               converted.begin(), converted.end(), icase_value) !=
           typename Traits::char_class_type();
}

template<class Character, class Traits>
bool equivalent_traits(
    const void* context,
    uint32_t character,
    const uint32_t* equivalent,
    size_t equivalent_size) {
    const Traits& value =
        static_cast<const traits_state<Character, Traits>*>(
            context)->value;
    const Character converted_character =
        from_code_unit<Character>(character);
    basic_string<Character> converted_equivalent;
    converted_equivalent.reserve(equivalent_size);
    for (size_t index = 0; index < equivalent_size; ++index) {
        converted_equivalent.push_back(
            from_code_unit<Character>(equivalent[index]));
    }
    return value.transform_primary(
               &converted_character, &converted_character + 1) ==
           value.transform_primary(
               converted_equivalent.begin(),
               converted_equivalent.end());
}

template<class Character, class Traits>
bool range_traits(
    const void* context,
    uint32_t character,
    uint32_t first,
    uint32_t last,
    bool collate_value,
    bool icase_value) {
    const Traits& value =
        static_cast<const traits_state<Character, Traits>*>(
            context)->value;
    Character current = from_code_unit<Character>(character);
    Character lower = from_code_unit<Character>(first);
    Character upper = from_code_unit<Character>(last);
    if (icase_value) {
        current = value.translate_nocase(current);
        lower = value.translate_nocase(lower);
        upper = value.translate_nocase(upper);
    } else {
        current = value.translate(current);
        lower = value.translate(lower);
        upper = value.translate(upper);
    }
    if (!collate_value) {
        return current >= lower && current <= upper;
    }
    const auto current_key =
        value.transform(&current, &current + 1);
    const auto lower_key =
        value.transform(&lower, &lower + 1);
    const auto upper_key =
        value.transform(&upper, &upper + 1);
    return current_key >= lower_key && current_key <= upper_key;
}

template<class Character, class Traits>
int value_traits(
    const void* context,
    uint32_t character,
    int radix) {
    return static_cast<const traits_state<Character, Traits>*>(
               context)->value.value(
        from_code_unit<Character>(character), radix);
}

template<class Character, class Traits>
size_t lookup_collate_traits(
    const void* context,
    const uint32_t* name,
    size_t name_size,
    uint32_t* output,
    size_t output_size) {
    const Traits& value =
        static_cast<const traits_state<Character, Traits>*>(
            context)->value;
    basic_string<Character> converted;
    converted.reserve(name_size);
    for (size_t index = 0; index < name_size; ++index) {
        converted.push_back(from_code_unit<Character>(name[index]));
    }
    const auto result = value.lookup_collatename(
        converted.begin(), converted.end());
    const size_t count = result.size();
    if (output != nullptr) {
        const size_t copied =
            count < output_size ? count : output_size;
        for (size_t index = 0; index < copied; ++index) {
            output[index] = to_code_unit(result[index]);
        }
    }
    return count;
}

template<class Character, class Traits>
__regex_runtime::traits make_traits(
    traits_state<Character, Traits>& state) {
    return __regex_runtime::traits{
        &state,
        &clone_traits<Character, Traits>,
        &destroy_traits<Character, Traits>,
        &translate_traits<Character, Traits>,
        &class_traits<Character, Traits>,
        &valid_class_traits<Character, Traits>,
        &equivalent_traits<Character, Traits>,
        &range_traits<Character, Traits>,
        &value_traits<Character, Traits>,
        &lookup_collate_traits<Character, Traits>};
}

