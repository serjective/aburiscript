template<
    class BidirectionalIterator,
    class Allocator = allocator<sub_match<BidirectionalIterator>>>
class match_results {
public:
    using value_type = sub_match<BidirectionalIterator>;
    using const_reference = const value_type&;
    using reference = value_type&;
    using const_iterator = typename vector<
        value_type, Allocator>::const_iterator;
    using iterator = const_iterator;
    using difference_type =
        typename iterator_traits<BidirectionalIterator>::difference_type;
    using size_type = size_t;
    using allocator_type = Allocator;
    using char_type =
        typename iterator_traits<BidirectionalIterator>::value_type;
    using string_type = basic_string<char_type>;

    match_results() = default;

    explicit match_results(const allocator_type& allocator)
        : matches_(allocator) {}

    match_results(const match_results&) = default;
    match_results(match_results&&) noexcept = default;

    match_results(
        const match_results& other,
        const allocator_type& allocator)
        : matches_(other.matches_, allocator),
          prefix_(other.prefix_),
          suffix_(other.suffix_),
          unmatched_(other.unmatched_),
          base_(other.base_),
          ready_(other.ready_) {}

    match_results(
        match_results&& other,
        const allocator_type& allocator)
        : matches_(std::move(other.matches_), allocator),
          prefix_(std::move(other.prefix_)),
          suffix_(std::move(other.suffix_)),
          unmatched_(std::move(other.unmatched_)),
          base_(std::move(other.base_)),
          ready_(other.ready_) {}

    match_results& operator=(const match_results&) = default;
    match_results& operator=(match_results&&) noexcept = default;

    allocator_type get_allocator() const noexcept {
        return matches_.get_allocator();
    }

    bool ready() const noexcept {
        return ready_;
    }

    size_type size() const noexcept {
        return matches_.size();
    }

    size_type max_size() const noexcept {
        return matches_.max_size();
    }

    bool empty() const noexcept {
        return matches_.empty();
    }

    difference_type length(size_type index = 0) const {
        return (*this)[index].length();
    }

    difference_type position(size_type index = 0) const {
        const value_type& value = (*this)[index];
        return std::distance(base_, value.first);
    }

    string_type str(size_type index = 0) const {
        return (*this)[index].str();
    }

    const_reference operator[](size_type index) const {
        return index < matches_.size()
            ? matches_[index]
            : unmatched_;
    }

    const_reference prefix() const {
        return prefix_;
    }

    const_reference suffix() const {
        return suffix_;
    }

    const_iterator begin() const noexcept {
        return matches_.begin();
    }

    const_iterator end() const noexcept {
        return matches_.end();
    }

    const_iterator cbegin() const noexcept {
        return matches_.cbegin();
    }

    const_iterator cend() const noexcept {
        return matches_.cend();
    }

    template<class OutputIterator>
    OutputIterator format(
        OutputIterator output,
        const char_type* first,
        const char_type* last,
        regex_constants::match_flag_type flags =
            regex_constants::format_default) const {
        if ((flags & regex_constants::format_sed) !=
            regex_constants::match_default) {
            while (first != last) {
                if (*first == static_cast<char_type>('&')) {
                    output = copy_match(output, (*this)[0]);
                    ++first;
                    continue;
                }
                if (*first == static_cast<char_type>('\\') &&
                    first + 1 != last) {
                    ++first;
                    if (*first >= static_cast<char_type>('0') &&
                        *first <= static_cast<char_type>('9')) {
                        const size_type index =
                            static_cast<size_type>(
                                *first - static_cast<char_type>('0'));
                        output = copy_match(output, (*this)[index]);
                    } else {
                        *output++ = *first;
                    }
                    ++first;
                    continue;
                }
                *output++ = *first++;
            }
            return output;
        }

        while (first != last) {
            if (*first != static_cast<char_type>('$') ||
                first + 1 == last) {
                *output++ = *first++;
                continue;
            }
            ++first;
            if (*first == static_cast<char_type>('$')) {
                *output++ = static_cast<char_type>('$');
                ++first;
            } else if (*first == static_cast<char_type>('&')) {
                output = copy_match(output, (*this)[0]);
                ++first;
            } else if (*first == static_cast<char_type>('`')) {
                output = copy_match(output, prefix_);
                ++first;
            } else if (*first == static_cast<char_type>('\'')) {
                output = copy_match(output, suffix_);
                ++first;
            } else if (*first >= static_cast<char_type>('0') &&
                       *first <= static_cast<char_type>('9')) {
                size_type index = static_cast<size_type>(
                    *first++ - static_cast<char_type>('0'));
                if (first != last &&
                    *first >= static_cast<char_type>('0') &&
                    *first <= static_cast<char_type>('9')) {
                    const size_type two_digits =
                        index * 10 +
                        static_cast<size_type>(
                            *first - static_cast<char_type>('0'));
                    if (two_digits < size()) {
                        index = two_digits;
                        ++first;
                    }
                }
                output = copy_match(output, (*this)[index]);
            } else {
                *output++ = static_cast<char_type>('$');
            }
        }
        return output;
    }

    template<class OutputIterator, class StringTraits,
             class StringAllocator>
    OutputIterator format(
        OutputIterator output,
        const basic_string<
            char_type, StringTraits, StringAllocator>& format_value,
        regex_constants::match_flag_type flags =
            regex_constants::format_default) const {
        return format(
            output, format_value.data(),
            format_value.data() + format_value.size(), flags);
    }

    template<class StringTraits, class StringAllocator>
    basic_string<char_type, StringTraits, StringAllocator> format(
        const basic_string<
            char_type, StringTraits, StringAllocator>& format_value,
        regex_constants::match_flag_type flags =
            regex_constants::format_default) const {
        basic_string<char_type, StringTraits, StringAllocator> result;
        format(
            back_inserter(result), format_value, flags);
        return result;
    }

    string_type format(
        const char_type* format_value,
        regex_constants::match_flag_type flags =
            regex_constants::format_default) const {
        string_type result;
        format(
            back_inserter(result),
            format_value,
            format_value + char_traits<char_type>::length(format_value),
            flags);
        return result;
    }

    void swap(match_results& other) noexcept(
        noexcept(matches_.swap(other.matches_))) {
        matches_.swap(other.matches_);
        std::swap(prefix_, other.prefix_);
        std::swap(suffix_, other.suffix_);
        std::swap(unmatched_, other.unmatched_);
        std::swap(base_, other.base_);
        std::swap(ready_, other.ready_);
    }

    void __set_no_match(BidirectionalIterator last) {
        matches_.clear();
        prefix_ = value_type{};
        suffix_ = value_type{};
        unmatched_ = value_type{};
        prefix_.first = prefix_.second = last;
        suffix_.first = suffix_.second = last;
        unmatched_.first = unmatched_.second = last;
        base_ = last;
        ready_ = true;
    }

    void __assign(
        BidirectionalIterator input_first,
        BidirectionalIterator input_last,
        const __regex_runtime::span* spans,
        size_type count) {
        matches_.clear();
        matches_.resize(count);
        base_ = input_first;
        unmatched_ = value_type{};
        unmatched_.first = unmatched_.second = input_last;
        for (size_type index = 0; index < count; ++index) {
            value_type& current = matches_[index];
            current.first = current.second = input_last;
            current.matched = spans[index].matched;
            if (!current.matched) {
                continue;
            }
            current.first = input_first;
            std::advance(current.first, spans[index].first);
            current.second = current.first;
            std::advance(
                current.second,
                spans[index].second - spans[index].first);
        }

        prefix_ = value_type{};
        suffix_ = value_type{};
        if (!matches_.empty() && matches_[0].matched) {
            prefix_.first = input_first;
            prefix_.second = matches_[0].first;
            prefix_.matched =
                prefix_.first != prefix_.second;
            suffix_.first = matches_[0].second;
            suffix_.second = input_last;
            suffix_.matched =
                suffix_.first != suffix_.second;
        } else {
            prefix_.first = prefix_.second = input_last;
            suffix_.first = suffix_.second = input_last;
        }
        ready_ = true;
    }

    void __set_base(BidirectionalIterator first) {
        base_ = first;
    }

    void __set_prefix(
        BidirectionalIterator first,
        BidirectionalIterator second) {
        prefix_.first = first;
        prefix_.second = second;
        prefix_.matched = first != second;
    }

private:
    template<class OutputIterator>
    static OutputIterator copy_match(
        OutputIterator output, const value_type& value) {
        if (!value.matched) {
            return output;
        }
        for (auto current = value.first;
             current != value.second; ++current) {
            *output++ = *current;
        }
        return output;
    }

    vector<value_type, Allocator> matches_;
    value_type prefix_;
    value_type suffix_;
    value_type unmatched_;
    BidirectionalIterator base_{};
    bool ready_ = false;
};

template<class Iterator, class Allocator>
bool operator==(
    const match_results<Iterator, Allocator>& left,
    const match_results<Iterator, Allocator>& right) {
    if (left.ready() != right.ready() ||
        left.size() != right.size() ||
        left.prefix() != right.prefix() ||
        left.suffix() != right.suffix()) {
        return false;
    }
    for (size_t index = 0; index < left.size(); ++index) {
        if (left[index].matched != right[index].matched ||
            left[index] != right[index]) {
            return false;
        }
    }
    return true;
}

template<class Iterator, class Allocator>
void swap(
    match_results<Iterator, Allocator>& left,
    match_results<Iterator, Allocator>& right) noexcept(
        noexcept(left.swap(right))) {
    left.swap(right);
}

