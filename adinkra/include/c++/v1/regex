template<class BidirectionalIterator,
         class Character = typename iterator_traits<
             BidirectionalIterator>::value_type,
         class Traits = regex_traits<Character>>
class regex_iterator {
public:
    using regex_type = basic_regex<Character, Traits>;
    using value_type = match_results<BidirectionalIterator>;
    using difference_type = ptrdiff_t;
    using pointer = const value_type*;
    using reference = const value_type&;
    using iterator_category = forward_iterator_tag;
    using iterator_concept = input_iterator_tag;

    regex_iterator() = default;

    regex_iterator(
        BidirectionalIterator first,
        BidirectionalIterator last,
        const regex_type& expression,
        regex_constants::match_flag_type flags =
            regex_constants::match_default)
        : begin_(first),
          end_(last),
          expression_(&expression),
          flags_(flags),
          done_(!regex_search(
              first, last, match_, expression, flags)) {
        if (!done_) {
            match_.__set_base(begin_);
        }
    }

    reference operator*() const {
        return match_;
    }

    pointer operator->() const {
        return &match_;
    }

    regex_iterator& operator++() {
        if (done_) {
            return *this;
        }
        const BidirectionalIterator previous_end =
            match_[0].second;
        BidirectionalIterator next = match_[0].second;
        regex_constants::match_flag_type next_flags =
            next == begin_
                ? flags_
                : static_cast<regex_constants::match_flag_type>(
                      static_cast<unsigned>(
                          flags_ |
                          regex_constants::match_prev_avail) |
                      __regex_detail::match_iterator_progress);
        if (match_[0].first == match_[0].second) {
            value_type nonempty;
            if (regex_search(
                    next, end_, nonempty, *expression_,
                    next_flags |
                        regex_constants::match_not_null |
                        regex_constants::match_continuous)) {
                match_ = std::move(nonempty);
                match_.__set_base(begin_);
                match_.__set_prefix(
                    previous_end, match_[0].first);
                return *this;
            }
            if (next == end_) {
                done_ = true;
                return *this;
            }
            ++next;
            next_flags = static_cast<
                regex_constants::match_flag_type>(
                    static_cast<unsigned>(
                        next_flags |
                        regex_constants::match_prev_avail) |
                    __regex_detail::match_iterator_progress);
        }
        if (!regex_search(
                next, end_, match_, *expression_, next_flags)) {
            done_ = true;
        } else {
            match_.__set_base(begin_);
            match_.__set_prefix(
                previous_end, match_[0].first);
        }
        return *this;
    }

    regex_iterator operator++(int) {
        regex_iterator result(*this);
        ++*this;
        return result;
    }

    friend bool operator==(
        const regex_iterator& left,
        const regex_iterator& right) {
        if (left.done_ || right.done_) {
            return left.done_ == right.done_;
        }
        return left.expression_ == right.expression_ &&
               left.begin_ == right.begin_ &&
               left.end_ == right.end_ &&
               left.match_[0].first == right.match_[0].first &&
               left.match_[0].second == right.match_[0].second;
    }

    friend bool operator==(
        const regex_iterator& value, default_sentinel_t) noexcept {
        return value.done_;
    }

    friend bool operator==(
        default_sentinel_t, const regex_iterator& value) noexcept {
        return value.done_;
    }

private:
    BidirectionalIterator begin_{};
    BidirectionalIterator end_{};
    const regex_type* expression_ = nullptr;
    regex_constants::match_flag_type flags_ =
        regex_constants::match_default;
    value_type match_;
    bool done_ = true;
};

