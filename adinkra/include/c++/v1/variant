_ADINKRA_NODISCARD constexpr Type&& get(
    variant<Types...>&& value) {
    static_assert(
        __variant_detail::type_count<Type, Types...> == 1);
    return get<
        __variant_detail::type_index<Type, Types...>()>(
        std::move(value));
}

template<class Type, class... Types>
_ADINKRA_NODISCARD constexpr const Type&& get(
    const variant<Types...>&& value) {
    static_assert(
        __variant_detail::type_count<Type, Types...> == 1);
    return get<
        __variant_detail::type_index<Type, Types...>()>(
        std::move(value));
}

template<size_t Index, class... Types>
_ADINKRA_NODISCARD constexpr
add_pointer_t<variant_alternative_t<Index, variant<Types...>>>
get_if(variant<Types...>* value) noexcept {
    return value != nullptr && value->index() == Index
        ? std::addressof(value->template access<Index>())
        : nullptr;
}

template<size_t Index, class... Types>
_ADINKRA_NODISCARD constexpr
add_pointer_t<const variant_alternative_t<Index, variant<Types...>>>
get_if(const variant<Types...>* value) noexcept {
    return value != nullptr && value->index() == Index
        ? std::addressof(value->template access<Index>())
        : nullptr;
}

template<class Type, class... Types>
_ADINKRA_NODISCARD constexpr Type*
get_if(variant<Types...>* value) noexcept {
    static_assert(
        __variant_detail::type_count<Type, Types...> == 1);
    return get_if<
        __variant_detail::type_index<Type, Types...>()>(value);
}

template<class Type, class... Types>
_ADINKRA_NODISCARD constexpr const Type*
get_if(const variant<Types...>* value) noexcept {
    static_assert(
        __variant_detail::type_count<Type, Types...> == 1);
    return get_if<
        __variant_detail::type_index<Type, Types...>()>(value);
}

template<class Type, class... Types>
_ADINKRA_NODISCARD constexpr bool holds_alternative(
    const variant<Types...>& value) noexcept {
    static_assert(
        __variant_detail::type_count<Type, Types...> == 1);
    return value.index() ==
           __variant_detail::type_index<Type, Types...>();
}

namespace __variant_detail {

template<size_t Index, class... Types>
constexpr bool equal_at_index(
    const variant<Types...>& left,
    const variant<Types...>& right) {
    if (left.index() == Index) {
        return get<Index>(left) == get<Index>(right);
    }
    if constexpr (Index + 1 < sizeof...(Types)) {
        return equal_at_index<Index + 1>(left, right);
    }
    return false;
}

template<size_t Index, class... Types>
constexpr bool less_at_index(
    const variant<Types...>& left,
    const variant<Types...>& right) {
    if (left.index() == Index) {
        return get<Index>(left) < get<Index>(right);
    }
    if constexpr (Index + 1 < sizeof...(Types)) {
        return less_at_index<Index + 1>(left, right);
    }
    return false;
}

template<size_t Index, class Visitor, class Variant>
constexpr decltype(auto) visit_one(
    Visitor&& visitor, Variant&& value) {
    if (value.index() == Index) {
        return std::invoke(
            std::forward<Visitor>(visitor),
            get<Index>(std::forward<Variant>(value)));
    }
    if constexpr (
        Index + 1 <
        variant_size_v<remove_reference_t<Variant>>) {
        return visit_one<Index + 1>(
            std::forward<Visitor>(visitor),
            std::forward<Variant>(value));
    } else {
        __throw_bad_variant_access();
    }
}

} // namespace __variant_detail

template<class... Types>
_ADINKRA_NODISCARD constexpr bool operator==(
    const variant<Types...>& left,
    const variant<Types...>& right) {
    if (left.index() != right.index()) {
        return false;
    }
    if (left.valueless_by_exception()) {
        return true;
    }
    return __variant_detail::equal_at_index<0>(left, right);
}

template<class... Types>
_ADINKRA_NODISCARD constexpr bool operator<(
    const variant<Types...>& left,
    const variant<Types...>& right) {
    if (right.valueless_by_exception()) {
        return false;
    }
    if (left.valueless_by_exception()) {
        return true;
    }
    if (left.index() != right.index()) {
        return left.index() < right.index();
    }
    return __variant_detail::less_at_index<0>(left, right);
}

template<class... Types>
_ADINKRA_NODISCARD constexpr bool operator>(
    const variant<Types...>& left,
    const variant<Types...>& right) {
    return right < left;
}

template<class... Types>
_ADINKRA_NODISCARD constexpr bool operator<=(
    const variant<Types...>& left,
    const variant<Types...>& right) {
    return !(right < left);
}

template<class... Types>
_ADINKRA_NODISCARD constexpr bool operator>=(
    const variant<Types...>& left,
    const variant<Types...>& right) {
    return !(left < right);
}

template<class Visitor, class Variant>
constexpr decltype(auto) visit(Visitor&& visitor, Variant&& value) {
    if (value.valueless_by_exception()) {
        __throw_bad_variant_access();
    }
    return __variant_detail::visit_one<0>(
        std::forward<Visitor>(visitor),
        std::forward<Variant>(value));
}

template<class Visitor, class FirstVariant, class SecondVariant,
         class... Variants>
constexpr decltype(auto) visit(
    Visitor&& visitor, FirstVariant&& first,
    SecondVariant&& second, Variants&&... values) {
    return std::visit(
        [&](auto&& first_value) -> decltype(auto) {
            return std::visit(
                [&](auto&&... remaining_values) -> decltype(auto) {
                    return std::invoke(
                        std::forward<Visitor>(visitor),
                        std::forward<decltype(first_value)>(
                            first_value),
                        std::forward<decltype(remaining_values)>(
                            remaining_values)...);
                },
                std::forward<SecondVariant>(second),
                std::forward<Variants>(values)...);
        },
        std::forward<FirstVariant>(first));
}

template<class... Types>
void swap(variant<Types...>& left, variant<Types...>& right)
    noexcept(noexcept(left.swap(right))) {
    left.swap(right);
}

