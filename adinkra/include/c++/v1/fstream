template<class Character, class Traits>
class basic_fstream : public basic_iostream<Character, Traits> {
public:
    using base_type = basic_iostream<Character, Traits>;
    using input_type = basic_istream<Character, Traits>;
    using output_type = basic_ostream<Character, Traits>;

    basic_fstream() noexcept
        : base_type(static_cast<void*>(nullptr)),
          stream_(nullptr), buffer_() {}

    explicit basic_fstream(
        const char* filename,
        ios_base::openmode mode =
            ios_base::in | ios_base::out)
        : basic_fstream() {
        open(filename, mode);
    }

    explicit basic_fstream(
        const basic_string<Character, Traits>& filename,
        ios_base::openmode mode =
            ios_base::in | ios_base::out)
        : basic_fstream(filename.c_str(), mode) {}

    explicit basic_fstream(
        const filesystem::path& filename,
        ios_base::openmode mode =
            ios_base::in | ios_base::out)
        : basic_fstream(filename.c_str(), mode) {}

    basic_fstream(const basic_fstream&) = delete;
    basic_fstream& operator=(const basic_fstream&) = delete;

    ~basic_fstream() {
        if (stream_ != nullptr) {
            __fstream::close(stream_);
        }
    }

    bool is_open() const noexcept {
        return stream_ != nullptr;
    }

    basic_filebuf<Character, Traits>* rdbuf() noexcept {
        return &buffer_;
    }

    void open(
        const char* filename,
        ios_base::openmode mode =
            ios_base::in | ios_base::out) {
        if (is_open()) {
            this->setstate(ios_base::failbit);
            return;
        }
        stream_ = __fstream::open(filename, mode);
        buffer_.__set_stream(stream_);
        input_type::set_streambuf(&buffer_);
        output_type::set_streambuf(&buffer_);
        if (stream_ == nullptr) {
            this->setstate(ios_base::failbit);
        } else {
            this->clear();
        }
    }

    void open(
        const basic_string<Character, Traits>& filename,
        ios_base::openmode mode =
            ios_base::in | ios_base::out) {
        open(filename.c_str(), mode);
    }

    void open(
        const filesystem::path& filename,
        ios_base::openmode mode =
            ios_base::in | ios_base::out) {
        open(filename.c_str(), mode);
    }

    void close() {
        if (stream_ == nullptr) {
            this->setstate(ios_base::failbit);
            return;
        }
        if (!__fstream::close(stream_)) {
            this->setstate(ios_base::failbit);
        }
        stream_ = nullptr;
        buffer_.__set_stream(nullptr);
        input_type::set_streambuf(nullptr);
        output_type::set_streambuf(nullptr);
    }

private:
    void* stream_;
    basic_filebuf<Character, Traits> buffer_;
};

