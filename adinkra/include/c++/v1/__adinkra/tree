#ifndef ADINKRA___ADINKRA_TREE
#define ADINKRA___ADINKRA_TREE

#include <__adinkra/config>

_ADINKRA_BEGIN_NAMESPACE_STD

namespace __tree {

struct node_base {
    node_base* parent;
    node_base* left;
    node_base* right;
    bool red;
};

_ADINKRA_EXPORT node_base* minimum(node_base* node) noexcept;
_ADINKRA_EXPORT const node_base* minimum(
    const node_base* node) noexcept;
_ADINKRA_EXPORT node_base* maximum(node_base* node) noexcept;
_ADINKRA_EXPORT const node_base* maximum(
    const node_base* node) noexcept;
_ADINKRA_EXPORT node_base* next(node_base* node) noexcept;
_ADINKRA_EXPORT const node_base* next(
    const node_base* node) noexcept;
_ADINKRA_EXPORT node_base* previous(node_base* node) noexcept;
_ADINKRA_EXPORT const node_base* previous(
    const node_base* node) noexcept;
_ADINKRA_EXPORT void insert_rebalance(
    node_base*& root, node_base* node) noexcept;
_ADINKRA_EXPORT void erase_rebalance(
    node_base*& root, node_base* node) noexcept;

} // namespace __tree

_ADINKRA_END_NAMESPACE_STD

#endif
