namespace __atomic_detail {

template<class Type, bool = is_enum_v<Type>,
         bool = is_class_v<Type> || is_union_v<Type>>
struct storage_type {
    using type = Type;
};

template<class Type>
struct storage_type<Type, true, false> {
    using type = underlying_type_t<Type>;
};

template<class Type>
using storage_type_t = typename storage_type<Type>::type;

} // namespace __atomic_detail

_ADINKRA_EXPORT void __adinkra_atomic_wait(
    const volatile void* address,
    const void* expected,
    size_t size) noexcept;
_ADINKRA_EXPORT void __adinkra_atomic_notify() noexcept;
_ADINKRA_EXPORT void __adinkra_atomic_load_bytes(
    const volatile void* address, void* result, size_t size) noexcept;
_ADINKRA_EXPORT void __adinkra_atomic_store_bytes(
    volatile void* address, const void* desired, size_t size) noexcept;
_ADINKRA_EXPORT void __adinkra_atomic_exchange_bytes(
