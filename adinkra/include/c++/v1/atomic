class atomic_flag {
public:
    constexpr atomic_flag() noexcept = default;

    atomic_flag(const atomic_flag&) = delete;
    atomic_flag& operator=(const atomic_flag&) = delete;

    bool test_and_set(
        memory_order order = memory_order_seq_cst) noexcept {
        return __atomic_test_and_set(
            &value_, static_cast<int>(order));
    }

    void clear(
        memory_order order = memory_order_seq_cst) noexcept {
        __atomic_clear(&value_, static_cast<int>(order));
    }

    bool test(
        memory_order order = memory_order_seq_cst) const noexcept {
        return __atomic_load_n(
            &value_, static_cast<int>(order));
    }

    void wait(
        bool old,
        memory_order order = memory_order_seq_cst) const noexcept {
        while (test(order) == old) {
            __adinkra_atomic_wait(
                &value_, &old, sizeof(value_));
        }
    }

    void notify_one() noexcept {
        __adinkra_atomic_notify();
    }

    void notify_all() noexcept {
        __adinkra_atomic_notify();
    }

private:
    mutable bool value_ = false;
};

