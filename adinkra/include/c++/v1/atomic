inline void atomic_thread_fence(memory_order order) noexcept {
    __atomic_thread_fence(static_cast<int>(order));
}

inline void atomic_signal_fence(memory_order order) noexcept {
    __atomic_signal_fence(static_cast<int>(order));
}

template<class Type>
class atomic {
    static_assert(
        is_trivially_copyable_v<Type>,
        "std::atomic requires a trivially copyable type");

    using storage_type =
        __atomic_detail::storage_type_t<Type>;
    static constexpr bool use_builtin =
        sizeof(storage_type) <= sizeof(uint64_t) &&
        (is_integral_v<storage_type> ||
         is_pointer_v<storage_type>);

public:
    using value_type = Type;
    using difference_type =
        conditional_t<is_pointer_v<Type>, ptrdiff_t, Type>;

    static constexpr bool is_always_lock_free =
        use_builtin &&
        __atomic_always_lock_free(sizeof(storage_type), nullptr);

    constexpr atomic() noexcept : value_() {}
    constexpr atomic(Type desired) noexcept
        : value_(encode(desired)) {}

    atomic(const atomic&) = delete;
    atomic& operator=(const atomic&) = delete;

    Type operator=(Type desired) noexcept {
        store(desired);
        return desired;
    }

    bool is_lock_free() const noexcept {
        if constexpr (use_builtin) {
            return __atomic_is_lock_free(
                sizeof(storage_type), &value_);
        } else {
            return false;
        }
    }

    bool is_lock_free() const volatile noexcept {
        if constexpr (use_builtin) {
            return __atomic_is_lock_free(
                sizeof(storage_type), &value_);
        } else {
            return false;
        }
    }

    void store(
        Type desired,
        memory_order order = memory_order_seq_cst) noexcept {
        const storage_type desired_bits = encode(desired);
        if constexpr (use_builtin) {
            __atomic_store_n(
                &value_, desired_bits, to_builtin(order));
        } else {
            (void)order;
            __adinkra_atomic_store_bytes(
                &value_, &desired_bits, sizeof(storage_type));
        }
    }

    void store(
        Type desired,
        memory_order order = memory_order_seq_cst) volatile noexcept {
        const storage_type desired_bits = encode(desired);
        if constexpr (use_builtin) {
            __atomic_store_n(
                &value_, desired_bits, to_builtin(order));
        } else {
            (void)order;
            __adinkra_atomic_store_bytes(
                &value_, &desired_bits, sizeof(storage_type));
        }
    }

    Type load(
        memory_order order = memory_order_seq_cst) const noexcept {
        if constexpr (use_builtin) {
            return decode(
                __atomic_load_n(&value_, to_builtin(order)));
        } else {
            (void)order;
            storage_type result;
            __adinkra_atomic_load_bytes(
                &value_, &result, sizeof(storage_type));
            return decode(result);
        }
    }

    Type load(
        memory_order order =
            memory_order_seq_cst) const volatile noexcept {
        if constexpr (use_builtin) {
            return decode(
                __atomic_load_n(&value_, to_builtin(order)));
        } else {
            (void)order;
            storage_type result;
            __adinkra_atomic_load_bytes(
                &value_, &result, sizeof(storage_type));
            return decode(result);
        }
    }

    operator Type() const noexcept {
        return load();
    }

    operator Type() const volatile noexcept {
        return load();
    }

    void wait(
        Type old,
        memory_order order = memory_order_seq_cst) const noexcept {
        while (load(order) == old) {
            const storage_type expected = encode(old);
            __adinkra_atomic_wait(
                &value_, &expected, sizeof(storage_type));
        }
    }

    void notify_one() noexcept {
        __adinkra_atomic_notify();
    }

    void notify_all() noexcept {
        __adinkra_atomic_notify();
    }

    Type exchange(
        Type desired,
        memory_order order = memory_order_seq_cst) noexcept {
        const storage_type desired_bits = encode(desired);
        if constexpr (use_builtin) {
            return decode(__atomic_exchange_n(
                &value_, desired_bits, to_builtin(order)));
        } else {
            (void)order;
            storage_type previous;
            __adinkra_atomic_exchange_bytes(
                &value_, &desired_bits, &previous,
                sizeof(storage_type));
            return decode(previous);
        }
    }

    Type exchange(
        Type desired,
        memory_order order = memory_order_seq_cst) volatile noexcept {
        const storage_type desired_bits = encode(desired);
        if constexpr (use_builtin) {
            return decode(__atomic_exchange_n(
                &value_, desired_bits, to_builtin(order)));
        } else {
            (void)order;
            storage_type previous;
            __adinkra_atomic_exchange_bytes(
                &value_, &desired_bits, &previous,
                sizeof(storage_type));
            return decode(previous);
        }
    }

    bool compare_exchange_weak(
        Type& expected, Type desired,
        memory_order success,
        memory_order failure) noexcept {
        storage_type expected_bits = encode(expected);
        const storage_type desired_bits = encode(desired);
        bool exchanged;
        if constexpr (use_builtin) {
            exchanged = __atomic_compare_exchange_n(
                &value_, &expected_bits, desired_bits, true,
                to_builtin(success), to_builtin(failure));
        } else {
            (void)success;
            (void)failure;
            exchanged =
                __adinkra_atomic_compare_exchange_bytes(
                    &value_, &expected_bits, &desired_bits,
                    sizeof(storage_type));
        }
        if (!exchanged) {
            expected = decode(expected_bits);
        }
        return exchanged;
    }

    bool compare_exchange_weak(
        Type& expected, Type desired,
        memory_order order = memory_order_seq_cst) noexcept {
        return compare_exchange_weak(
            expected, desired, order, failure_order(order));
    }

    bool compare_exchange_strong(
        Type& expected, Type desired,
        memory_order success,
        memory_order failure) noexcept {
        storage_type expected_bits = encode(expected);
        const storage_type desired_bits = encode(desired);
        bool exchanged;
        if constexpr (use_builtin) {
            exchanged = __atomic_compare_exchange_n(
                &value_, &expected_bits, desired_bits, false,
                to_builtin(success), to_builtin(failure));
        } else {
            (void)success;
            (void)failure;
            exchanged =
                __adinkra_atomic_compare_exchange_bytes(
                    &value_, &expected_bits, &desired_bits,
                    sizeof(storage_type));
        }
        if (!exchanged) {
            expected = decode(expected_bits);
        }
        return exchanged;
    }

    bool compare_exchange_strong(
        Type& expected, Type desired,
        memory_order order = memory_order_seq_cst) noexcept {
        return compare_exchange_strong(
            expected, desired, order, failure_order(order));
    }

    template<class Value = Type>
        requires (is_integral_v<Value> || is_enum_v<Value>)
    Type fetch_add(
        Type argument,
        memory_order order = memory_order_seq_cst) noexcept {
        return decode(__atomic_fetch_add(
            &value_, encode(argument), to_builtin(order)));
    }

    template<class Value = Type>
        requires (is_integral_v<Value> || is_enum_v<Value>)
    Type fetch_add(
        Type argument,
        memory_order order = memory_order_seq_cst) volatile noexcept {
        return decode(__atomic_fetch_add(
            &value_, encode(argument), to_builtin(order)));
    }

    template<class Value = Type>
        requires (is_integral_v<Value> || is_enum_v<Value>)
    Type fetch_sub(
        Type argument,
        memory_order order = memory_order_seq_cst) noexcept {
        return decode(__atomic_fetch_sub(
            &value_, encode(argument), to_builtin(order)));
    }

    template<class Value = Type>
        requires (is_integral_v<Value> || is_enum_v<Value>)
    Type fetch_sub(
        Type argument,
        memory_order order = memory_order_seq_cst) volatile noexcept {
        return decode(__atomic_fetch_sub(
            &value_, encode(argument), to_builtin(order)));
    }

    template<class Value = Type>
        requires is_pointer_v<Value>
    Type fetch_add(
        ptrdiff_t argument,
        memory_order order = memory_order_seq_cst) noexcept {
        const ptrdiff_t bytes =
            argument * static_cast<ptrdiff_t>(
                           sizeof(remove_pointer_t<Value>));
        return __atomic_fetch_add(
            &value_, bytes, to_builtin(order));
    }

    template<class Value = Type>
        requires is_pointer_v<Value>
    Type fetch_add(
        ptrdiff_t argument,
        memory_order order = memory_order_seq_cst) volatile noexcept {
        const ptrdiff_t bytes =
            argument * static_cast<ptrdiff_t>(
                           sizeof(remove_pointer_t<Value>));
        return __atomic_fetch_add(
            &value_, bytes, to_builtin(order));
    }

    template<class Value = Type>
        requires is_pointer_v<Value>
    Type fetch_sub(
        ptrdiff_t argument,
        memory_order order = memory_order_seq_cst) noexcept {
        const ptrdiff_t bytes =
            argument * static_cast<ptrdiff_t>(
                           sizeof(remove_pointer_t<Value>));
        return __atomic_fetch_sub(
            &value_, bytes, to_builtin(order));
    }

    template<class Value = Type>
        requires is_pointer_v<Value>
    Type fetch_sub(
        ptrdiff_t argument,
        memory_order order = memory_order_seq_cst) volatile noexcept {
        const ptrdiff_t bytes =
            argument * static_cast<ptrdiff_t>(
                           sizeof(remove_pointer_t<Value>));
        return __atomic_fetch_sub(
            &value_, bytes, to_builtin(order));
    }

    template<class Value = Type>
        requires (is_integral_v<Value> || is_enum_v<Value>)
    Type fetch_and(
        Type argument,
        memory_order order = memory_order_seq_cst) noexcept {
        return decode(__atomic_fetch_and(
            &value_, encode(argument), to_builtin(order)));
    }

    template<class Value = Type>
        requires (is_integral_v<Value> || is_enum_v<Value>)
    Type fetch_and(
        Type argument,
        memory_order order = memory_order_seq_cst) volatile noexcept {
        return decode(__atomic_fetch_and(
            &value_, encode(argument), to_builtin(order)));
    }

    template<class Value = Type>
        requires (is_integral_v<Value> || is_enum_v<Value>)
    Type fetch_or(
        Type argument,
        memory_order order = memory_order_seq_cst) noexcept {
        return decode(__atomic_fetch_or(
            &value_, encode(argument), to_builtin(order)));
    }

    template<class Value = Type>
        requires (is_integral_v<Value> || is_enum_v<Value>)
    Type fetch_or(
        Type argument,
        memory_order order = memory_order_seq_cst) volatile noexcept {
        return decode(__atomic_fetch_or(
            &value_, encode(argument), to_builtin(order)));
    }

    template<class Value = Type>
        requires (is_integral_v<Value> || is_enum_v<Value>)
    Type fetch_xor(
        Type argument,
        memory_order order = memory_order_seq_cst) noexcept {
        return decode(__atomic_fetch_xor(
            &value_, encode(argument), to_builtin(order)));
    }

    template<class Value = Type>
        requires (is_integral_v<Value> || is_enum_v<Value>)
    Type fetch_xor(
        Type argument,
        memory_order order = memory_order_seq_cst) volatile noexcept {
        return decode(__atomic_fetch_xor(
            &value_, encode(argument), to_builtin(order)));
    }

    Type operator++() noexcept {
        return fetch_add(1) + 1;
    }

    Type operator++(int) noexcept {
        return fetch_add(1);
    }

    Type operator--() noexcept {
        return fetch_sub(1) - 1;
    }

    Type operator--(int) noexcept {
        return fetch_sub(1);
    }

    template<class Value = Type>
        requires (is_integral_v<Value> || is_enum_v<Value>)
    Type operator+=(Type argument) noexcept {
        return fetch_add(argument) + argument;
    }

    template<class Value = Type>
        requires (is_integral_v<Value> || is_enum_v<Value>)
    Type operator-=(Type argument) noexcept {
        return fetch_sub(argument) - argument;
    }

    template<class Value = Type>
        requires (is_integral_v<Value> || is_enum_v<Value>)
    Type operator&=(Type argument) noexcept {
        return fetch_and(argument) & argument;
    }

    template<class Value = Type>
        requires (is_integral_v<Value> || is_enum_v<Value>)
    Type operator|=(Type argument) noexcept {
        return fetch_or(argument) | argument;
    }

    template<class Value = Type>
        requires (is_integral_v<Value> || is_enum_v<Value>)
    Type operator^=(Type argument) noexcept {
        return fetch_xor(argument) ^ argument;
    }

    template<class Value = Type>
        requires is_pointer_v<Value>
    Type operator+=(ptrdiff_t argument) noexcept {
        return fetch_add(argument) + argument;
    }

    template<class Value = Type>
        requires is_pointer_v<Value>
    Type operator-=(ptrdiff_t argument) noexcept {
        return fetch_sub(argument) - argument;
    }

private:
    alignas(Type) mutable storage_type value_;

    static constexpr storage_type encode(Type value) noexcept {
        if constexpr (is_enum_v<Type>) {
            return static_cast<storage_type>(value);
        } else if constexpr (is_same_v<Type, storage_type>) {
            return value;
        } else {
            return __builtin_bit_cast(storage_type, value);
        }
    }

    static constexpr Type decode(storage_type value) noexcept {
        if constexpr (is_enum_v<Type>) {
            return static_cast<Type>(value);
        } else if constexpr (is_same_v<Type, storage_type>) {
            return value;
        } else {
            return __builtin_bit_cast(Type, value);
        }
    }

    static constexpr int to_builtin(memory_order order) noexcept {
        return static_cast<int>(order);
    }

    static constexpr memory_order
    failure_order(memory_order order) noexcept {
        return order == memory_order_release
                   ? memory_order_relaxed
             : order == memory_order_acq_rel
                   ? memory_order_acquire
                   : order;
    }
};

