namespace __locale_runtime {

_ADINKRA_EXPORT void* create(const char* name);
_ADINKRA_EXPORT void destroy(void* handle) noexcept;
_ADINKRA_EXPORT uint64_t classify(
    const void* handle, uint32_t value) noexcept;
_ADINKRA_EXPORT uint32_t lower(
    const void* handle, uint32_t value) noexcept;
_ADINKRA_EXPORT uint32_t upper(
    const void* handle, uint32_t value) noexcept;
_ADINKRA_EXPORT int compare(
    const void* handle,
    const uint32_t* left, size_t left_size,
    const uint32_t* right, size_t right_size);
_ADINKRA_EXPORT size_t transform(
    const void* handle,
    const void* input, size_t input_size,
    void* output, size_t output_size,
    bool narrow);

} // namespace __locale_runtime

class locale {
public:
    class _ADINKRA_EXPORT facet {
    protected:
        explicit facet(size_t references = 0) noexcept
            : references_(0),
              delete_when_unused_(references == 0) {}
        virtual ~facet();

    private:
        friend class locale;

        void retain() const noexcept;
        void release() const noexcept;

        mutable size_t references_;
        bool delete_when_unused_;
    };

    class _ADINKRA_EXPORT id {
    public:
        constexpr id() noexcept : value_(0) {}

        size_t __index() const noexcept;

        id(const id&) = delete;
        id& operator=(const id&) = delete;

    private:
        mutable size_t value_;
    };

    using category = int;
    static constexpr category none = 0;
    static constexpr category collate = 1 << 0;
    static constexpr category ctype = 1 << 1;
    static constexpr category monetary = 1 << 2;
    static constexpr category numeric = 1 << 3;
    static constexpr category time = 1 << 4;
    static constexpr category messages = 1 << 5;
    static constexpr category all =
        collate | ctype | monetary | numeric | time | messages;

    locale() noexcept;
    locale(const locale& other) noexcept;
    locale& operator=(const locale& other) noexcept;
    ~locale();

    explicit locale(const char*);
    explicit locale(const string& name);

    locale(const locale&, const char*, category);

    locale(
        const locale& other,
        const string& name,
        category selected);

    template<class Facet>
    locale(const locale& other, Facet* value)
        : storage_(
              copy_with_facet(
                  other.storage_, Facet::id.__index(), value)) {
        static_assert(is_base_of_v<facet, Facet>);
    }

    string name() const;

    static const locale& classic() noexcept;
    static locale global(const locale& value);

    friend bool operator==(
        const locale& left, const locale& right) noexcept {
        return left.storage_ == right.storage_;
    }

    template<class Character, class Traits, class Allocator>
    bool operator()(
        const basic_string<Character, Traits, Allocator>& left,
        const basic_string<Character, Traits, Allocator>& right) const;

private:
    template<class Facet>
    friend bool has_facet(const locale&) noexcept;

    template<class Facet>
    friend const Facet& use_facet(const locale&);

    struct storage;
    struct retain_storage_t {};
    storage* storage_;

    explicit locale(storage* value, retain_storage_t) noexcept;

    static storage* allocate_storage(
        size_t size, const char* name = "C");
    static storage* classic_storage() noexcept;
    static storage*& global_storage() noexcept;
    static void retain_storage(storage* value) noexcept;
    static void release_storage(storage* value) noexcept;
    static storage* copy_with_facet(
        storage* source, size_t index, facet* value);
    static const facet* find_facet(
        const storage* source, size_t index) noexcept;
};

class ctype_base {
public:
    using mask = uint64_t;

    static constexpr mask space = 1ULL << 0;
    static constexpr mask print = 1ULL << 1;
    static constexpr mask cntrl = 1ULL << 2;
    static constexpr mask upper = 1ULL << 3;
    static constexpr mask lower = 1ULL << 4;
    static constexpr mask alpha = 1ULL << 5;
    static constexpr mask digit = 1ULL << 6;
    static constexpr mask punct = 1ULL << 7;
    static constexpr mask xdigit = 1ULL << 8;
    static constexpr mask blank = 1ULL << 9;
    static constexpr mask alnum = alpha | digit;
    static constexpr mask graph = alnum | punct;
};

template<class Character>
class ctype : public locale::facet, public ctype_base {
public:
    using char_type = Character;

    inline static locale::id id;
    static constexpr size_t table_size = 256;

    explicit ctype(size_t references = 0)
        : ctype("C", references) {}

    ctype(
        const mask* table,
        bool delete_table = false,
        size_t references = 0)
        : locale::facet(references),
          handle_(__locale_runtime::create("C")),
          table_(table),
          delete_table_(delete_table) {}

    bool is(mask classification, char_type value) const {
        return do_is(classification, value);
    }

    const char_type* is(
        const char_type* first,
        const char_type* last,
        mask* output) const {
        return do_is(first, last, output);
    }

    const char_type* scan_is(
        mask classification,
        const char_type* first,
        const char_type* last) const {
        return do_scan_is(classification, first, last);
    }

    const char_type* scan_not(
        mask classification,
        const char_type* first,
        const char_type* last) const {
        return do_scan_not(classification, first, last);
    }

    char_type toupper(char_type value) const {
        return do_toupper(value);
    }

    const char_type* toupper(
        char_type* first, const char_type* last) const {
        return do_toupper(first, last);
    }

    char_type tolower(char_type value) const {
        return do_tolower(value);
    }

    const char_type* tolower(
        char_type* first, const char_type* last) const {
        return do_tolower(first, last);
    }

    char_type widen(char value) const {
        return do_widen(value);
    }

    const char* widen(
        const char* first,
        const char* last,
        char_type* output) const {
        return do_widen(first, last, output);
    }

    char narrow(char_type value, char fallback) const {
        return do_narrow(value, fallback);
    }

    const char_type* narrow(
        const char_type* first,
        const char_type* last,
        char fallback,
        char* output) const {
        return do_narrow(first, last, fallback, output);
    }

    const mask* table() const noexcept {
        return table_;
    }

    static const mask* classic_table() noexcept {
        static const mask values[table_size] = {};
        return values;
    }

protected:
    explicit ctype(const char* name, size_t references)
        : locale::facet(references),
          handle_(__locale_runtime::create(name)),
          table_(nullptr),
          delete_table_(false) {}

    ~ctype() override {
        __locale_runtime::destroy(handle_);
        if (delete_table_) {
            delete[] table_;
        }
    }

    virtual bool do_is(
        mask classification, char_type value) const {
        const uint32_t code = static_cast<uint32_t>(
            static_cast<make_unsigned_t<char_type>>(value));
        if (table_ != nullptr && code < table_size) {
            return (table_[code] & classification) != 0;
        }
        return (__locale_runtime::classify(handle_, code) &
                classification) != 0;
    }

    virtual const char_type* do_is(
        const char_type* first,
        const char_type* last,
        mask* output) const {
        while (first != last) {
            const uint32_t code = static_cast<uint32_t>(
                static_cast<make_unsigned_t<char_type>>(*first++));
            *output++ = table_ != nullptr && code < table_size
                ? table_[code]
                : __locale_runtime::classify(handle_, code);
        }
        return last;
    }

    virtual const char_type* do_scan_is(
        mask classification,
        const char_type* first,
        const char_type* last) const {
        while (first != last &&
               !do_is(classification, *first)) {
            ++first;
        }
        return first;
    }

    virtual const char_type* do_scan_not(
        mask classification,
        const char_type* first,
        const char_type* last) const {
        while (first != last &&
               do_is(classification, *first)) {
            ++first;
        }
        return first;
    }

    virtual char_type do_toupper(char_type value) const {
        return static_cast<char_type>(
            __locale_runtime::upper(
                handle_, static_cast<uint32_t>(
                    static_cast<make_unsigned_t<char_type>>(value))));
    }

    virtual const char_type* do_toupper(
        char_type* first, const char_type* last) const {
        char_type* current = first;
        while (current != last) {
            *current = do_toupper(*current);
            ++current;
        }
        return last;
    }

    virtual char_type do_tolower(char_type value) const {
        return static_cast<char_type>(
            __locale_runtime::lower(
                handle_, static_cast<uint32_t>(
                    static_cast<make_unsigned_t<char_type>>(value))));
    }

    virtual const char_type* do_tolower(
        char_type* first, const char_type* last) const {
        char_type* current = first;
        while (current != last) {
            *current = do_tolower(*current);
            ++current;
        }
        return last;
    }

    virtual char_type do_widen(char value) const {
        return static_cast<char_type>(
            static_cast<unsigned char>(value));
    }

    virtual const char* do_widen(
        const char* first,
        const char* last,
        char_type* output) const {
        while (first != last) {
            *output++ = do_widen(*first++);
        }
        return last;
    }

    virtual char do_narrow(
        char_type value, char fallback) const {
        const uint32_t code = static_cast<uint32_t>(
            static_cast<make_unsigned_t<char_type>>(value));
        return code <= 0x7f
            ? static_cast<char>(code)
            : fallback;
    }

    virtual const char_type* do_narrow(
        const char_type* first,
        const char_type* last,
        char fallback,
        char* output) const {
        while (first != last) {
            *output++ = do_narrow(*first++, fallback);
        }
        return last;
    }

private:
    void* handle_;
    const mask* table_;
    bool delete_table_;
};

