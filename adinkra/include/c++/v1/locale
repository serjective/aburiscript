template<class Character>
class collate : public locale::facet {
public:
    using char_type = Character;
    using string_type =
        basic_string<Character, char_traits<Character>,
                     allocator<Character>>;

    inline static locale::id id;

    explicit collate(size_t references = 0)
        : collate("C", references) {}

    int compare(
        const char_type* first1,
        const char_type* last1,
        const char_type* first2,
        const char_type* last2) const {
        return do_compare(first1, last1, first2, last2);
    }

    string_type transform(
        const char_type* first,
        const char_type* last) const {
        return do_transform(first, last);
    }

    long hash(
        const char_type* first,
        const char_type* last) const {
        return do_hash(first, last);
    }

protected:
    explicit collate(const char* name, size_t references)
        : locale::facet(references),
          handle_(__locale_runtime::create(name)) {}

    ~collate() override {
        __locale_runtime::destroy(handle_);
    }

    virtual int do_compare(
        const char_type* first1,
        const char_type* last1,
        const char_type* first2,
        const char_type* last2) const {
        while (first1 != last1 && first2 != last2) {
            const uint32_t left = static_cast<uint32_t>(
                static_cast<make_unsigned_t<char_type>>(*first1++));
            const uint32_t right = static_cast<uint32_t>(
                static_cast<make_unsigned_t<char_type>>(*first2++));
            const int ordering = __locale_runtime::compare(
                handle_, &left, 1, &right, 1);
            if (ordering != 0) {
                return ordering;
            }
        }
        return first1 == last1
            ? first2 == last2 ? 0 : -1
            : 1;
    }

    virtual string_type do_transform(
        const char_type* first,
        const char_type* last) const {
        const size_t input_size =
            static_cast<size_t>(last - first);
        const size_t size = __locale_runtime::transform(
            handle_, first, input_size,
            nullptr, 0, sizeof(char_type) == 1);
        string_type result(size, char_type());
        if (size != 0) {
            __locale_runtime::transform(
                handle_, first, input_size,
                result.data(), result.size(),
                sizeof(char_type) == 1);
        }
        return result;
    }

    virtual long do_hash(
        const char_type* first,
        const char_type* last) const {
        unsigned long result = 1469598103934665603ULL;
        while (first != last) {
            result ^= static_cast<unsigned long>(
                static_cast<make_unsigned_t<char_type>>(*first++));
            result *= 1099511628211ULL;
        }
        return static_cast<long>(result);
    }

private:
    void* handle_;
};

