class codecvt_base {
public:
    enum result {
        ok,
        partial,
        error,
        noconv
    };
};

template<class Intern, class Extern, class State>
class codecvt : public locale::facet, public codecvt_base {
public:
    using intern_type = Intern;
    using extern_type = Extern;
    using state_type = State;

    inline static locale::id id;

    explicit codecvt(size_t references = 0)
        : locale::facet(references) {}

    result out(
        state_type& state,
        const intern_type* from, const intern_type* from_end,
        const intern_type*& from_next,
        extern_type* to, extern_type* to_end,
        extern_type*& to_next) const {
        return do_out(
            state, from, from_end, from_next,
            to, to_end, to_next);
    }

    result unshift(
        state_type& state,
        extern_type* to, extern_type* to_end,
        extern_type*& to_next) const {
        return do_unshift(state, to, to_end, to_next);
    }

    result in(
        state_type& state,
        const extern_type* from, const extern_type* from_end,
        const extern_type*& from_next,
        intern_type* to, intern_type* to_end,
        intern_type*& to_next) const {
        return do_in(
            state, from, from_end, from_next,
            to, to_end, to_next);
    }

    int encoding() const noexcept {
        return do_encoding();
    }

    bool always_noconv() const noexcept {
        return do_always_noconv();
    }

    int length(
        state_type& state,
        const extern_type* from, const extern_type* from_end,
        size_t maximum) const {
        return do_length(state, from, from_end, maximum);
    }

    int max_length() const noexcept {
        return do_max_length();
    }

protected:
    ~codecvt() override = default;

    virtual result do_out(
        state_type&,
        const intern_type* from, const intern_type* from_end,
        const intern_type*& from_next,
        extern_type* to, extern_type* to_end,
        extern_type*& to_next) const {
        if constexpr (is_same_v<intern_type, extern_type>) {
            from_next = from;
            to_next = to;
            return noconv;
        }
        from_next = from;
        to_next = to;
        while (from_next != from_end && to_next != to_end) {
            *to_next++ = static_cast<extern_type>(*from_next++);
        }
        return from_next == from_end ? ok : partial;
    }

    virtual result do_in(
        state_type&,
        const extern_type* from, const extern_type* from_end,
        const extern_type*& from_next,
        intern_type* to, intern_type* to_end,
        intern_type*& to_next) const {
        if constexpr (is_same_v<intern_type, extern_type>) {
            from_next = from;
            to_next = to;
            return noconv;
        }
        from_next = from;
        to_next = to;
        while (from_next != from_end && to_next != to_end) {
            *to_next++ = static_cast<intern_type>(
                static_cast<unsigned char>(*from_next++));
        }
        return from_next == from_end ? ok : partial;
    }

    virtual result do_unshift(
        state_type&, extern_type* to, extern_type*,
        extern_type*& to_next) const {
        to_next = to;
        return noconv;
    }

    virtual int do_encoding() const noexcept {
        return 1;
    }

    virtual bool do_always_noconv() const noexcept {
        return is_same_v<intern_type, extern_type>;
    }

    virtual int do_length(
        state_type&, const extern_type* from,
        const extern_type* from_end, size_t maximum) const {
        const size_t available =
            static_cast<size_t>(from_end - from);
        return static_cast<int>(
            available < maximum ? available : maximum);
    }

    virtual int do_max_length() const noexcept {
        return 1;
    }
};

template<class Character,
         class OutputIterator = ostreambuf_iterator<Character>>
class time_put : public locale::facet {
public:
    using char_type = Character;
    using iter_type = OutputIterator;

    inline static locale::id id;

    explicit time_put(size_t references = 0)
        : locale::facet(references) {}

    iter_type put(
        iter_type output, ios_base& stream,
        char_type fill, const tm* value,
        char format, char modifier = 0) const {
        return do_put(
            output, stream, fill, value, format, modifier);
    }

protected:
    ~time_put() override = default;

    virtual iter_type do_put(
        iter_type output, ios_base&,
        char_type, const tm* value,
        char format, char modifier) const {
        char specification[4] = {'%', '\0', '\0', '\0'};
        size_t position = 1;
        if (modifier != 0) {
            specification[position++] = modifier;
        }
        specification[position++] = format;
        specification[position] = '\0';

        char result[256];
        const size_t count =
            ::strftime(result, sizeof(result), specification, value);
        for (size_t index = 0; index < count; ++index) {
            *output++ = static_cast<char_type>(result[index]);
        }
        return output;
    }
};

template<class Facet>
bool has_facet(const locale& value) noexcept {
    static_assert(is_base_of_v<locale::facet, Facet>);
    return locale::find_facet(
               value.storage_, Facet::id.__index()) != nullptr;
}

template<class Facet>
const Facet& use_facet(const locale& value) {
    static_assert(is_base_of_v<locale::facet, Facet>);
    const locale::facet* result = locale::find_facet(
        value.storage_, Facet::id.__index());
    if (result == nullptr) {
        static const Facet* fallback = new Facet();
        return *fallback;
    }
    return static_cast<const Facet&>(*result);
}

template<class Character>
bool isalpha(Character value, const locale& location) {
    return use_facet<ctype<Character>>(location).is(
        ctype_base::alpha, value);
}

