template<class InputIterator>
constexpr iter_difference_t<InputIterator>
distance(InputIterator first, InputIterator last) {
    if constexpr (is_base_of_v<random_access_iterator_tag,
                               typename iterator_traits<InputIterator>::iterator_category>) {
        return last - first;
    } else {
        iter_difference_t<InputIterator> result = 0;
        while (first != last) {
            ++first;
            ++result;
        }
        return result;
    }
}

template<class InputIterator, class Distance>
constexpr void advance(InputIterator& iterator, Distance distance_value) {
    using Category = typename iterator_traits<InputIterator>::iterator_category;
    if constexpr (is_base_of_v<random_access_iterator_tag, Category>) {
        iterator += distance_value;
    } else if constexpr (is_base_of_v<bidirectional_iterator_tag, Category>) {
        if (distance_value >= 0) {
            while (distance_value-- > 0) {
                ++iterator;
            }
        } else {
            while (distance_value++ < 0) {
                --iterator;
            }
        }
    } else {
        while (distance_value-- > 0) {
            ++iterator;
        }
    }
}

template<class InputIterator>
_ADINKRA_NODISCARD constexpr InputIterator
next(InputIterator iterator, iter_difference_t<InputIterator> count = 1) {
    std::advance(iterator, count);
    return iterator;
}

template<class Type, class Character = char,
         class Traits = char_traits<Character>,
         class Distance = ptrdiff_t>
class istream_iterator {
public:
    using iterator_category = input_iterator_tag;
    using value_type = Type;
    using difference_type = Distance;
    using pointer = const Type*;
    using reference = const Type&;
    using char_type = Character;
    using traits_type = Traits;
    using istream_type = basic_istream<Character, Traits>;

    constexpr istream_iterator() noexcept
        : stream_(nullptr), value_() {}

    istream_iterator(istream_type& stream)
        : stream_(&stream), value_() {
        read();
    }

    reference operator*() const noexcept {
        return value_;
    }

    pointer operator->() const noexcept {
        return &value_;
    }

    istream_iterator& operator++() {
        read();
        return *this;
    }

    istream_iterator operator++(int) {
        istream_iterator previous(*this);
        read();
        return previous;
    }

    friend bool operator==(
        const istream_iterator& left,
        const istream_iterator& right) noexcept {
        return left.stream_ == right.stream_;
    }

private:
    void read() {
        if (stream_ != nullptr && !(*stream_ >> value_)) {
            stream_ = nullptr;
        }
    }

    istream_type* stream_;
    Type value_;
};

template<class Type, class Character = char,
         class Traits = char_traits<Character>>
class ostream_iterator {
public:
    using iterator_category = output_iterator_tag;
    using value_type = void;
    using difference_type = ptrdiff_t;
    using pointer = void;
    using reference = void;
    using char_type = Character;
    using traits_type = Traits;
    using ostream_type = basic_ostream<Character, Traits>;

    ostream_iterator(
        ostream_type& stream, const Character* delimiter = nullptr)
        : stream_(&stream), delimiter_(delimiter) {}

    ostream_iterator& operator=(const Type& value) {
        *stream_ << value;
        if (delimiter_ != nullptr) {
            *stream_ << delimiter_;
        }
        return *this;
    }

    ostream_iterator& operator*() noexcept {
        return *this;
    }

    ostream_iterator& operator++() noexcept {
        return *this;
    }

    ostream_iterator& operator++(int) noexcept {
        return *this;
    }

private:
    ostream_type* stream_;
    const Character* delimiter_;
};

template<class Character, class Traits = char_traits<Character>>
class istreambuf_iterator {
public:
    using iterator_category = input_iterator_tag;
    using value_type = Character;
    using difference_type = ptrdiff_t;
    using pointer = const Character*;
    using reference = Character;
    using char_type = Character;
    using traits_type = Traits;
    using int_type = typename Traits::int_type;
    using streambuf_type = basic_streambuf<Character, Traits>;
    using istream_type = basic_istream<Character, Traits>;

    constexpr istreambuf_iterator() noexcept : buffer_(nullptr) {}

    istreambuf_iterator(istream_type& stream) noexcept
        : buffer_(stream.rdbuf()) {
        normalize();
    }

    istreambuf_iterator(streambuf_type* buffer) noexcept
        : buffer_(buffer) {
        normalize();
    }

    Character operator*() const {
        return Traits::to_char_type(buffer_->sgetc());
    }

    istreambuf_iterator& operator++() {
        if (buffer_ != nullptr) {
            (void)buffer_->sbumpc();
            normalize();
        }
        return *this;
    }

    istreambuf_iterator operator++(int) {
        istreambuf_iterator previous(*this);
        ++*this;
        return previous;
    }

    friend bool operator==(
        const istreambuf_iterator& left,
        const istreambuf_iterator& right) {
        return left.at_end() == right.at_end();
    }

private:
    streambuf_type* buffer_;

    bool at_end() const {
        return buffer_ == nullptr ||
               Traits::eq_int_type(
                   buffer_->sgetc(), Traits::eof());
    }

    void normalize() {
        if (at_end()) {
            buffer_ = nullptr;
        }
    }
};

template<class Character, class Traits>
class ostreambuf_iterator {
public:
    using iterator_category = output_iterator_tag;
    using value_type = void;
    using difference_type = ptrdiff_t;
    using pointer = void;
    using reference = void;
    using char_type = Character;
    using traits_type = Traits;
    using streambuf_type = basic_streambuf<Character, Traits>;
    using ostream_type = basic_ostream<Character, Traits>;

    ostreambuf_iterator(ostream_type& stream) noexcept
        : buffer_(stream.rdbuf()), failed_(false) {}

    ostreambuf_iterator(streambuf_type* buffer) noexcept
        : buffer_(buffer), failed_(false) {}

    ostreambuf_iterator& operator=(Character value) {
        if (buffer_ == nullptr ||
            Traits::eq_int_type(
                buffer_->sputc(value), Traits::eof())) {
            failed_ = true;
        }
        return *this;
    }

    ostreambuf_iterator& operator*() noexcept {
        return *this;
    }

    ostreambuf_iterator& operator++() noexcept {
        return *this;
    }

    ostreambuf_iterator& operator++(int) noexcept {
        return *this;
    }

    bool failed() const noexcept {
        return failed_;
    }

private:
    streambuf_type* buffer_;
    bool failed_;
};

template<class Container>
class back_insert_iterator {
public:
    using iterator_category = output_iterator_tag;
    using value_type = void;
    using difference_type = ptrdiff_t;
    using pointer = void;
    using reference = void;
    using container_type = Container;

    explicit back_insert_iterator(Container& container)
        : container(addressof(container)) {}

    back_insert_iterator& operator=(
        const typename Container::value_type& value) {
        container->push_back(value);
        return *this;
    }

    back_insert_iterator& operator=(
        typename Container::value_type&& value) {
        container->push_back(std::move(value));
        return *this;
    }

    back_insert_iterator& operator*() { return *this; }
    back_insert_iterator& operator++() { return *this; }
    back_insert_iterator& operator++(int) { return *this; }

protected:
    Container* container;
};

template<class Container>
back_insert_iterator<Container>
back_inserter(Container& container) {
    return back_insert_iterator<Container>(container);
}

