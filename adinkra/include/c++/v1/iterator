struct input_iterator_tag {};
struct output_iterator_tag {};
struct forward_iterator_tag : input_iterator_tag {};
struct bidirectional_iterator_tag : forward_iterator_tag {};
struct random_access_iterator_tag : bidirectional_iterator_tag {};
struct contiguous_iterator_tag : random_access_iterator_tag {};

struct default_sentinel_t {};
inline constexpr default_sentinel_t default_sentinel{};

template<class Category, class Type, class Distance = ptrdiff_t,
         class Pointer = Type*, class Reference = Type&>
struct iterator {
    using iterator_category = Category;
    using value_type = Type;
    using difference_type = Distance;
    using pointer = Pointer;
    using reference = Reference;
};

template<class Iterator, class = void>
struct iterator_traits {};

namespace __iterator_detail {

template<class Iterator, class = void>
struct iterator_pointer {
    using type = void;
};

template<class Iterator>
struct iterator_pointer<
    Iterator, void_t<typename Iterator::pointer>> {
    using type = typename Iterator::pointer;
};

template<class Iterator, class = void>
struct iterator_reference {
    using type = decltype(*declval<Iterator&>());
};

template<class Iterator>
struct iterator_reference<
    Iterator, void_t<typename Iterator::reference>> {
    using type = typename Iterator::reference;
};

} // namespace __iterator_detail

template<class Iterator>
struct iterator_traits<
    Iterator,
    void_t<
        typename Iterator::difference_type,
        typename Iterator::value_type,
        typename Iterator::iterator_category>> {
    using difference_type = typename Iterator::difference_type;
    using value_type = typename Iterator::value_type;
    using pointer =
        typename __iterator_detail::iterator_pointer<Iterator>::type;
    using reference =
        typename __iterator_detail::iterator_reference<Iterator>::type;
    using iterator_category = typename Iterator::iterator_category;
};

template<class Type>
struct iterator_traits<Type*, void> {
    using difference_type = ptrdiff_t;
    using value_type = remove_cv_t<Type>;
    using pointer = Type*;
    using reference = Type&;
    using iterator_category = random_access_iterator_tag;
    using iterator_concept = contiguous_iterator_tag;
};

template<class Iterator>
using iter_difference_t = typename iterator_traits<remove_cvref_t<Iterator>>::difference_type;

template<class Iterator>
using iter_value_t = typename iterator_traits<remove_cvref_t<Iterator>>::value_type;

template<class Iterator>
using iter_reference_t = decltype(*declval<Iterator&>());

template<class Iterator>
using iter_rvalue_reference_t = decltype(std::move(*declval<Iterator&>()));

template<class Output, class Type>
concept indirectly_writable =
    requires(Output&& output, Type&& value) {
        *output = std::forward<Type>(value);
        *std::forward<Output>(output) = std::forward<Type>(value);
    };

template<class Iterator>
concept weakly_incrementable =
    requires(Iterator iterator) {
        ++iterator;
        iterator++;
    };

template<class Iterator>
concept input_or_output_iterator =
    requires(Iterator iterator) {
        *iterator;
    } && weakly_incrementable<Iterator>;

template<class Iterator, class = void>
struct __iterator_concept {
    using type =
        typename iterator_traits<Iterator>::iterator_category;
};

template<class Iterator>
struct __iterator_concept<
    Iterator,
    void_t<typename iterator_traits<
        remove_cvref_t<Iterator>>::iterator_concept>> {
    using type =
        typename iterator_traits<
            remove_cvref_t<Iterator>>::iterator_concept;
};

template<class Iterator>
using __iterator_concept_t =
    typename __iterator_concept<remove_cvref_t<Iterator>>::type;

template<class Iterator>
concept indirectly_readable =
    requires(const remove_cvref_t<Iterator>& iterator) {
        typename iter_value_t<Iterator>;
        *iterator;
    };

template<class Iterator>
concept input_iterator =
    input_or_output_iterator<Iterator> &&
    indirectly_readable<Iterator> &&
    derived_from<__iterator_concept_t<Iterator>,
                 input_iterator_tag> &&
    equality_comparable<Iterator>;

template<class Iterator>
concept forward_iterator =
    input_iterator<Iterator> &&
    derived_from<__iterator_concept_t<Iterator>,
                 forward_iterator_tag> &&
    default_initializable<Iterator> &&
    requires(Iterator iterator) {
        { iterator++ } -> same_as<Iterator>;
    };

template<class Sentinel, class Iterator>
concept sentinel_for =
    semiregular<Sentinel> &&
    input_or_output_iterator<Iterator> &&
    weakly_equality_comparable_with<Sentinel, Iterator>;

template<class Sentinel, class Iterator>
concept sized_sentinel_for =
    sentinel_for<Sentinel, Iterator> &&
    requires(const Iterator& iterator, const Sentinel& sentinel) {
        sentinel - iterator;
        iterator - sentinel;
    };

template<class Input, class Output>
concept indirectly_movable =
    indirectly_readable<Input> &&
    indirectly_writable<Output, iter_rvalue_reference_t<Input>>;

template<class Input, class Output>
concept indirectly_movable_storable =
    indirectly_movable<Input, Output> &&
    indirectly_writable<Output, iter_value_t<Input>> &&
    movable<iter_value_t<Input>>;

template<class Input, class Output>
concept indirectly_copyable =
    indirectly_readable<Input> &&
    indirectly_writable<Output, iter_reference_t<Input>>;

template<class Input, class Output>
concept indirectly_copyable_storable =
    indirectly_copyable<Input, Output> &&
    indirectly_writable<Output, iter_value_t<Input>&> &&
    indirectly_writable<Output, const iter_value_t<Input>&> &&
    copyable<iter_value_t<Input>>;

template<class Left, class Right = Left>
concept indirectly_swappable =
    indirectly_readable<Left> &&
    indirectly_readable<Right> &&
    is_assignable_v<iter_reference_t<Left>,
                    iter_reference_t<Right>> &&
    is_assignable_v<iter_reference_t<Right>,
                    iter_reference_t<Left>> &&
    requires(const Left left, const Right right) {
        swap(*left, *left);
        swap(*right, *right);
        swap(*left, *right);
        swap(*right, *left);
    };

template<class Iterator>
concept random_access_iterator =
    input_or_output_iterator<Iterator> &&
    is_base_of_v<
        random_access_iterator_tag,
        typename iterator_traits<Iterator>::iterator_category>;

template<class Iterator>
concept contiguous_iterator =
    random_access_iterator<Iterator> &&
    (is_pointer_v<remove_cvref_t<Iterator>> ||
     requires {
         typename remove_cvref_t<Iterator>::iterator_concept;
         requires is_base_of_v<
             contiguous_iterator_tag,
             typename remove_cvref_t<Iterator>::iterator_concept>;
     });

template<class Iterator, class Type>
concept output_iterator =
    input_or_output_iterator<Iterator> &&
    indirectly_writable<Iterator, Type> &&
    requires(Iterator iterator, Type&& value) {
        *iterator++ = std::forward<Type>(value);
    };

