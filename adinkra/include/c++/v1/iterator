template<class Iterator>
class reverse_iterator {
public:
    using iterator_type = Iterator;
    using iterator_category =
        typename iterator_traits<Iterator>::iterator_category;
    using value_type = typename iterator_traits<Iterator>::value_type;
    using difference_type = typename iterator_traits<Iterator>::difference_type;
    using pointer = typename iterator_traits<Iterator>::pointer;
    using reference = typename iterator_traits<Iterator>::reference;

    constexpr reverse_iterator() : current_() {}
    explicit constexpr reverse_iterator(Iterator current) : current_(current) {}

    template<class Other>
        requires (
            !is_same_v<Other, Iterator> &&
            is_convertible_v<const Other&, Iterator>)
    constexpr reverse_iterator(const reverse_iterator<Other>& other)
        : current_(other.base()) {}

    template<class Other>
        requires (
            !is_same_v<Other, Iterator> &&
            is_convertible_v<const Other&, Iterator> &&
            is_assignable_v<Iterator&, const Other&>)
    constexpr reverse_iterator&
    operator=(const reverse_iterator<Other>& other) {
        current_ = other.base();
        return *this;
    }

    _ADINKRA_NODISCARD constexpr Iterator base() const {
        return current_;
    }

    _ADINKRA_NODISCARD constexpr reference operator*() const {
        Iterator temporary = current_;
        return *--temporary;
    }

    _ADINKRA_NODISCARD constexpr pointer operator->() const {
        return std::addressof(operator*());
    }

    constexpr reverse_iterator& operator++() {
        --current_;
        return *this;
    }

    constexpr reverse_iterator operator++(int) {
        reverse_iterator result(*this);
        --current_;
        return result;
    }

    constexpr reverse_iterator& operator--() {
        ++current_;
        return *this;
    }

    constexpr reverse_iterator operator--(int) {
        reverse_iterator result(*this);
        ++current_;
        return result;
    }

    constexpr reverse_iterator& operator+=(difference_type count) {
        current_ -= count;
        return *this;
    }

    constexpr reverse_iterator& operator-=(difference_type count) {
        current_ += count;
        return *this;
    }

    _ADINKRA_NODISCARD constexpr reverse_iterator
    operator+(difference_type count) const {
        return reverse_iterator(current_ - count);
    }

    _ADINKRA_NODISCARD constexpr reverse_iterator
    operator-(difference_type count) const {
        return reverse_iterator(current_ + count);
    }

    _ADINKRA_NODISCARD constexpr reference
    operator[](difference_type index) const {
        return *(*this + index);
    }

private:
    Iterator current_;
};

template<class Iterator>
_ADINKRA_NODISCARD constexpr reverse_iterator<Iterator>
make_reverse_iterator(Iterator iterator) {
    return reverse_iterator<Iterator>(iterator);
}

