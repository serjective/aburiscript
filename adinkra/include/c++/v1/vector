template<class Type, class Allocator>
_ADINKRA_NODISCARD constexpr bool operator==(
    const vector<Type, Allocator>& left,
    const vector<Type, Allocator>& right) {
    return left.size() == right.size() &&
           std::equal(left.begin(), left.end(), right.begin());
}

template<class Type, class Allocator>
_ADINKRA_NODISCARD constexpr auto operator<=>(
    const vector<Type, Allocator>& left,
    const vector<Type, Allocator>& right) {
    const auto compare = [](
        const Type& left_value,
        const Type& right_value) {
        if constexpr (requires {
                          left_value <=> right_value;
                      }) {
            return left_value <=> right_value;
        } else {
            return left_value < right_value
                       ? weak_ordering::less
                 : right_value < left_value
                       ? weak_ordering::greater
                       : weak_ordering::equivalent;
        }
    };
    using Result = decltype(compare(
        declval<const Type&>(), declval<const Type&>()));
    auto left_iterator = left.begin();
    auto right_iterator = right.begin();
    while (left_iterator != left.end() &&
           right_iterator != right.end()) {
        if (auto result =
                compare(*left_iterator, *right_iterator);
            result != 0) {
            return result;
        }
        ++left_iterator;
        ++right_iterator;
    }
    return left.size() < right.size() ? Result::less
         : left.size() > right.size() ? Result::greater
                                      : Result::equivalent;
}

template<class Allocator>
struct hash<vector<bool, Allocator>> {
    using argument_type = vector<bool, Allocator>;
    using result_type = size_t;

    size_t operator()(
        const vector<bool, Allocator>& value) const noexcept {
        size_t result =
            sizeof(size_t) == 8
                ? static_cast<size_t>(1469598103934665603ULL)
                : static_cast<size_t>(2166136261U);
        const size_t prime =
            sizeof(size_t) == 8
                ? static_cast<size_t>(1099511628211ULL)
                : static_cast<size_t>(16777619U);
        for (bool bit : value) {
            result ^= bit ? size_t(1) : size_t(0);
            result *= prime;
        }
        return result;
    }
};

template<class Type, class Allocator>
constexpr void swap(
    vector<Type, Allocator>& left, vector<Type, Allocator>& right)
    noexcept(noexcept(left.swap(right))) {
    left.swap(right);
}

template<class Type, class Allocator, class Value>
constexpr typename vector<Type, Allocator>::size_type erase(
    vector<Type, Allocator>& values, const Value& value) {
    const auto previous_size = values.size();
    const auto new_end =
        std::remove(values.begin(), values.end(), value);
    values.erase(new_end, values.end());
    return previous_size - values.size();
}

template<class Type, class Allocator, class Predicate>
constexpr typename vector<Type, Allocator>::size_type erase_if(
    vector<Type, Allocator>& values, Predicate predicate) {
    const auto previous_size = values.size();
    const auto new_end =
        std::remove_if(values.begin(), values.end(), predicate);
    values.erase(new_end, values.end());
    return previous_size - values.size();
}

