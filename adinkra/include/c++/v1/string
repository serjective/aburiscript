template<class Character, class Traits, class Allocator, class Value>
typename basic_string<Character, Traits, Allocator>::size_type erase(
    basic_string<Character, Traits, Allocator>& value,
    const Value& removed_value) {
    const auto previous_size = value.size();
    const auto new_end =
        std::remove(value.begin(), value.end(), removed_value);
    value.erase(new_end, value.end());
    return previous_size - value.size();
}

template<class Character, class Traits, class Allocator, class Predicate>
typename basic_string<Character, Traits, Allocator>::size_type erase_if(
    basic_string<Character, Traits, Allocator>& value,
    Predicate predicate) {
    const auto previous_size = value.size();
    const auto new_end =
        std::remove_if(value.begin(), value.end(), predicate);
    value.erase(new_end, value.end());
    return previous_size - value.size();
}

template<class Character, class Traits, class Allocator>
struct hash<basic_string<Character, Traits, Allocator>> {
    using argument_type = basic_string<Character, Traits, Allocator>;
    using result_type = size_t;

    size_t operator()(
        const basic_string<Character, Traits, Allocator>& value)
        const noexcept {
        size_t result =
            sizeof(size_t) == 8
                ? static_cast<size_t>(1469598103934665603ULL)
                : static_cast<size_t>(2166136261U);
        const size_t prime =
            sizeof(size_t) == 8
                ? static_cast<size_t>(1099511628211ULL)
                : static_cast<size_t>(16777619U);
        const unsigned char* bytes =
            reinterpret_cast<const unsigned char*>(value.data());
        for (size_t index = 0;
             index < value.size() * sizeof(Character); ++index) {
            result ^= bytes[index];
            result *= prime;
        }
        return result;
    }
};

