}

template<class Character, class Traits, class Allocator>
_ADINKRA_NODISCARD auto operator<=>(
    const basic_string<Character, Traits, Allocator>& left,
    const Character* right) {
    const int result = left.compare(right);
    return result < 0 ? strong_ordering::less
         : result > 0 ? strong_ordering::greater
                      : strong_ordering::equal;
}

template<class Character, class Traits, class Allocator>
_ADINKRA_NODISCARD auto operator<=>(
    const Character* left,
    const basic_string<Character, Traits, Allocator>& right) {
    const int result = right.compare(left);
    return result < 0 ? strong_ordering::greater
         : result > 0 ? strong_ordering::less
                      : strong_ordering::equal;
}

