_ADINKRA_NODISCARD bool operator==(
    const basic_string<Character, Traits, Allocator>& left,
    const basic_string<Character, Traits, Allocator>& right) noexcept {
    return left.size() == right.size() && left.compare(right) == 0;
}

template<class Character, class Traits, class Allocator>
_ADINKRA_NODISCARD auto operator<=>(
    const basic_string<Character, Traits, Allocator>& left,
    const basic_string<Character, Traits, Allocator>& right) noexcept {
    const int result = left.compare(right);
    if constexpr (
        requires { typename Traits::comparison_category; }) {
        using category = typename Traits::comparison_category;
        return result < 0 ? category::less
             : result > 0 ? category::greater
                          : category::equivalent;
    } else {
        return result < 0 ? weak_ordering::less
             : result > 0 ? weak_ordering::greater
                          : weak_ordering::equivalent;
    }
}

template<class Character, class Traits, class Allocator>
_ADINKRA_NODISCARD bool operator==(
    const basic_string<Character, Traits, Allocator>& left,
    const Character* right) {
