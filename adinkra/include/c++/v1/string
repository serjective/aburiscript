    _ADINKRA_NODISCARD bool uses_local() const noexcept {
        return data_ == local_;
    }

    _ADINKRA_NODISCARD
    basic_string_view<Character, Traits> view() const noexcept {
        return basic_string_view<Character, Traits>(data_, size_);
    }

    _ADINKRA_NODISCARD bool
    points_inside(const Character* value) const noexcept {
        const uintptr_t address =
            reinterpret_cast<uintptr_t>(value);
        const uintptr_t first =
            reinterpret_cast<uintptr_t>(data_);
        const uintptr_t last =
            reinterpret_cast<uintptr_t>(data_ + size_);
        return address >= first && address <= last;
    }

    void check_index(size_type position) const {
        if (position >= size_) {
            throw out_of_range("basic_string::at");
        }
    }

    void check_position(size_type position) const {
        if (position > size_) {
            throw out_of_range("basic_string position");
        }
    }

    void reset_local() noexcept {
        data_ = local_;
        size_ = 0;
        capacity_ = local_capacity_value;
        local_[0] = Character();
    }

    void release_heap() noexcept {
        if (!uses_local()) {
            allocator_traits<Allocator>::deallocate(
                allocator_, data_, capacity_ + 1);
        }
    }

    void take_heap(basic_string& other) noexcept {
        data_ = other.data_;
        size_ = other.size_;
        capacity_ = other.capacity_;
        other.reset_local();
    }

    void take_or_copy(basic_string& other) {
        if (other.uses_local()) {
            assign(other.data_, other.size_);
            other.clear();
        } else {
            take_heap(other);
        }
    }

    void ensure_extra_capacity(size_type extra) {
        if (extra > max_size() - size_) {
            throw length_error("basic_string capacity exceeds max_size");
        }
        ensure_capacity(size_ + extra);
    }

    void ensure_capacity(size_type required) {
        if (required > capacity_) {
            reallocate(__storage::recommend_capacity(
                capacity_, required, max_size()));
        }
    }

    void reallocate(size_type requested) {
        pointer replacement =
            allocator_traits<Allocator>::allocate(
                allocator_, requested + 1);
        Traits::copy(replacement, data_, size_ + 1);
        release_heap();
        data_ = replacement;
        capacity_ = requested;
    }
};

