    void merge(
        multimap<Key, Mapped, OtherCompare, Allocator>& source) {
        if (static_cast<const void*>(this) ==
            static_cast<const void*>(std::addressof(source))) {
            return;
        }
        auto current = source.begin();
        while (current != source.end()) {
            insert(*current);
            current = source.erase(current);
        }
