template<class Iterator, class Type, class Compare = less,
         class Projection = identity>
    requires (!range<remove_cvref_t<Iterator>>)
_ADINKRA_NODISCARD constexpr Iterator lower_bound(
    Iterator first, Iterator last, const Type& value,
    Compare compare = {}, Projection projection = {}) {
    auto count_value = std::distance(first, last);
    while (count_value > 0) {
        auto step = count_value / 2;
        Iterator middle = first;
        std::advance(middle, step);
        if (std::invoke(
                compare, std::invoke(projection, *middle), value)) {
            first = ++middle;
            count_value -= step + 1;
        } else {
            count_value = step;
        }
    }
    return first;
}

template<class Range, class Type, class Compare = less,
         class Projection = identity>
    requires range<remove_reference_t<Range>>
_ADINKRA_NODISCARD constexpr auto lower_bound(
    Range&& range_value, const Type& value,
    Compare compare = {}, Projection projection = {}) {
    return ranges::lower_bound(
        std::begin(range_value), std::end(range_value), value,
        std::move(compare), std::move(projection));
}

