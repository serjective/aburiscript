template<class Element, size_t Extent>
class span;

namespace ranges {

template<class Range>
    requires requires(Range&& range) {
        std::begin(std::forward<Range>(range));
    }
_ADINKRA_NODISCARD constexpr decltype(auto) begin(Range&& value) {
    return std::begin(std::forward<Range>(value));
}

template<class Range>
    requires requires(Range&& range) {
        std::end(std::forward<Range>(range));
    }
_ADINKRA_NODISCARD constexpr decltype(auto) end(Range&& value) {
    return std::end(std::forward<Range>(value));
}

template<class Range>
using iterator_t = decltype(ranges::begin(declval<Range&>()));

template<class Range>
using sentinel_t = decltype(ranges::end(declval<Range&>()));

template<class Range>
using range_value_t =
    remove_cvref_t<decltype(*ranges::begin(declval<Range&>()))>;

template<class Range>
concept range = requires(Range& value) {
    ranges::begin(value);
    ranges::end(value);
};

template<class Range>
concept input_range = range<Range>;

template<class Range>
concept common_range =
    range<Range> &&
    same_as<iterator_t<Range>, sentinel_t<Range>>;

template<class Range>
concept sized_range =
    range<Range> &&
    requires(Range& value) {
        std::size(value);
    };

template<class Range>
concept random_access_range =
    range<Range> &&
    std::random_access_iterator<iterator_t<Range>>;

template<class Range>
concept contiguous_range =
    random_access_range<Range> &&
    std::contiguous_iterator<iterator_t<Range>>;

template<class Iterator, class Sentinel = Iterator>
class subrange {
public:
    constexpr subrange() = default;

    constexpr subrange(Iterator first, Sentinel last)
        : first_(std::move(first)), last_(std::move(last)) {}

    _ADINKRA_NODISCARD constexpr Iterator begin() const {
        return first_;
    }

    _ADINKRA_NODISCARD constexpr Sentinel end() const {
        return last_;
    }

    _ADINKRA_NODISCARD constexpr bool empty() const {
        return first_ == last_;
    }

    _ADINKRA_NODISCARD constexpr auto size() const {
        auto first = first_;
        iter_difference_t<Iterator> result = 0;
        while (first != last_) {
            ++first;
            ++result;
        }
        return static_cast<make_unsigned_t<
            iter_difference_t<Iterator>>>(result);
    }

private:
    Iterator first_{};
    Sentinel last_{};
};

template<class Iterator, class Sentinel>
subrange(Iterator, Sentinel) -> subrange<Iterator, Sentinel>;

template<class Type>
inline constexpr bool enable_view = false;

template<class Type>
concept view =
    range<Type> &&
    movable<Type> &&
    enable_view<Type>;

template<class Type>
inline constexpr bool enable_borrowed_range = false;

template<class Iterator, class Sentinel>
inline constexpr bool
enable_borrowed_range<subrange<Iterator, Sentinel>> = true;

template<class Element, size_t Extent>
inline constexpr bool enable_borrowed_range<span<Element, Extent>> = true;

template<class Range>
concept borrowed_range =
    range<Range> &&
    (is_lvalue_reference_v<Range> ||
     enable_borrowed_range<remove_cvref_t<Range>>);

template<class Range>
concept viewable_range =
    range<Range> &&
    (borrowed_range<Range> ||
     view<remove_cvref_t<Range>> ||
     (!is_const_v<remove_reference_t<Range>> &&
      is_move_constructible_v<remove_reference_t<Range>>));

struct less {
    using is_transparent = void;

    template<class Left, class Right>
    constexpr bool operator()(Left&& left, Right&& right) const {
        return std::forward<Left>(left) < std::forward<Right>(right);
    }
};

struct greater {
    using is_transparent = void;

    template<class Left, class Right>
    constexpr bool operator()(Left&& left, Right&& right) const {
        return std::forward<Right>(right) < std::forward<Left>(left);
    }
};

template<class Input, class Output>
struct in_out_result {
    Input in;
    Output out;
};

template<class Range>
_ADINKRA_NODISCARD constexpr auto size(Range&& value)
    noexcept(noexcept(std::size(value))) {
    return std::size(value);
}

template<class Iterator, class Sentinel>
    requires (!range<remove_cvref_t<Iterator>>) &&
             sentinel_for<Sentinel, Iterator>
_ADINKRA_NODISCARD constexpr iter_difference_t<Iterator> distance(
    Iterator first, Sentinel last) {
    if constexpr (sized_sentinel_for<Sentinel, Iterator>) {
        return last - first;
    } else {
        iter_difference_t<Iterator> result = 0;
        while (first != last) {
            ++first;
            ++result;
        }
        return result;
    }
}

template<class Range>
    requires range<remove_reference_t<Range>>
_ADINKRA_NODISCARD constexpr auto distance(Range&& value) {
    return ranges::distance(
        std::begin(value), std::end(value));
}

template<class Iterator, class Sentinel, class Predicate,
         class Projection = identity>
    requires (!range<remove_cvref_t<Iterator>>) &&
             sentinel_for<Sentinel, Iterator>
_ADINKRA_NODISCARD constexpr bool all_of(
    Iterator first, Sentinel last, Predicate predicate,
    Projection projection = {}) {
    while (first != last) {
        if (!std::invoke(predicate, std::invoke(projection, *first))) {
            return false;
        }
        ++first;
    }
    return true;
}

template<class Range, class Predicate, class Projection = identity>
    requires range<remove_reference_t<Range>>
_ADINKRA_NODISCARD constexpr bool all_of(
    Range&& value, Predicate predicate, Projection projection = {}) {
    return ranges::all_of(
        std::begin(value), std::end(value),
        std::move(predicate), std::move(projection));
}

template<class Iterator, class Sentinel, class Predicate,
         class Projection = identity>
    requires (!range<remove_cvref_t<Iterator>>)
_ADINKRA_NODISCARD constexpr bool any_of(
    Iterator first, Sentinel last, Predicate predicate,
    Projection projection = {}) {
    while (first != last) {
        if (std::invoke(predicate, std::invoke(projection, *first))) {
            return true;
        }
        ++first;
    }
    return false;
}

template<class Range, class Predicate, class Projection = identity>
