template<class Type, class Compare = less, class Projection = identity>
    requires (!range<const Type>)
_ADINKRA_NODISCARD constexpr const Type& min(
    const Type& left, const Type& right,
    Compare compare = {}, Projection projection = {}) {
    return std::invoke(
               compare,
               std::invoke(projection, right),
               std::invoke(projection, left))
        ? right
        : left;
}

template<class Range, class Compare = less, class Projection = identity>
    requires range<remove_reference_t<Range>>
_ADINKRA_NODISCARD constexpr range_value_t<Range> min(
    Range&& value, Compare compare = {}, Projection projection = {}) {
    auto first = std::begin(value);
    const auto last = std::end(value);
    range_value_t<Range> result = *first;
    while (++first != last) {
        if (std::invoke(
                compare,
                std::invoke(projection, *first),
                std::invoke(projection, result))) {
            result = *first;
        }
    }
    return result;
}

