template<class Iterator, class Sentinel, class Type,
         class Projection = identity>
    requires (!range<remove_cvref_t<Iterator>>)
_ADINKRA_NODISCARD constexpr Iterator find(
    Iterator first, Sentinel last, const Type& value,
    Projection projection = {}) {
    while (first != last &&
           !(std::invoke(projection, *first) == value)) {
        ++first;
    }
    return first;
}

