template<class Range, bool = is_lvalue_reference_v<Range>>
class range_storage;

template<class Range>
class range_storage<Range, true> {
public:
    using stored_type = remove_reference_t<Range>;

    constexpr explicit range_storage(Range value)
        : value_(std::addressof(value)) {}

    constexpr stored_type& get() const {
        return *value_;
    }

private:
    stored_type* value_;
};

template<class Range>
class range_storage<Range, false> {
public:
    using stored_type = remove_cvref_t<Range>;

    constexpr explicit range_storage(Range&& value)
        : value_(std::forward<Range>(value)) {}

    constexpr stored_type& get() {
        return value_;
    }

    constexpr const stored_type& get() const {
        return value_;
    }

private:
    stored_type value_;
};

template<class Range>
class reverse_view {
public:
    constexpr explicit reverse_view(Range&& value)
        : range_(std::forward<Range>(value)) {}

    constexpr auto begin() {
        return std::make_reverse_iterator(std::end(range_.get()));
    }

    constexpr auto end() {
        return std::make_reverse_iterator(std::begin(range_.get()));
    }

    constexpr auto begin() const {
        return std::make_reverse_iterator(std::end(range_.get()));
    }

    constexpr auto end() const {
        return std::make_reverse_iterator(std::begin(range_.get()));
    }

    constexpr auto size() const
        requires requires(const range_storage<Range>& storage) {
            std::size(storage.get());
        } {
        return std::size(range_.get());
    }

