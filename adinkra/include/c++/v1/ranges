template<class FirstIterator, class FirstSentinel,
         class SecondIterator, class SecondSentinel,
         class Predicate = std::equal_to<>,
         class FirstProjection = identity,
         class SecondProjection = identity>
    requires (!range<remove_cvref_t<FirstIterator>>)
_ADINKRA_NODISCARD constexpr bool equal(
    FirstIterator first, FirstSentinel last,
    SecondIterator second, SecondSentinel second_last,
    Predicate predicate = {},
    FirstProjection first_projection = {},
    SecondProjection second_projection = {}) {
    while (first != last && second != second_last) {
        if (!std::invoke(
                predicate,
                std::invoke(first_projection, *first),
                std::invoke(second_projection, *second))) {
            return false;
        }
        ++first;
        ++second;
    }
    return first == last && second == second_last;
}

template<class FirstRange, class SecondRange,
         class Predicate = std::equal_to<>,
         class FirstProjection = identity,
         class SecondProjection = identity>
    requires (
        range<remove_reference_t<FirstRange>> &&
        range<remove_reference_t<SecondRange>>)
_ADINKRA_NODISCARD constexpr bool equal(
    FirstRange&& first, SecondRange&& second,
    Predicate predicate = {},
    FirstProjection first_projection = {},
    SecondProjection second_projection = {}) {
    return ranges::equal(
        std::begin(first), std::end(first),
        std::begin(second), std::end(second),
        std::move(predicate),
        std::move(first_projection),
        std::move(second_projection));
}

template<class Iterator, class Sentinel, class Type>
constexpr Iterator fill(Iterator first, Sentinel last, const Type& value) {
    while (first != last) {
        *first = value;
        ++first;
    }
    return first;
}

template<class Range, class Type>
constexpr auto fill(Range&& range_value, const Type& value) {
    return ranges::fill(
        std::begin(range_value), std::end(range_value), value);
}

template<class Iterator, class Sentinel, class Output>
constexpr in_out_result<Iterator, Output>
copy(Iterator first, Sentinel last, Output output) {
    while (first != last) {
        *output = *first;
        ++first;
        ++output;
    }
    return {first, output};
}

template<class Range, class Output>
constexpr auto copy(Range&& value, Output output) {
    return ranges::copy(
        std::begin(value), std::end(value), std::move(output));
}

template<class Iterator, class Sentinel, class Output,
         class Function, class Projection = identity>
    requires (!range<remove_cvref_t<Iterator>>) &&
             sentinel_for<Sentinel, Iterator>
constexpr in_out_result<Iterator, Output>
transform(
    Iterator first, Sentinel last, Output output,
    Function function, Projection projection = {}) {
    while (first != last) {
        *output = std::invoke(
            function, std::invoke(projection, *first));
        ++first;
        ++output;
    }
    return {std::move(first), std::move(output)};
}

template<class Range, class Output, class Function,
         class Projection = identity>
    requires range<remove_reference_t<Range>>
constexpr auto transform(
    Range&& value, Output output,
    Function function, Projection projection = {}) {
    return ranges::transform(
        std::begin(value), std::end(value), std::move(output),
        std::move(function), std::move(projection));
}

template<class Iterator, class Sentinel, class Type>
constexpr Iterator replace(
    Iterator first, Sentinel last,
    const Type& old_value, const Type& new_value) {
    while (first != last) {
        if (*first == old_value) {
            *first = new_value;
        }
        ++first;
    }
    return first;
}

template<class Range, class Type>
constexpr auto replace(
    Range&& value, const Type& old_value, const Type& new_value) {
    return ranges::replace(
        std::begin(value), std::end(value), old_value, new_value);
}

template<class Iterator, class Sentinel>
constexpr Iterator reverse(Iterator first, Sentinel last) {
    Iterator result = first;
    Iterator common_last = last;
    std::reverse(first, common_last);
    return common_last;
}

template<class Range>
constexpr auto reverse(Range&& value) {
    auto last = std::end(value);
    std::reverse(std::begin(value), last);
    return last;
}

template<class Iterator, class Sentinel, class Generator>
    requires (!range<remove_cvref_t<Iterator>>) &&
             sentinel_for<Sentinel, Iterator>
Iterator shuffle(
    Iterator first, Sentinel last, Generator&& generator) {
    Iterator common_last = first;
    while (common_last != last) {
        ++common_last;
    }
    std::shuffle(
        first, common_last, std::forward<Generator>(generator));
    return common_last;
}

template<class Range, class Generator>
    requires range<remove_reference_t<Range>>
auto shuffle(Range&& value, Generator&& generator) {
    return ranges::shuffle(
        std::begin(value), std::end(value),
        std::forward<Generator>(generator));
}

template<class Iterator, class Sentinel, class Compare = less,
         class Projection = identity>
    requires (!range<remove_cvref_t<Iterator>>) &&
             sentinel_for<Sentinel, Iterator>
constexpr Iterator sort(
    Iterator first, Sentinel last,
    Compare compare = {}, Projection projection = {}) {
    Iterator common_last = last;
    std::sort(first, common_last, [&](const auto& left, const auto& right) {
        return std::invoke(
            compare,
            std::invoke(projection, left),
            std::invoke(projection, right));
    });
    return common_last;
}

