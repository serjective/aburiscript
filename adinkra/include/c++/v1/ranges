template<class Iterator, class Sentinel, class Type,
         class Compare = less, class Projection = identity>
    requires (!range<remove_cvref_t<Iterator>>) &&
             sentinel_for<Sentinel, Iterator>
_ADINKRA_NODISCARD constexpr subrange<Iterator>
equal_range(
    Iterator first, Sentinel last, const Type& value,
    Compare compare = {}, Projection projection = {}) {
    Iterator common_last = first;
    while (common_last != last) {
        ++common_last;
    }
    Iterator lower = ranges::lower_bound(
        first, common_last, value, compare, projection);
    Iterator upper = ranges::upper_bound(
        lower, common_last, value,
        std::move(compare), std::move(projection));
    return {std::move(lower), std::move(upper)};
}

template<class Range, class Type, class Compare = less,
         class Projection = identity>
    requires range<remove_reference_t<Range>>
_ADINKRA_NODISCARD constexpr auto equal_range(
    Range&& range_value, const Type& value,
    Compare compare = {}, Projection projection = {}) {
    return ranges::equal_range(
        std::begin(range_value), std::end(range_value), value,
        std::move(compare), std::move(projection));
}

template<class Iterator, class Sentinel, class Type,
         class Compare = less, class Projection = identity>
    requires (!range<remove_cvref_t<Iterator>>) &&
             sentinel_for<Sentinel, Iterator>
_ADINKRA_NODISCARD constexpr bool binary_search(
    Iterator first, Sentinel last, const Type& value,
    Compare compare = {}, Projection projection = {}) {
    Iterator common_last = first;
    while (common_last != last) {
        ++common_last;
    }
    Iterator found = ranges::lower_bound(
        first, common_last, value, compare, projection);
    return found != common_last &&
           !std::invoke(
               compare, value, std::invoke(projection, *found));
}

template<class Range, class Type, class Compare = less,
         class Projection = identity>
    requires range<remove_reference_t<Range>>
_ADINKRA_NODISCARD constexpr bool binary_search(
    Range&& range_value, const Type& value,
    Compare compare = {}, Projection projection = {}) {
    return ranges::binary_search(
        std::begin(range_value), std::end(range_value), value,
        std::move(compare), std::move(projection));
}

