    range_storage<Range> range_;
};

template<class Iterator, class Function>
class transform_iterator {
public:
    using difference_type = iter_difference_t<Iterator>;
    using reference = decltype(
        std::invoke(declval<Function&>(), *declval<Iterator&>()));
    using value_type = remove_cvref_t<reference>;
    using pointer = void;
    using iterator_category =
        typename iterator_traits<Iterator>::iterator_category;

    constexpr transform_iterator() : current_(), function_(nullptr) {}

    constexpr transform_iterator(Iterator current, Function* function)
        : current_(current), function_(function) {}

    constexpr decltype(auto) operator*() const {
        return std::invoke(*function_, *current_);
    }

    constexpr transform_iterator& operator++() {
        ++current_;
        return *this;
    }

    constexpr transform_iterator operator++(int) {
        transform_iterator previous(*this);
        ++*this;
        return previous;
    }

    friend constexpr bool operator==(
        const transform_iterator& left,
        const transform_iterator& right) {
        return left.current_ == right.current_;
    }

private:
    Iterator current_;
    Function* function_;
};

template<class Range, class Function>
class transform_view {
public:
    constexpr transform_view(Range&& value, Function function)
        : range_(std::forward<Range>(value)),
          function_(std::move(function)) {}

    constexpr auto begin() {
        return transform_iterator<
            decltype(std::begin(range_.get())), Function>(
                std::begin(range_.get()), std::addressof(function_));
    }

    constexpr auto end() {
        return transform_iterator<
            decltype(std::end(range_.get())), Function>(
                std::end(range_.get()), std::addressof(function_));
    }

    constexpr auto begin() const {
        return transform_iterator<
            decltype(std::begin(range_.get())), const Function>(
                std::begin(range_.get()), std::addressof(function_));
    }

    constexpr auto end() const {
        return transform_iterator<
            decltype(std::end(range_.get())), const Function>(
                std::end(range_.get()), std::addressof(function_));
    }

    constexpr auto size() const
        requires requires(const range_storage<Range>& storage) {
            std::size(storage.get());
        } {
        return std::size(range_.get());
    }

    constexpr bool empty() const {
        return std::begin(range_.get()) == std::end(range_.get());
    }

private:
    range_storage<Range> range_;
    Function function_;
};

template<size_t Index>
struct element_projection {
    template<class TupleLike>
    constexpr decltype(auto) operator()(TupleLike&& value) const {
        return std::get<Index>(std::forward<TupleLike>(value));
    }
};

template<class Function>
class transform_closure {
public:
    constexpr explicit transform_closure(Function function)
        : function_(std::move(function)) {}

    template<class Range>
    constexpr auto operator()(Range&& value) const {
        return transform_view<Range, Function>(
            std::forward<Range>(value), function_);
    }

    template<class Range>
    friend constexpr auto operator|(
        Range&& value, const transform_closure& closure) {
        return closure(std::forward<Range>(value));
    }

private:
    Function function_;
};

template<class Iterator, class Predicate>
class filter_iterator {
public:
    using difference_type = iter_difference_t<Iterator>;
    using reference = decltype(*declval<Iterator&>());
    using value_type = remove_cvref_t<reference>;
    using pointer = void;
    using iterator_category = input_iterator_tag;

    constexpr filter_iterator()
        : current_(), last_(), predicate_(nullptr) {}

    constexpr filter_iterator(
        Iterator current, Iterator last, Predicate* predicate)
        : current_(current), last_(last), predicate_(predicate) {
        find_next();
    }

    constexpr decltype(auto) operator*() const {
        return *current_;
    }

    constexpr filter_iterator& operator++() {
        ++current_;
        find_next();
        return *this;
    }

    constexpr filter_iterator operator++(int) {
        filter_iterator previous(*this);
        ++*this;
        return previous;
    }

    friend constexpr bool operator==(
        const filter_iterator& left,
        const filter_iterator& right) {
        return left.current_ == right.current_;
    }

private:
    constexpr void find_next() {
        while (current_ != last_ &&
               !std::invoke(*predicate_, *current_)) {
            ++current_;
        }
    }

    Iterator current_;
    Iterator last_;
    Predicate* predicate_;
};

template<class Range, class Predicate>
class filter_view {
public:
    constexpr filter_view(Range&& value, Predicate predicate)
        : range_(std::forward<Range>(value)),
          predicate_(std::move(predicate)) {}

    constexpr auto begin() {
        using iterator = decltype(std::begin(range_.get()));
        return filter_iterator<iterator, Predicate>(
            std::begin(range_.get()), std::end(range_.get()),
            std::addressof(predicate_));
    }

    constexpr auto end() {
        using iterator = decltype(std::end(range_.get()));
        return filter_iterator<iterator, Predicate>(
            std::end(range_.get()), std::end(range_.get()),
            std::addressof(predicate_));
    }

    constexpr auto begin() const {
        using iterator = decltype(std::begin(range_.get()));
        return filter_iterator<iterator, const Predicate>(
            std::begin(range_.get()), std::end(range_.get()),
            std::addressof(predicate_));
    }

    constexpr auto end() const {
        using iterator = decltype(std::end(range_.get()));
        return filter_iterator<iterator, const Predicate>(
            std::end(range_.get()), std::end(range_.get()),
            std::addressof(predicate_));
    }

    constexpr bool empty() const {
        return begin() == end();
    }

private:
    range_storage<Range> range_;
    Predicate predicate_;
};

template<class Predicate>
class filter_closure {
public:
    constexpr explicit filter_closure(Predicate predicate)
        : predicate_(std::move(predicate)) {}

    template<class Range>
    constexpr auto operator()(Range&& value) const {
        return filter_view<Range, Predicate>(
            std::forward<Range>(value), predicate_);
    }

    template<class Range>
    friend constexpr auto operator|(
        Range&& value, const filter_closure& closure) {
        return closure(std::forward<Range>(value));
    }

private:
    Predicate predicate_;
};

template<class Value>
class iota_iterator {
public:
    using difference_type = ptrdiff_t;
    using value_type = Value;
    using pointer = void;
    using reference = Value;
    using iterator_category = input_iterator_tag;

    constexpr explicit iota_iterator(Value value) : value_(value) {}

    constexpr Value operator*() const {
        return value_;
    }

    constexpr iota_iterator& operator++() {
        ++value_;
        return *this;
    }

    constexpr iota_iterator operator++(int) {
        iota_iterator previous(*this);
        ++*this;
        return previous;
    }

    friend constexpr bool operator==(
        const iota_iterator&, const iota_iterator&) = default;

private:
    Value value_;
};

template<class Value>
class iota_view {
public:
    constexpr iota_view(Value first, Value last)
        : first_(first), last_(last) {}

    constexpr auto begin() const {
        return iota_iterator<Value>(first_);
    }

    constexpr auto end() const {
        return iota_iterator<Value>(last_);
    }

    constexpr auto size() const
        requires is_integral_v<Value> {
        using Unsigned = make_unsigned_t<Value>;
        if constexpr (is_signed_v<Value>) {
            if (first_ < 0) {
                const Unsigned first_magnitude =
                    Unsigned(0) - static_cast<Unsigned>(first_);
                if (last_ < 0) {
                    return first_magnitude -
                        (Unsigned(0) -
                         static_cast<Unsigned>(last_));
                }
                return static_cast<Unsigned>(last_) +
                    first_magnitude;
            }
        }
        return static_cast<Unsigned>(last_) -
            static_cast<Unsigned>(first_);
    }

private:
    Value first_;
    Value last_;
};

