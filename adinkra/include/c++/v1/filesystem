}

inline bool create_directories(
    const path& value, error_code& error) noexcept {
    if (value.empty()) {
        __set_filesystem_error(error, EINVAL);
        return false;
    }
    if (filesystem::is_directory(value)) {
        error.clear();
        return false;
    }
    const path parent = value.parent_path();
    if (!parent.empty() && parent != value &&
        !filesystem::is_directory(parent)) {
        create_directories(parent, error);
        if (error) {
            return false;
        }
    }
    if (::mkdir(value.c_str(), 0777) == 0) {
        error.clear();
        return true;
    }
    if (errno == EEXIST && filesystem::is_directory(value)) {
        error.clear();
        return false;
    }
    __set_filesystem_error(error, errno);
    return false;
}

inline bool create_directories(const path& value) noexcept {
    error_code error;
    return create_directories(value, error);
}

inline bool __has_copy_option(
    copy_options options, copy_options searched) noexcept {
    return (static_cast<unsigned>(options & searched) != 0);
}

inline bool copy_file(
    const path& source, const path& destination,
    copy_options options, error_code& error) noexcept {
    int input = ::open(source.c_str(), O_RDONLY);
    if (input < 0) {
        __set_filesystem_error(error, errno);
        return false;
    }

    int flags = O_WRONLY | O_CREAT;
    if (__has_copy_option(
            options, copy_options::overwrite_existing)) {
        flags |= O_TRUNC;
    } else {
        flags |= O_EXCL;
    }
    int output = ::open(destination.c_str(), flags, 0666);
    if (output < 0) {
        const int open_error = errno;
        ::close(input);
        if (open_error == EEXIST &&
            __has_copy_option(
                options, copy_options::skip_existing)) {
            error.clear();
            return false;
        }
        __set_filesystem_error(error, open_error);
        return false;
    }

    bool copied = true;
    char buffer[16384];
    while (true) {
        const ssize_t read_count =
            ::read(input, buffer, sizeof(buffer));
        if (read_count == 0) {
            break;
        }
        if (read_count < 0) {
            __set_filesystem_error(error, errno);
            copied = false;
            break;
        }
        ssize_t written = 0;
        while (written < read_count) {
            const ssize_t write_count = ::write(
                output, buffer + written,
                static_cast<size_t>(read_count - written));
            if (write_count < 0) {
                __set_filesystem_error(error, errno);
                copied = false;
                break;
            }
            written += write_count;
        }
        if (!copied) {
            break;
        }
    }

    const int input_close = ::close(input);
    const int output_close = ::close(output);
    if (copied && (input_close != 0 || output_close != 0)) {
        __set_filesystem_error(error, errno);
        return false;
    }
    if (copied) {
        error.clear();
    }
    return copied;
}

inline bool copy_file(
    const path& source, const path& destination,
    error_code& error) noexcept {
    return copy_file(
        source, destination, copy_options::none, error);
}

inline void copy(
    const path& source, const path& destination,
    copy_options options, error_code& error) noexcept {
    const file_status source_status =
        filesystem::symlink_status(source, error);
    if (error) {
        return;
    }

    if (source_status.type() == file_type::directory) {
        if (!__has_copy_option(options, copy_options::recursive)) {
            __set_filesystem_error(error, EISDIR);
            return;
        }
        filesystem::create_directories(destination, error);
        if (error) {
            return;
        }
        directory_iterator children(source, error);
        if (error) {
            return;
        }
        for (const directory_entry& child : children) {
            filesystem::copy(
                child.path(),
                destination / child.path().filename(),
                options, error);
            if (error) {
                return;
            }
        }
        error.clear();
        return;
    }

    if (source_status.type() == file_type::symlink) {
        char target[PATH_MAX];
        const ssize_t count = ::readlink(
            source.c_str(), target, sizeof(target) - 1);
        if (count < 0) {
            __set_filesystem_error(error, errno);
            return;
        }
        target[count] = '\0';
        if (::symlink(target, destination.c_str()) != 0) {
            __set_filesystem_error(error, errno);
            return;
        }
        error.clear();
        return;
    }

    filesystem::copy_file(
        source, destination, options, error);
}

inline void create_symlink(
    const path& target, const path& link,
    error_code& error) noexcept {
    if (::symlink(target.c_str(), link.c_str()) != 0) {
        __set_filesystem_error(error, errno);
        return;
    }
    error.clear();
}

inline void create_hard_link(
    const path& target, const path& link,
    error_code& error) noexcept {
    if (::link(target.c_str(), link.c_str()) != 0) {
        __set_filesystem_error(error, errno);
        return;
    }
    error.clear();
}

inline uintmax_t hard_link_count(
    const path& value, error_code& error) noexcept {
    struct stat information {};
    if (::stat(value.c_str(), &information) != 0) {
        __set_filesystem_error(error, errno);
        return static_cast<uintmax_t>(-1);
    }
    error.clear();
    return static_cast<uintmax_t>(information.st_nlink);
}

struct space_info {
    uintmax_t capacity;
    uintmax_t free;
    uintmax_t available;
};

inline space_info space(
    const path& value, error_code& error) noexcept {
    struct statvfs information {};
    if (::statvfs(value.c_str(), &information) != 0) {
        __set_filesystem_error(error, errno);
        const uintmax_t invalid = static_cast<uintmax_t>(-1);
        return {invalid, invalid, invalid};
    }
    const uintmax_t block_size =
        static_cast<uintmax_t>(information.f_frsize);
    error.clear();
    return {
        static_cast<uintmax_t>(information.f_blocks) * block_size,
        static_cast<uintmax_t>(information.f_bfree) * block_size,
        static_cast<uintmax_t>(information.f_bavail) * block_size
    };
}

inline file_time_type last_write_time(
    const path& value, error_code& error) noexcept {
    struct stat information {};
    if (::stat(value.c_str(), &information) != 0) {
        __set_filesystem_error(error, errno);
        return file_time_type::min();
    }
#if defined(__APPLE__)
    const timespec modified = information.st_mtimespec;
#else
    const timespec modified = information.st_mtim;
#endif
    error.clear();
    return file_time_type(chrono::nanoseconds(
        static_cast<long long>(modified.tv_sec) * 1000000000LL +
        static_cast<long long>(modified.tv_nsec)));
}

inline void last_write_time(
    const path& value, file_time_type time,
    error_code& error) noexcept {
    const long long nanoseconds =
        time.time_since_epoch().count();
    timespec times[2] = {
        {0, UTIME_OMIT},
        {
            static_cast<time_t>(nanoseconds / 1000000000LL),
            static_cast<long>(nanoseconds % 1000000000LL)
        }
    };
    if (::utimensat(
            AT_FDCWD, value.c_str(), times, 0) != 0) {
        __set_filesystem_error(error, errno);
        return;
    }
    error.clear();
}

inline path canonical(
    const path& value, error_code& error) {
    char resolved[PATH_MAX];
    if (::realpath(value.c_str(), resolved) == nullptr) {
        __set_filesystem_error(error, errno);
        return {};
    }
    error.clear();
    return path(resolved);
}

inline path temp_directory_path(error_code& error) {
    const char* temporary = ::getenv("TMPDIR");
    path result(
        temporary != nullptr && temporary[0] != '\0'
            ? temporary
            : "/tmp");
    if (!filesystem::is_directory(result, error)) {
        return {};
    }
    error.clear();
    if (!result.native().empty() &&
        result.native().back() != path::preferred_separator) {
        result /= path("");
        string native = result.native();
        native.push_back(path::preferred_separator);
        result = path(std::move(native));
    }
    return result;
}

