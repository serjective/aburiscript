namespace filesystem {

class path {
public:
    using value_type = char;
    using string_type = string;
    static constexpr value_type preferred_separator = '/';

    class iterator {
    public:
        using iterator_category = bidirectional_iterator_tag;
        using value_type = path;
        using difference_type = ptrdiff_t;
        using pointer = void;
        using reference = path;

        iterator() noexcept
            : owner_(nullptr), position_(string::npos) {}

        path operator*() const {
            size_t last = position_;
            while (last < owner_->value_.size() &&
                   owner_->value_[last] != preferred_separator) {
                ++last;
            }
            return path(string_view(
                owner_->value_.data() + position_,
                last - position_));
        }

        iterator& operator++() noexcept {
            if (owner_ == nullptr || position_ == string::npos) {
                return *this;
            }
            size_t next = position_;
            while (next < owner_->value_.size() &&
                   owner_->value_[next] != preferred_separator) {
                ++next;
            }
            while (next < owner_->value_.size() &&
                   owner_->value_[next] == preferred_separator) {
                ++next;
            }
            position_ = next == owner_->value_.size()
                ? string::npos
                : next;
            return *this;
        }

        iterator operator++(int) noexcept {
            iterator result(*this);
            ++*this;
            return result;
        }

        friend bool operator==(
            const iterator& left, const iterator& right) noexcept {
            return left.owner_ == right.owner_ &&
                   left.position_ == right.position_;
        }

    private:
        friend class path;

        const path* owner_;
        size_t position_;

        iterator(const path* owner, size_t position) noexcept
            : owner_(owner), position_(position) {}
    };

    path() = default;
    path(const path&) = default;
    path(path&&) = default;

    path(const char* value) : value_(value) {}
    path(const string& value) : value_(value) {}
    path(string&& value) : value_(std::move(value)) {}
    path(string_view value) : value_(value) {}
    path(const u8string& value)
        : value_(
              reinterpret_cast<const char*>(value.data()),
              value.size()) {}

    path& operator=(const path&) = default;
    path& operator=(path&&) = default;

    path& operator/=(const path& other) {
        if (other.empty()) {
            return *this;
        }
        if (other.is_absolute()) {
            value_ = other.value_;
            return *this;
        }
        if (!value_.empty() && value_.back() != preferred_separator) {
            value_.push_back(preferred_separator);
        }
        value_.append(other.value_);
        return *this;
    }

    _ADINKRA_NODISCARD const string_type& native() const noexcept {
        return value_;
    }

    _ADINKRA_NODISCARD string string() const {
        return value_;
    }

    _ADINKRA_NODISCARD std::u8string u8string() const {
        return std::u8string(
            reinterpret_cast<const char8_t*>(value_.data()),
            value_.size());
    }

    operator string_type() const {
        return value_;
    }

    _ADINKRA_NODISCARD const value_type* c_str() const noexcept {
        return value_.c_str();
    }

    _ADINKRA_NODISCARD bool empty() const noexcept {
        return value_.empty();
    }

    _ADINKRA_NODISCARD bool is_absolute() const noexcept {
        return !value_.empty() &&
               value_.front() == preferred_separator;
    }

    _ADINKRA_NODISCARD path parent_path() const {
        if (value_.empty()) {
            return {};
        }
        size_t end = value_.size();
        while (end > 1 &&
               value_[end - 1] == preferred_separator) {
            --end;
        }
        const size_t separator =
            value_.rfind(preferred_separator, end - 1);
        if (separator == string_type::npos) {
            return {};
        }
        if (separator == 0) {
            return path("/");
        }
        return path(string_view(value_.data(), separator));
    }

    _ADINKRA_NODISCARD path filename() const {
        if (value_.empty() ||
            value_.back() == preferred_separator) {
            return {};
        }
        const size_t separator =
            value_.rfind(preferred_separator);
        const size_t first = separator == string_type::npos
            ? 0
            : separator + 1;
        return path(string_view(
            value_.data() + first, value_.size() - first));
    }

    _ADINKRA_NODISCARD path extension() const {
        const string_type name = filename().value_;
        const size_t dot = name.rfind('.');
        if (dot == string_type::npos || dot == 0) {
            return {};
        }
        return path(string_view(
            name.data() + dot, name.size() - dot));
    }

    _ADINKRA_NODISCARD path stem() const {
        const path name = filename();
        const string_type extension_value = name.extension().value_;
        if (extension_value.empty()) {
            return name;
        }
        return path(string_view(
            name.value_.data(),
            name.value_.size() - extension_value.size()));
    }

    _ADINKRA_NODISCARD path lexically_normal() const {
        const bool absolute = is_absolute();
        vector<string_type> components;
        for (auto current = begin(); current != end(); ++current) {
            string_type component = (*current).string();
            if (component.empty() || component == ".") {
                continue;
            }
            if (component == "..") {
                if (!components.empty() &&
                    components.back() != "..") {
                    components.pop_back();
                } else if (!absolute) {
                    components.push_back(std::move(component));
                }
                continue;
            }
            components.push_back(std::move(component));
        }

        string_type result =
            absolute ? string_type("/") : string_type();
        for (const string_type& component : components) {
            if (!result.empty() &&
                result.back() != preferred_separator) {
                result.push_back(preferred_separator);
            }
            result.append(component);
        }
        if (result.empty() && !value_.empty()) {
            result = ".";
        }
        return path(std::move(result));
    }

    iterator begin() const noexcept {
        size_t first = 0;
        while (first < value_.size() &&
               value_[first] == preferred_separator) {
            ++first;
        }
        return iterator(
            this,
            first == value_.size() ? string_type::npos : first);
    }

    iterator end() const noexcept {
        return iterator(this, string_type::npos);
    }

    friend bool operator==(
        const path& left, const path& right) noexcept {
        return left.value_ == right.value_;
    }

    friend auto operator<=>(
        const path& left, const path& right) noexcept {
        return left.value_ <=> right.value_;
    }

    friend path operator/(path left, const path& right) {
        left /= right;
        return left;
    }

private:
    string_type value_;
};

using file_time_type = chrono::system_clock::time_point;

enum class file_type {
    none,
    not_found,
    regular,
    directory,
    symlink,
    block,
    character,
    fifo,
    socket,
    unknown
};

class file_status {
public:
    constexpr file_status() noexcept : type_(file_type::none) {}
    constexpr explicit file_status(file_type type) noexcept
        : type_(type) {}

    constexpr file_type type() const noexcept {
        return type_;
    }

private:
    file_type type_;
};

enum class copy_options : unsigned {
    none = 0,
    skip_existing = 1u << 0,
    overwrite_existing = 1u << 1,
    recursive = 1u << 2
};

constexpr copy_options operator|(
    copy_options left, copy_options right) noexcept {
    return static_cast<copy_options>(
        static_cast<unsigned>(left) |
        static_cast<unsigned>(right));
}

constexpr copy_options operator&(
    copy_options left, copy_options right) noexcept {
    return static_cast<copy_options>(
        static_cast<unsigned>(left) &
        static_cast<unsigned>(right));
}

inline void __set_filesystem_error(error_code& error, int value) noexcept {
    error.assign(value, generic_category());
}

inline file_type __file_type(mode_t mode) noexcept {
    if (S_ISREG(mode)) {
        return file_type::regular;
    }
    if (S_ISDIR(mode)) {
        return file_type::directory;
    }
    if (S_ISLNK(mode)) {
        return file_type::symlink;
    }
    if (S_ISBLK(mode)) {
        return file_type::block;
    }
    if (S_ISCHR(mode)) {
        return file_type::character;
    }
    if (S_ISFIFO(mode)) {
        return file_type::fifo;
    }
    if (S_ISSOCK(mode)) {
        return file_type::socket;
    }
    return file_type::unknown;
}

_ADINKRA_NODISCARD inline file_status
status(const path& value, error_code& error) noexcept {
    struct stat information {};
    if (::stat(value.c_str(), &information) != 0) {
        const int status_error = errno;
        __set_filesystem_error(error, status_error);
        return file_status(
            status_error == ENOENT
                ? file_type::not_found
                : file_type::none);
    }
    error.clear();
    return file_status(__file_type(information.st_mode));
}

_ADINKRA_NODISCARD inline file_status
status(const path& value) noexcept {
    error_code error;
    return status(value, error);
}

_ADINKRA_NODISCARD inline file_status
symlink_status(const path& value, error_code& error) noexcept {
    struct stat information {};
    if (::lstat(value.c_str(), &information) != 0) {
        const int status_error = errno;
        __set_filesystem_error(error, status_error);
        return file_status(
            status_error == ENOENT
                ? file_type::not_found
                : file_type::none);
    }
    error.clear();
    return file_status(__file_type(information.st_mode));
}

_ADINKRA_NODISCARD inline file_status
symlink_status(const path& value) noexcept {
    error_code error;
    return symlink_status(value, error);
}

_ADINKRA_NODISCARD inline bool
exists(const path& value, error_code& error) noexcept {
    struct stat information {};
    if (::stat(value.c_str(), &information) == 0) {
        error.clear();
        return true;
    }
    __set_filesystem_error(error, errno);
    return false;
}

_ADINKRA_NODISCARD inline bool exists(const path& value) noexcept {
