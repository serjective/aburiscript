_ADINKRA_NODISCARD inline path
absolute(const path& value, error_code& error) {
    if (value.is_absolute()) {
        error.clear();
        return value.lexically_normal();
    }

    char current[PATH_MAX];
    if (::getcwd(current, sizeof(current)) == nullptr) {
        __set_filesystem_error(error, errno);
        return {};
    }
    error.clear();
    return (path(current) / value).lexically_normal();
}

_ADINKRA_NODISCARD inline path absolute(const path& value) {
    error_code error;
    return absolute(value, error);
}

_ADINKRA_NODISCARD inline path
weakly_canonical(const path& value, error_code& error) {
    char resolved[PATH_MAX];
    if (::realpath(value.c_str(), resolved) != nullptr) {
        error.clear();
        return path(resolved);
    }
    path result = absolute(value, error);
    if (!result.empty()) {
        error.clear();
    }
    return result.lexically_normal();
}

_ADINKRA_NODISCARD inline path
weakly_canonical(const path& value) {
    error_code error;
    return weakly_canonical(value, error);
}

inline bool remove(const path& value, error_code& error) noexcept {
    if (::remove(value.c_str()) == 0) {
        error.clear();
        return true;
    }
    if (errno == ENOENT) {
        error.clear();
        return false;
    }
    __set_filesystem_error(error, errno);
    return false;
}

inline bool remove(const path& value) {
    error_code error;
    return remove(value, error);
}

inline uintmax_t remove_all(
    const path& value, error_code& error) noexcept {
    struct stat information {};
    if (::lstat(value.c_str(), &information) != 0) {
        if (errno == ENOENT) {
            error.clear();
            return 0;
        }
        __set_filesystem_error(error, errno);
        return static_cast<uintmax_t>(-1);
    }

    uintmax_t removed = 0;
    if (S_ISDIR(information.st_mode)) {
        directory_iterator entries(value, error);
        if (error) {
            return static_cast<uintmax_t>(-1);
        }
        for (const directory_entry& entry : entries) {
            const uintmax_t child = remove_all(entry.path(), error);
            if (error) {
                return static_cast<uintmax_t>(-1);
            }
            removed += child;
        }
    }

    if (::remove(value.c_str()) != 0) {
        __set_filesystem_error(error, errno);
        return static_cast<uintmax_t>(-1);
    }
    error.clear();
    return removed + 1;
}

inline uintmax_t remove_all(const path& value) {
    error_code error;
    return remove_all(value, error);
}

inline void rename(
    const path& old_value, const path& new_value,
    error_code& error) noexcept {
    if (::rename(old_value.c_str(), new_value.c_str()) != 0) {
        __set_filesystem_error(error, errno);
        return;
    }
    error.clear();
}

inline uintmax_t file_size(
    const path& value, error_code& error) noexcept {
    struct stat information {};
    if (::stat(value.c_str(), &information) != 0) {
        __set_filesystem_error(error, errno);
        return static_cast<uintmax_t>(-1);
    }
    if (!S_ISREG(information.st_mode)) {
        __set_filesystem_error(error, EINVAL);
        return static_cast<uintmax_t>(-1);
    }
    error.clear();
    return static_cast<uintmax_t>(information.st_size);
}

inline uintmax_t file_size(const path& value) noexcept {
    error_code error;
    return file_size(value, error);
}

