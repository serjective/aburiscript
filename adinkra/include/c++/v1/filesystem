class directory_iterator {
    struct state {
        DIR* directory;
        filesystem::path base;

        state(DIR* directory_value, filesystem::path base_value)
            : directory(directory_value),
              base(std::move(base_value)) {}

        ~state() {
            if (directory != nullptr) {
                ::closedir(directory);
            }
        }
    };

public:
    using iterator_category = input_iterator_tag;
    using value_type = directory_entry;
    using difference_type = ptrdiff_t;
    using pointer = const directory_entry*;
    using reference = const directory_entry&;

    directory_iterator() = default;

    explicit directory_iterator(const filesystem::path& value) {
        error_code error;
        initialize(value, error);
    }

    directory_iterator(
        const filesystem::path& value, error_code& error) {
        initialize(value, error);
    }

    reference operator*() const noexcept {
        return current_;
    }

    pointer operator->() const noexcept {
        return std::addressof(current_);
    }

    directory_iterator& operator++() {
        error_code error;
        advance(error);
        return *this;
    }

    directory_iterator& increment(error_code& error) {
        advance(error);
        return *this;
    }

    friend bool operator==(
        const directory_iterator& left,
        const directory_iterator& right) noexcept {
        return left.state_ == right.state_;
    }

    directory_iterator begin() const {
        return *this;
    }

    directory_iterator end() const noexcept {
        return {};
    }

private:
    shared_ptr<state> state_;
    directory_entry current_;

    void initialize(
        const filesystem::path& value, error_code& error) {
        DIR* opened = ::opendir(value.c_str());
        if (opened == nullptr) {
            __set_filesystem_error(error, errno);
            return;
        }
        error.clear();
        state_ = make_shared<state>(opened, value);
        advance(error);
    }

    void advance(error_code& error) {
        if (!state_) {
            error.clear();
            return;
        }
        errno = 0;
        while (dirent* entry = ::readdir(state_->directory)) {
            string_view name(entry->d_name);
            if (name == "." || name == "..") {
                continue;
            }
            current_ = directory_entry(
                state_->base / filesystem::path(name));
            error.clear();
            return;
        }
        const int read_error = errno;
        state_.reset();
        if (read_error == 0) {
            error.clear();
        } else {
            __set_filesystem_error(error, read_error);
        }
    }
};

class recursive_directory_iterator {
    struct state {
        vector<directory_entry> entries;
        size_t position = 0;
    };

public:
    using iterator_category = input_iterator_tag;
    using value_type = directory_entry;
    using difference_type = ptrdiff_t;
    using pointer = const directory_entry*;
    using reference = const directory_entry&;

    recursive_directory_iterator() = default;

    explicit recursive_directory_iterator(
        const filesystem::path& value) {
        error_code error;
        initialize(value, error);
    }

    recursive_directory_iterator(
        const filesystem::path& value, error_code& error) {
        initialize(value, error);
    }

    reference operator*() const noexcept {
        return state_->entries[state_->position];
    }

    pointer operator->() const noexcept {
        return std::addressof(operator*());
    }

    recursive_directory_iterator& operator++() {
        error_code error;
        return increment(error);
    }

    recursive_directory_iterator& increment(error_code& error) {
        if (!state_) {
            error.clear();
            return *this;
        }
        ++state_->position;
        if (state_->position == state_->entries.size()) {
            state_.reset();
        }
        error.clear();
        return *this;
    }

    friend bool operator==(
        const recursive_directory_iterator& left,
        const recursive_directory_iterator& right) noexcept {
        return left.state_ == right.state_;
    }

    recursive_directory_iterator begin() const {
        return *this;
    }

    recursive_directory_iterator end() const noexcept {
        return {};
    }

private:
    shared_ptr<state> state_;

    static bool collect(
        const filesystem::path& value,
        vector<directory_entry>& entries,
        error_code& error) {
        directory_iterator children(value, error);
        if (error) {
            return false;
        }
        for (const directory_entry& child : children) {
            entries.push_back(child);
            error_code status_error;
            const file_status child_status =
                child.symlink_status(status_error);
            if (status_error) {
                error = status_error;
                return false;
            }
            if (child_status.type() == file_type::directory &&
                !collect(child.path(), entries, error)) {
                return false;
            }
        }
        error.clear();
        return true;
    }

    void initialize(
        const filesystem::path& value, error_code& error) {
        auto created = make_shared<state>();
        if (!collect(value, created->entries, error)) {
            return;
        }
        if (created->entries.empty()) {
            error.clear();
            return;
        }
        state_ = std::move(created);
        error.clear();
    }
};

