#ifndef ADINKRA_TYPEINDEX
#define ADINKRA_TYPEINDEX

#include <__adinkra/config>
#include <compare>
#include <cstddef>
#include <functional>
#include <typeinfo>

_ADINKRA_BEGIN_NAMESPACE_STD

class type_index {
public:
    type_index(const type_info& value) noexcept : value_(&value) {}

    bool operator==(const type_index& other) const noexcept {
        return *value_ == *other.value_;
    }

    bool operator<(const type_index& other) const noexcept {
        return value_->before(*other.value_);
    }

    bool operator>(const type_index& other) const noexcept {
        return other < *this;
    }

    bool operator<=(const type_index& other) const noexcept {
        return !(other < *this);
    }

    bool operator>=(const type_index& other) const noexcept {
        return !(*this < other);
    }

    strong_ordering operator<=>(const type_index& other) const noexcept {
        return *this < other ? strong_ordering::less
             : other < *this ? strong_ordering::greater
                             : strong_ordering::equal;
    }

    size_t hash_code() const noexcept {
        return value_->hash_code();
    }

    const char* name() const noexcept {
        return value_->name();
    }

private:
    const type_info* value_;
};

template<>
struct hash<type_index> {
    using argument_type = type_index;
    using result_type = size_t;

    size_t operator()(const type_index& value) const noexcept {
        return value.hash_code();
    }
};

_ADINKRA_END_NAMESPACE_STD

#endif
