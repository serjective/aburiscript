template<class InputIterator, class Predicate>
_ADINKRA_NODISCARD constexpr bool all_of(
    InputIterator first, InputIterator last, Predicate predicate) {
    return std::find_if_not(first, last, predicate) == last;
}

template<class InputIterator, class Predicate>
_ADINKRA_NODISCARD constexpr bool any_of(
    InputIterator first, InputIterator last, Predicate predicate) {
    return std::find_if(first, last, predicate) != last;
}

template<class InputIterator, class Predicate>
_ADINKRA_NODISCARD constexpr bool none_of(
    InputIterator first, InputIterator last, Predicate predicate) {
    return std::find_if(first, last, predicate) == last;
