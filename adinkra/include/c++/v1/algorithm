template<class Type>
_ADINKRA_NODISCARD constexpr pair<const Type&, const Type&>
minmax(const Type& left, const Type& right) {
    return right < left ? pair<const Type&, const Type&>(right, left)
                        : pair<const Type&, const Type&>(left, right);
}

template<class Type, class Compare>
_ADINKRA_NODISCARD constexpr pair<const Type&, const Type&>
minmax(const Type& left, const Type& right, Compare compare) {
    return compare(right, left)
        ? pair<const Type&, const Type&>(right, left)
        : pair<const Type&, const Type&>(left, right);
}

template<class Type>
_ADINKRA_NODISCARD constexpr pair<Type, Type>
minmax(initializer_list<Type> values) {
    auto minimum = values.begin();
    auto maximum = values.begin();
    for (auto current = values.begin() + 1;
         current != values.end(); ++current) {
        if (*current < *minimum) {
            minimum = current;
        }
        if (!(*current < *maximum)) {
            maximum = current;
        }
    }
    return {*minimum, *maximum};
}

template<class Type, class Compare>
_ADINKRA_NODISCARD constexpr pair<Type, Type>
minmax(initializer_list<Type> values, Compare compare) {
    auto minimum = values.begin();
    auto maximum = values.begin();
    for (auto current = values.begin() + 1;
         current != values.end(); ++current) {
        if (compare(*current, *minimum)) {
            minimum = current;
        }
        if (!compare(*current, *maximum)) {
            maximum = current;
        }
    }
    return {*minimum, *maximum};
}

template<class Type>
_ADINKRA_NODISCARD constexpr const Type&
clamp(const Type& value, const Type& low, const Type& high) {
    return value < low ? low : high < value ? high : value;
}

template<class Type, class Compare>
_ADINKRA_NODISCARD constexpr const Type&
clamp(const Type& value, const Type& low, const Type& high, Compare compare) {
    return compare(value, low) ? low
         : compare(high, value) ? high
                                : value;
}

template<class InputIterator, class OutputIterator>
constexpr OutputIterator copy(
    InputIterator first, InputIterator last, OutputIterator output) {
    while (first != last) {
        *output = *first;
        ++first;
        ++output;
    }
    return output;
}

template<class BidirectionalIterator, class OutputIterator>
constexpr OutputIterator reverse_copy(
    BidirectionalIterator first, BidirectionalIterator last,
    OutputIterator output) {
    while (first != last) {
        *output++ = *--last;
    }
    return output;
}

template<class InputIterator, class Size, class OutputIterator>
constexpr OutputIterator copy_n(
    InputIterator first, Size count, OutputIterator output) {
    while (count-- > 0) {
        *output++ = *first++;
    }
    return output;
}

template<class BidirectionalIterator, class OutputIterator>
constexpr OutputIterator copy_backward(
    BidirectionalIterator first, BidirectionalIterator last,
    OutputIterator output_last) {
    while (first != last) {
        *--output_last = *--last;
    }
    return output_last;
}

template<class InputIterator, class OutputIterator>
constexpr OutputIterator move(
    InputIterator first, InputIterator last, OutputIterator output) {
    while (first != last) {
        *output = std::move(*first);
        ++first;
        ++output;
    }
    return output;
}

template<class BidirectionalIterator, class OutputIterator>
constexpr OutputIterator move_backward(
    BidirectionalIterator first, BidirectionalIterator last,
    OutputIterator output_last) {
    while (first != last) {
        *--output_last = std::move(*--last);
    }
    return output_last;
}

template<class FirstIterator, class SecondIterator>
constexpr void iter_swap(FirstIterator first, SecondIterator second) {
    using std::swap;
    if constexpr (requires { swap(*first, *second); }) {
        swap(*first, *second);
    } else {
        using Value =
            typename iterator_traits<FirstIterator>::value_type;
        Value temporary = std::move(*first);
        *first = std::move(*second);
        *second = std::move(temporary);
    }
}

template<class ForwardIterator, class Type>
constexpr void fill(ForwardIterator first, ForwardIterator last,
                    const Type& value) {
    while (first != last) {
        *first++ = value;
    }
}

template<class OutputIterator, class Size, class Type>
constexpr OutputIterator fill_n(
    OutputIterator first, Size count, const Type& value) {
    auto remaining = +count;
    while (remaining > 0) {
        *first++ = value;
        --remaining;
    }
    return first;
}

template<class ForwardIterator, class Generator>
constexpr void generate(
    ForwardIterator first, ForwardIterator last,
    Generator generator) {
    while (first != last) {
        *first++ = generator();
    }
}

template<class OutputIterator, class Size, class Generator>
constexpr OutputIterator generate_n(
    OutputIterator first, Size count, Generator generator) {
    auto remaining = +count;
    while (remaining > 0) {
        *first++ = generator();
        --remaining;
    }
    return first;
}

template<class InputIterator, class Function>
constexpr Function for_each(
    InputIterator first, InputIterator last, Function function) {
    while (first != last) {
        function(*first++);
    }
    return function;
}

template<class ForwardIterator, class Type>
constexpr void replace(
    ForwardIterator first, ForwardIterator last,
    const Type& old_value, const Type& new_value) {
    while (first != last) {
        if (*first == old_value) {
            *first = new_value;
        }
        ++first;
    }
}

template<class ForwardIterator, class Predicate, class Type>
constexpr void replace_if(
    ForwardIterator first, ForwardIterator last,
    Predicate predicate, const Type& new_value) {
    while (first != last) {
        if (predicate(*first)) {
            *first = new_value;
        }
        ++first;
    }
}

template<class InputIterator, class OutputIterator, class Type>
constexpr OutputIterator replace_copy(
    InputIterator first, InputIterator last, OutputIterator output,
    const Type& old_value, const Type& new_value) {
    while (first != last) {
        *output++ = *first == old_value ? new_value : *first;
        ++first;
    }
    return output;
}

template<class InputIterator, class OutputIterator, class Predicate,
         class Type>
constexpr OutputIterator replace_copy_if(
    InputIterator first, InputIterator last, OutputIterator output,
    Predicate predicate, const Type& new_value) {
    while (first != last) {
        *output++ = predicate(*first) ? new_value : *first;
        ++first;
    }
    return output;
}

template<class InputIterator, class OutputIterator, class UnaryOperation>
constexpr OutputIterator transform(
    InputIterator first, InputIterator last, OutputIterator output,
    UnaryOperation operation) {
    while (first != last) {
        *output++ = operation(*first++);
    }
    return output;
}

template<class FirstIterator, class SecondIterator, class OutputIterator,
         class BinaryOperation>
constexpr OutputIterator transform(
    FirstIterator first, FirstIterator last, SecondIterator second,
    OutputIterator output, BinaryOperation operation) {
    while (first != last) {
        *output++ = operation(*first++, *second++);
    }
    return output;
}

template<class InputIterator, class Type>
_ADINKRA_NODISCARD constexpr InputIterator find(
    InputIterator first, InputIterator last, const Type& value) {
    while (first != last && !(*first == value)) {
        ++first;
    }
    return first;
}

template<class FirstIterator, class SecondIterator>
_ADINKRA_NODISCARD constexpr FirstIterator find_first_of(
    FirstIterator first, FirstIterator last,
    SecondIterator search_first, SecondIterator search_last) {
    for (; first != last; ++first) {
        for (SecondIterator current = search_first;
             current != search_last; ++current) {
            if (*first == *current) {
                return first;
            }
        }
    }
    return last;
}

template<class FirstIterator, class SecondIterator, class Predicate>
_ADINKRA_NODISCARD constexpr FirstIterator find_first_of(
    FirstIterator first, FirstIterator last,
    SecondIterator search_first, SecondIterator search_last,
    Predicate predicate) {
    for (; first != last; ++first) {
        for (SecondIterator current = search_first;
             current != search_last; ++current) {
            if (predicate(*first, *current)) {
                return first;
            }
        }
    }
    return last;
}

template<class InputIterator, class Predicate>
_ADINKRA_NODISCARD constexpr InputIterator find_if(
    InputIterator first, InputIterator last, Predicate predicate) {
    while (first != last && !predicate(*first)) {
        ++first;
    }
    return first;
}

template<class InputIterator, class Predicate>
_ADINKRA_NODISCARD constexpr InputIterator find_if_not(
