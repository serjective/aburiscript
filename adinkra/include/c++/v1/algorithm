template<class RandomAccessIterator, class Compare>
constexpr void make_heap(
    RandomAccessIterator first, RandomAccessIterator last, Compare compare) {
    using Difference =
        typename iterator_traits<RandomAccessIterator>::difference_type;
    const Difference count_value = last - first;
    if (count_value < 2) {
        return;
    }

    auto sift_down = [&](Difference root, Difference count) {
        for (;;) {
            const Difference left = root * 2 + 1;
            if (left >= count) {
                return;
            }
            Difference selected = left;
            const Difference right = left + 1;
            if (right < count &&
                compare(*(first + selected), *(first + right))) {
                selected = right;
            }
            if (!compare(*(first + root), *(first + selected))) {
                return;
            }
            std::iter_swap(first + root, first + selected);
            root = selected;
        }
    };

    for (Difference start = count_value / 2; start > 0; --start) {
        sift_down(start - 1, count_value);
    }
}

