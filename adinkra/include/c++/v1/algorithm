template<class Type>
struct less;

template<class Type>
_ADINKRA_NODISCARD constexpr const Type&
min(const Type& left, const Type& right) {
    return right < left ? right : left;
}

template<class Type, class Compare>
_ADINKRA_NODISCARD constexpr const Type&
min(const Type& left, const Type& right, Compare compare) {
    return compare(right, left) ? right : left;
}

template<class Type>
_ADINKRA_NODISCARD constexpr const Type&
max(const Type& left, const Type& right) {
    return left < right ? right : left;
}

template<class Type, class Compare>
_ADINKRA_NODISCARD constexpr const Type&
max(const Type& left, const Type& right, Compare compare) {
    return compare(left, right) ? right : left;
}

template<class Type>
_ADINKRA_NODISCARD constexpr Type
min(initializer_list<Type> values) {
    auto best = values.begin();
    for (auto current = best + 1; current != values.end(); ++current) {
        if (*current < *best) {
            best = current;
        }
    }
    return *best;
}

template<class Type, class Compare>
_ADINKRA_NODISCARD constexpr Type
min(initializer_list<Type> values, Compare compare) {
    auto best = values.begin();
    for (auto current = best + 1; current != values.end(); ++current) {
        if (compare(*current, *best)) {
            best = current;
        }
    }
    return *best;
}

