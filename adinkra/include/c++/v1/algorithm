template<class FirstIterator, class SecondIterator,
         class OutputIterator, class Compare>
constexpr OutputIterator set_difference(
    FirstIterator first, FirstIterator last,
    SecondIterator second, SecondIterator second_last,
    OutputIterator output, Compare compare) {
    while (first != last && second != second_last) {
        if (compare(*first, *second)) {
            *output++ = *first++;
        } else if (compare(*second, *first)) {
            ++second;
        } else {
            ++first;
            ++second;
        }
    }
    return std::copy(first, last, output);
}

template<class FirstIterator, class SecondIterator, class Compare>
constexpr bool includes(
    FirstIterator first, FirstIterator last,
    SecondIterator second, SecondIterator second_last,
    Compare compare) {
    while (second != second_last) {
        if (first == last || compare(*second, *first)) {
            return false;
        }
        if (!compare(*first, *second)) {
            ++second;
        }
        ++first;
    }
    return true;
}

