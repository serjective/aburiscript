template<class FirstIterator, class SecondIterator>
_ADINKRA_NODISCARD constexpr bool equal(
    FirstIterator first, FirstIterator last, SecondIterator second) {
    while (first != last) {
        if (!(*first == *second)) {
            return false;
        }
        ++first;
        ++second;
    }
    return true;
}

template<class FirstIterator, class SecondIterator, class Predicate>
_ADINKRA_NODISCARD constexpr bool equal(
    FirstIterator first, FirstIterator last, SecondIterator second,
    Predicate predicate) {
    while (first != last) {
        if (!predicate(*first, *second)) {
            return false;
        }
        ++first;
        ++second;
    }
    return true;
}

template<class FirstIterator, class SecondIterator>
_ADINKRA_NODISCARD constexpr bool equal(
    FirstIterator first, FirstIterator last,
    SecondIterator second, SecondIterator second_last) {
    while (first != last && second != second_last) {
        if (!(*first == *second)) {
            return false;
        }
        ++first;
        ++second;
    }
    return first == last && second == second_last;
}

template<class FirstIterator, class SecondIterator, class Predicate>
_ADINKRA_NODISCARD constexpr bool equal(
    FirstIterator first, FirstIterator last,
    SecondIterator second, SecondIterator second_last,
    Predicate predicate) {
    while (first != last && second != second_last) {
        if (!predicate(*first, *second)) {
            return false;
        }
        ++first;
        ++second;
    }
    return first == last && second == second_last;
}

template<class ForwardIterator, class SecondIterator, class Predicate>
_ADINKRA_NODISCARD constexpr bool is_permutation(
    ForwardIterator first, ForwardIterator last,
    SecondIterator second, Predicate predicate) {
    for (; first != last; ++first, ++second) {
        if (!predicate(*first, *second)) {
            break;
        }
    }

    for (ForwardIterator current = first;
         current != last; ++current) {
        bool already_counted = false;
        for (ForwardIterator previous = first;
             previous != current; ++previous) {
            if (predicate(*previous, *current)) {
                already_counted = true;
                break;
            }
        }
        if (already_counted) {
            continue;
        }

        size_t left_count = 0;
        size_t right_count = 0;
        SecondIterator right = second;
        for (ForwardIterator probe = first;
             probe != last; ++probe, ++right) {
            if (predicate(*probe, *current)) {
                ++left_count;
            }
            if (predicate(*right, *current)) {
                ++right_count;
            }
        }
        if (left_count != right_count) {
            return false;
        }
    }
    return true;
}

template<class ForwardIterator, class SecondIterator>
_ADINKRA_NODISCARD constexpr bool is_permutation(
    ForwardIterator first, ForwardIterator last,
    SecondIterator second) {
    return std::is_permutation(
        first, last, second,
        [](const auto& left, const auto& right) {
            return left == right;
        });
}

template<class ForwardIterator, class SecondIterator, class Predicate>
_ADINKRA_NODISCARD constexpr bool is_permutation(
    ForwardIterator first, ForwardIterator last,
    SecondIterator second, SecondIterator second_last,
    Predicate predicate) {
    if (std::distance(first, last) !=
        std::distance(second, second_last)) {
        return false;
    }
    return std::is_permutation(
        first, last, second, predicate);
}

template<class ForwardIterator, class SecondIterator>
_ADINKRA_NODISCARD constexpr bool is_permutation(
    ForwardIterator first, ForwardIterator last,
    SecondIterator second, SecondIterator second_last) {
    return std::is_permutation(
        first, last, second, second_last,
        [](const auto& left, const auto& right) {
            return left == right;
        });
}

template<class FirstIterator, class SecondIterator>
_ADINKRA_NODISCARD constexpr bool lexicographical_compare(
    FirstIterator first, FirstIterator last,
    SecondIterator second, SecondIterator second_last) {
    while (first != last && second != second_last) {
        if (*first < *second) {
            return true;
        }
        if (*second < *first) {
            return false;
        }
        ++first;
        ++second;
    }
    return first == last && second != second_last;
}

template<class FirstIterator, class SecondIterator, class Compare>
_ADINKRA_NODISCARD constexpr bool lexicographical_compare(
    FirstIterator first, FirstIterator last,
    SecondIterator second, SecondIterator second_last, Compare compare) {
    while (first != last && second != second_last) {
        if (compare(*first, *second)) {
            return true;
        }
        if (compare(*second, *first)) {
            return false;
        }
        ++first;
        ++second;
    }
    return first == last && second != second_last;
}

template<class ForwardIterator, class Type>
constexpr ForwardIterator remove(
    ForwardIterator first, ForwardIterator last, const Type& value) {
    first = std::find(first, last, value);
    if (first == last) {
        return first;
    }
    for (ForwardIterator iterator = std::next(first);
         iterator != last; ++iterator) {
        if (!(*iterator == value)) {
            *first++ = std::move(*iterator);
        }
    }
    return first;
}

template<class ForwardIterator, class Predicate>
constexpr ForwardIterator remove_if(
    ForwardIterator first, ForwardIterator last, Predicate predicate) {
    first = std::find_if(first, last, predicate);
    if (first == last) {
        return first;
    }
    for (ForwardIterator iterator = std::next(first);
         iterator != last; ++iterator) {
        if (!predicate(*iterator)) {
            *first++ = std::move(*iterator);
        }
    }
    return first;
}

template<class InputIterator, class OutputIterator, class Type>
constexpr OutputIterator remove_copy(
    InputIterator first, InputIterator last,
    OutputIterator output, const Type& value) {
    while (first != last) {
        if (!(*first == value)) {
            *output++ = *first;
        }
        ++first;
    }
    return output;
}

