    std::make_heap(first, middle, compare);
    for (RandomAccessIterator current = middle; current != last; ++current) {
        if (compare(*current, *first)) {
            std::iter_swap(current, first);

            using Difference =
                typename iterator_traits<RandomAccessIterator>::difference_type;
            const Difference count_value = middle - first;
            Difference root = 0;
            for (;;) {
                const Difference left = root * 2 + 1;
                if (left >= count_value) {
