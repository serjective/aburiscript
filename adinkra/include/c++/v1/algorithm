template<class RandomAccessIterator, class UniformRandomGenerator>
void shuffle(
    RandomAccessIterator first,
    RandomAccessIterator last,
    UniformRandomGenerator&& generator) {
    using Difference =
        typename iterator_traits<RandomAccessIterator>::difference_type;
    const Difference count_value = last - first;
    for (Difference current = count_value; current > 1; --current) {
        const auto random_value =
            generator() - remove_reference_t<
                              UniformRandomGenerator>::min();
        const Difference selected = static_cast<Difference>(
            random_value % static_cast<decltype(random_value)>(current));
        std::iter_swap(first + current - 1, first + selected);
    }
}

template<class PopulationIterator, class SampleIterator,
         class Distance, class UniformRandomGenerator>
SampleIterator sample(
    PopulationIterator first, PopulationIterator last,
    SampleIterator output, Distance count_value,
    UniformRandomGenerator&& generator) {
    if (count_value <= 0) {
        return output;
    }

    using Generator =
        remove_reference_t<UniformRandomGenerator>;
    using Category =
        typename iterator_traits<PopulationIterator>::iterator_category;

    if constexpr (is_base_of_v<forward_iterator_tag, Category>) {
        Distance remaining =
            static_cast<Distance>(std::distance(first, last));
        Distance needed =
            count_value < remaining ? count_value : remaining;
        while (needed > 0) {
            const auto random_value =
                generator() - Generator::min();
            const Distance selected =
                static_cast<Distance>(
                    random_value %
                    static_cast<decltype(random_value)>(remaining));
            if (selected < needed) {
                *output++ = *first;
                --needed;
            }
            --remaining;
            ++first;
        }
    } else {
        SampleIterator output_first = output;
        Distance selected = 0;
        while (first != last && selected < count_value) {
            *output++ = *first++;
            ++selected;
        }

        Distance visited = selected;
        while (first != last) {
            ++visited;
            const auto random_value =
                generator() - Generator::min();
            const Distance replacement =
                static_cast<Distance>(
                    random_value %
                    static_cast<decltype(random_value)>(visited));
            if (replacement < selected) {
                *(output_first + replacement) = *first;
            }
            ++first;
        }
    }
    return output;
}

