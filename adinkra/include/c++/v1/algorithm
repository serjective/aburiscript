template<class ForwardIterator, class BinaryPredicate>
constexpr ForwardIterator unique(
    ForwardIterator first, ForwardIterator last,
    BinaryPredicate equivalent) {
    if (first == last) {
        return last;
    }
    ForwardIterator result = first;
    while (++first != last) {
        if (!equivalent(*result, *first)) {
            ++result;
            if (result != first) {
                *result = std::move(*first);
            }
        }
    }
    return ++result;
}

template<class ForwardIterator>
constexpr ForwardIterator unique(
    ForwardIterator first, ForwardIterator last) {
    return std::unique(
        first, last,
        [](const auto& left, const auto& right) {
            return left == right;
        });
}

template<class InputIterator, class OutputIterator,
         class BinaryPredicate>
constexpr OutputIterator unique_copy(
    InputIterator first, InputIterator last, OutputIterator output,
    BinaryPredicate equivalent) {
    if (first == last) {
        return output;
    }

    using Value =
        typename iterator_traits<InputIterator>::value_type;
    Value previous = *first;
    *output = previous;
    ++output;
    while (++first != last) {
        if (!equivalent(previous, *first)) {
            previous = *first;
            *output = previous;
            ++output;
        }
    }
    return output;
}

template<class InputIterator, class OutputIterator>
constexpr OutputIterator unique_copy(
    InputIterator first, InputIterator last, OutputIterator output) {
    return std::unique_copy(
        first, last, output,
        [](const auto& left, const auto& right) {
            return left == right;
        });
}

template<class BidirectionalIterator>
constexpr void reverse(BidirectionalIterator first, BidirectionalIterator last) {
    while (first != last && first != --last) {
        std::iter_swap(first++, last);
    }
}

template<class BidirectionalIterator, class Compare>
constexpr bool next_permutation(
    BidirectionalIterator first, BidirectionalIterator last,
    Compare compare) {
    if (first == last) {
        return false;
    }

    BidirectionalIterator current = last;
    if (first == --current) {
        return false;
    }

    for (;;) {
        BidirectionalIterator previous = current;
        if (compare(*--current, *previous)) {
            BidirectionalIterator replacement = last;
            while (!compare(*current, *--replacement)) {}
            std::iter_swap(current, replacement);
            std::reverse(previous, last);
            return true;
        }
        if (current == first) {
            std::reverse(first, last);
            return false;
        }
    }
}

template<class BidirectionalIterator>
constexpr bool next_permutation(
    BidirectionalIterator first, BidirectionalIterator last) {
    return std::next_permutation(
        first, last,
        [](const auto& left, const auto& right) {
            return left < right;
        });
}

template<class BidirectionalIterator, class Compare>
constexpr bool prev_permutation(
    BidirectionalIterator first, BidirectionalIterator last,
    Compare compare) {
    if (first == last) {
        return false;
    }

    BidirectionalIterator current = last;
    if (first == --current) {
        return false;
    }

    for (;;) {
        BidirectionalIterator following = current;
        if (compare(*following, *--current)) {
            BidirectionalIterator replacement = last;
            while (!compare(*--replacement, *current)) {}
            std::iter_swap(current, replacement);
            std::reverse(following, last);
            return true;
        }
        if (current == first) {
            std::reverse(first, last);
            return false;
        }
    }
}

template<class BidirectionalIterator>
constexpr bool prev_permutation(
    BidirectionalIterator first, BidirectionalIterator last) {
    return std::prev_permutation(
        first, last,
        [](const auto& left, const auto& right) {
            return left < right;
        });
}

template<class ForwardIterator>
constexpr ForwardIterator rotate(
    ForwardIterator first, ForwardIterator middle, ForwardIterator last) {
    if (first == middle) {
        return last;
    }
    if (middle == last) {
        return first;
    }

    ForwardIterator write = first;
    ForwardIterator read = middle;
    ForwardIterator result = first;
    while (read != last) {
        std::iter_swap(write++, read++);
        if (write == middle) {
            middle = read;
        } else if (read == last) {
            read = middle;
        }
    }
    result = write;
    return result;
}

template<class ForwardIterator, class OutputIterator>
constexpr OutputIterator rotate_copy(
    ForwardIterator first, ForwardIterator middle,
    ForwardIterator last, OutputIterator output) {
    output = std::copy(middle, last, output);
    return std::copy(first, middle, output);
}

template<class ForwardIterator, class Predicate>
_ADINKRA_NODISCARD constexpr bool is_partitioned(
    ForwardIterator first, ForwardIterator last, Predicate predicate) {
    while (first != last && predicate(*first)) {
        ++first;
    }
    while (first != last) {
        if (predicate(*first)) {
            return false;
        }
        ++first;
    }
    return true;
}

template<class ForwardIterator, class Predicate>
_ADINKRA_NODISCARD constexpr ForwardIterator partition_point(
    ForwardIterator first, ForwardIterator last, Predicate predicate) {
    auto count_value = std::distance(first, last);
    while (count_value > 0) {
        auto step = count_value / 2;
        ForwardIterator middle = first;
        std::advance(middle, step);
        if (predicate(*middle)) {
            first = ++middle;
            count_value -= step + 1;
        } else {
            count_value = step;
        }
    }
    return first;
}

template<class ForwardIterator, class Type>
_ADINKRA_NODISCARD constexpr ForwardIterator lower_bound(
    ForwardIterator first, ForwardIterator last, const Type& value) {
    auto count_value = std::distance(first, last);
    while (count_value > 0) {
        auto step = count_value / 2;
        ForwardIterator middle = first;
        std::advance(middle, step);
        if (*middle < value) {
            first = ++middle;
            count_value -= step + 1;
        } else {
            count_value = step;
        }
    }
    return first;
}

template<class ForwardIterator, class Type, class Compare>
_ADINKRA_NODISCARD constexpr ForwardIterator lower_bound(
    ForwardIterator first, ForwardIterator last, const Type& value,
    Compare compare) {
    auto count_value = std::distance(first, last);
    while (count_value > 0) {
        auto step = count_value / 2;
        ForwardIterator middle = first;
        std::advance(middle, step);
        if (compare(*middle, value)) {
            first = ++middle;
            count_value -= step + 1;
        } else {
            count_value = step;
        }
    }
    return first;
}

template<class ForwardIterator, class Type>
_ADINKRA_NODISCARD constexpr ForwardIterator upper_bound(
    ForwardIterator first, ForwardIterator last, const Type& value) {
    auto count_value = std::distance(first, last);
    while (count_value > 0) {
        auto step = count_value / 2;
        ForwardIterator middle = first;
        std::advance(middle, step);
        if (!(value < *middle)) {
            first = ++middle;
            count_value -= step + 1;
        } else {
            count_value = step;
        }
    }
