    if (count_value <= 32) {
        for (RandomAccessIterator current = first + 1;
             current != last; ++current) {
            Value value = std::move(*current);
            RandomAccessIterator position = current;
            while (position != first) {
                RandomAccessIterator previous = position - 1;
                if (!compare(value, *previous)) {
