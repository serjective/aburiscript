template<class Type>
class shared_ptr {
public:
    using element_type = Type;

    constexpr shared_ptr() noexcept : pointer_(nullptr), control_(nullptr) {}
    constexpr shared_ptr(nullptr_t) noexcept : shared_ptr() {}

    template<class Other>
        requires is_convertible_v<Other*, Type*>
    explicit shared_ptr(Other* pointer)
        : pointer_(pointer),
          control_(pointer == nullptr
              ? nullptr
              : new __memory_detail::pointer_control<
                    Other, default_delete<Other>>(
                    pointer, default_delete<Other>{})) {
        initialize_enable_shared(pointer);
    }

    template<class Other, class Deleter>
        requires is_convertible_v<Other*, Type*>
    shared_ptr(Other* pointer, Deleter deleter)
        : pointer_(pointer),
          control_(new __memory_detail::pointer_control<Other, Deleter>(
              pointer, std::move(deleter))) {
        initialize_enable_shared(pointer);
    }

    shared_ptr(const shared_ptr& other) noexcept
        : pointer_(other.pointer_), control_(other.control_) {
        add_reference();
    }

    template<class Other>
        requires is_convertible_v<Other*, Type*>
    shared_ptr(const shared_ptr<Other>& other) noexcept
        : pointer_(other.pointer_), control_(other.control_) {
        add_reference();
    }

    shared_ptr(shared_ptr&& other) noexcept
        : pointer_(std::exchange(other.pointer_, nullptr)),
          control_(std::exchange(other.control_, nullptr)) {}

    template<class Other>
        requires is_convertible_v<Other*, Type*>
    shared_ptr(shared_ptr<Other>&& other) noexcept
        : pointer_(std::exchange(other.pointer_, nullptr)),
          control_(std::exchange(other.control_, nullptr)) {}

    template<class Other, class Deleter>
        requires is_convertible_v<Other*, Type*>
    shared_ptr(unique_ptr<Other, Deleter>&& other)
        : pointer_(other.get()),
          control_(pointer_ == nullptr
              ? nullptr
              : new __memory_detail::pointer_control<
                    Other, remove_reference_t<Deleter>>(
                    other.get(),
                    std::forward<Deleter>(other.get_deleter()))) {
        other.release();
        initialize_enable_shared(pointer_);
    }

    template<class Other>
    shared_ptr(const shared_ptr<Other>& owner, Type* pointer) noexcept
        : pointer_(pointer), control_(owner.control_) {
        add_reference();
    }

    explicit shared_ptr(const weak_ptr<Type>& weak)
        : pointer_(weak.pointer_), control_(weak.control_) {
        if (control_ == nullptr || !control_->try_add_strong()) {
            pointer_ = nullptr;
            control_ = nullptr;
            throw bad_weak_ptr();
        }
    }

    ~shared_ptr() {
        if (control_ != nullptr) {
            control_->release_strong();
        }
    }

    shared_ptr& operator=(const shared_ptr& other) noexcept {
        shared_ptr replacement(other);
        swap(replacement);
        return *this;
    }

    shared_ptr& operator=(shared_ptr&& other) noexcept {
        shared_ptr replacement(std::move(other));
        swap(replacement);
        return *this;
    }

    template<class Other>
        requires is_convertible_v<Other*, Type*>
    shared_ptr& operator=(const shared_ptr<Other>& other) noexcept {
        shared_ptr replacement(other);
        swap(replacement);
        return *this;
    }

    template<class Other>
        requires is_convertible_v<Other*, Type*>
    shared_ptr& operator=(shared_ptr<Other>&& other) noexcept {
        shared_ptr replacement(std::move(other));
        swap(replacement);
        return *this;
    }

    void reset() noexcept {
        shared_ptr().swap(*this);
    }

    template<class Other>
    void reset(Other* pointer) {
        shared_ptr(pointer).swap(*this);
    }

    template<class Other, class Deleter>
    void reset(Other* pointer, Deleter deleter) {
        shared_ptr(pointer, std::move(deleter)).swap(*this);
    }

    void swap(shared_ptr& other) noexcept {
        std::swap(pointer_, other.pointer_);
        std::swap(control_, other.control_);
    }

    Type* get() const noexcept { return pointer_; }

    template<class Value = Type>
        requires (!is_void_v<Value>)
    Value& operator*() const noexcept {
        return *pointer_;
    }

    Type* operator->() const noexcept { return pointer_; }
    explicit operator bool() const noexcept { return pointer_ != nullptr; }

    long use_count() const noexcept {
        return control_ == nullptr ? 0 : control_->use_count();
    }

    bool unique() const noexcept {
        return use_count() == 1;
    }

    template<class Other>
    bool owner_before(const shared_ptr<Other>& other) const noexcept {
        return reinterpret_cast<uintptr_t>(control_) <
               reinterpret_cast<uintptr_t>(other.control_);
    }

    template<class Other>
    bool owner_before(const weak_ptr<Other>& other) const noexcept {
        return reinterpret_cast<uintptr_t>(control_) <
               reinterpret_cast<uintptr_t>(other.control_);
    }

private:
    template<class>
    friend class shared_ptr;
    template<class>
    friend class weak_ptr;
    template<class>
    friend class enable_shared_from_this;
    template<class Other, class... Arguments>
    friend shared_ptr<Other> make_shared(Arguments&&...);
    template<class Deleter, class Other>
    friend Deleter* get_deleter(
        const shared_ptr<Other>&) noexcept;

    shared_ptr(Type* pointer, __memory_detail::shared_control* control) noexcept
        : pointer_(pointer), control_(control) {}

    void add_reference() noexcept {
        if (control_ != nullptr) {
            control_->add_strong();
        }
    }

    template<class Other>
    void initialize_enable_shared(Other* pointer) noexcept {
        if constexpr (requires {
                          __adinkra_enable_shared_base(pointer);
                      }) {
            auto* base = __adinkra_enable_shared_base(pointer);
            using Enabled =
                typename remove_pointer_t<decltype(base)>::__element_type;
            if (base != nullptr && base->weak_this_.expired()) {
                shared_ptr<Enabled> owner(
                    *this, static_cast<Enabled*>(pointer));
                base->weak_this_ = weak_ptr<Enabled>(owner);
            }
        }
    }

    Type* pointer_;
    __memory_detail::shared_control* control_;
};

