    using pointer = Pointer;
    using element_type =
        typename __pointer_element<Pointer>::type;
    using difference_type =
        typename __pointer_difference<Pointer>::type;

    template<class Other>
    using rebind =
        typename __pointer_rebind<Pointer, Other>::type;

    template<class Element = element_type>
        requires (!is_void_v<Element>)
    static pointer pointer_to(Element& value) {
        return Pointer::pointer_to(value);
    }
};

