inline void* align(
    size_t alignment, size_t size, void*& pointer, size_t& space) noexcept {
    if (alignment == 0 ||
        (alignment & (alignment - 1)) != 0 ||
        pointer == nullptr) {
        return nullptr;
    }
    const uintptr_t address =
        reinterpret_cast<uintptr_t>(pointer);
    const uintptr_t aligned =
        (address + alignment - 1) & ~(alignment - 1);
    const size_t padding =
        static_cast<size_t>(aligned - address);
    if (padding > space || size > space - padding) {
        return nullptr;
    }
    pointer = reinterpret_cast<void*>(aligned);
    space -= padding;
    return pointer;
}

template<class Pointer>
