        weak_ptr().swap(*this);
    }

    void swap(weak_ptr& other) noexcept {
        std::swap(pointer_, other.pointer_);
        std::swap(control_, other.control_);
    }

    long use_count() const noexcept {
        return control_ == nullptr ? 0 : control_->use_count();
    }

    bool expired() const noexcept {
        return use_count() == 0;
