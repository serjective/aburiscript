        return reinterpret_cast<uintptr_t>(control_) <
               reinterpret_cast<uintptr_t>(other.control_);
    }

private:
    template<class>
    friend class weak_ptr;
    template<class>
    friend class shared_ptr;

    void add_reference() noexcept {
        if (control_ != nullptr) {
            control_->add_weak();
        }
