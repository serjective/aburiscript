template<class Type>
bool atomic_compare_exchange_strong_explicit(
    shared_ptr<Type>* pointer,
    shared_ptr<Type>* expected,
    shared_ptr<Type> desired,
    memory_order,
    memory_order) noexcept {
    __adinkra_shared_ptr_atomic_lock();
    const bool equal =
        std::__shared_ptr_atomic_equivalent(*pointer, *expected);
    if (equal) {
        pointer->swap(desired);
    } else {
        *expected = *pointer;
