template<class Type>
struct default_delete {
    constexpr default_delete() noexcept = default;

    template<class Other>
        requires is_convertible_v<Other*, Type*>
    constexpr default_delete(const default_delete<Other>&) noexcept {}

    constexpr void operator()(Type* pointer) const {
        static_assert(sizeof(Type) > 0);
        delete pointer;
    }
};

template<class Type>
struct default_delete<Type[]> {
    constexpr default_delete() noexcept = default;

    template<class Other>
        requires is_convertible_v<Other(*)[], Type(*)[]>
    constexpr default_delete(const default_delete<Other[]>&) noexcept {}

    template<class Other>
    constexpr void operator()(Other* pointer) const {
        static_assert(sizeof(Other) > 0);
        delete[] pointer;
    }
};

template<class Type, class Deleter = default_delete<Type>>
class unique_ptr {
public:
    using pointer = Type*;
    using element_type = Type;
    using deleter_type = Deleter;

    constexpr unique_ptr() noexcept : pointer_(nullptr), deleter_() {}
    constexpr unique_ptr(nullptr_t) noexcept : unique_ptr() {}
    explicit unique_ptr(pointer value) noexcept
        : pointer_(value), deleter_() {}
    unique_ptr(pointer value, const Deleter& deleter) noexcept
        : pointer_(value), deleter_(deleter) {}
    unique_ptr(pointer value, Deleter&& deleter) noexcept
        : pointer_(value), deleter_(std::move(deleter)) {}

    unique_ptr(unique_ptr&& other) noexcept
        : pointer_(other.release()), deleter_(std::move(other.deleter_)) {}

    template<class Other, class OtherDeleter>
        requires is_convertible_v<Other*, Type*> &&
                 is_constructible_v<Deleter, OtherDeleter&&>
    unique_ptr(unique_ptr<Other, OtherDeleter>&& other) noexcept
        : pointer_(other.release()),
          deleter_(std::forward<OtherDeleter>(other.get_deleter())) {}

    unique_ptr(const unique_ptr&) = delete;

    ~unique_ptr() {
        if (pointer_ != nullptr) {
            deleter_(pointer_);
        }
    }

    unique_ptr& operator=(unique_ptr&& other) noexcept {
        reset(other.release());
        deleter_ = std::move(other.deleter_);
        return *this;
    }

    template<class Other, class OtherDeleter>
        requires is_convertible_v<Other*, Type*> &&
                 is_assignable_v<Deleter&, OtherDeleter&&>
    unique_ptr& operator=(
        unique_ptr<Other, OtherDeleter>&& other) noexcept {
        reset(other.release());
        deleter_ =
            std::forward<OtherDeleter>(other.get_deleter());
        return *this;
    }

    unique_ptr& operator=(nullptr_t) noexcept {
        reset();
        return *this;
    }

    _ADINKRA_NODISCARD add_lvalue_reference_t<Type>
    operator*() const
        requires (!is_void_v<Type>) {
        return *pointer_;
    }

    _ADINKRA_NODISCARD pointer operator->() const noexcept {
        return pointer_;
    }

    _ADINKRA_NODISCARD pointer get() const noexcept {
        return pointer_;
    }

    _ADINKRA_NODISCARD Deleter& get_deleter() noexcept {
        return deleter_;
    }

    _ADINKRA_NODISCARD const Deleter& get_deleter() const noexcept {
        return deleter_;
    }

    explicit operator bool() const noexcept {
        return pointer_ != nullptr;
    }

    pointer release() noexcept {
        return std::exchange(pointer_, nullptr);
    }

    void reset(pointer replacement = pointer()) noexcept {
        pointer old = std::exchange(pointer_, replacement);
        if (old != nullptr) {
            deleter_(old);
        }
    }

    void swap(unique_ptr& other) noexcept {
        std::swap(pointer_, other.pointer_);
        std::swap(deleter_, other.deleter_);
    }

private:
    template<class, class>
    friend class unique_ptr;

    pointer pointer_;
    [[no_unique_address]] Deleter deleter_;
};

