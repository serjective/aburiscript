template<class Type, class... Arguments>
constexpr Type* construct_at(Type* location, Arguments&&... arguments) {
    return ::new (
        const_cast<void*>(
            static_cast<const volatile void*>(location)))
        Type(std::forward<Arguments>(arguments)...);
}

template<class Type>
constexpr void destroy_at(Type* location) {
    if constexpr (is_array_v<Type>) {
        for (auto& element : *location) {
            std::destroy_at(std::addressof(element));
        }
    } else {
        location->~Type();
    }
}

template<class ForwardIterator>
constexpr void destroy(ForwardIterator first, ForwardIterator last) {
    while (first != last) {
        std::destroy_at(std::addressof(*first++));
    }
}

template<class ForwardIterator, class Size>
constexpr ForwardIterator destroy_n(ForwardIterator first, Size count) {
    while (count-- > 0) {
        std::destroy_at(std::addressof(*first++));
    }
    return first;
}

template<class ForwardIterator>
constexpr void uninitialized_default_construct(
    ForwardIterator first, ForwardIterator last) {
    ForwardIterator current = first;
    try {
        while (current != last) {
            using Type = remove_reference_t<decltype(*current)>;
            ::new (static_cast<void*>(std::addressof(*current))) Type;
            ++current;
        }
    } catch (...) {
        std::destroy(first, current);
        throw;
    }
}

