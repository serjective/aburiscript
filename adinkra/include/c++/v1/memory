template<class Allocator>
struct allocator_traits {
    using allocator_type = Allocator;
    using value_type = typename Allocator::value_type;
    using pointer = typename __allocator_pointer<Allocator>::type;
    using const_pointer =
        typename __allocator_const_pointer<Allocator>::type;
    using void_pointer = void*;
    using const_void_pointer = const void*;
    using difference_type =
        typename __allocator_difference_type<Allocator>::type;
    using size_type = typename __allocator_size_type<Allocator>::type;

    template<class Type>
    using rebind_alloc =
        typename __allocator_rebind<Allocator, Type>::type;

    template<class Type>
    using rebind_traits = allocator_traits<rebind_alloc<Type>>;

    static constexpr pointer allocate(
        Allocator& allocator, size_type count) {
        return allocator.allocate(count);
    }

    static constexpr pointer allocate(
        Allocator& allocator, size_type count,
        const_void_pointer hint) {
        if constexpr (requires {
            allocator.allocate(count, hint);
        }) {
            return allocator.allocate(count, hint);
        } else {
            (void)hint;
            return allocator.allocate(count);
        }
    }

    static constexpr void deallocate(
        Allocator& allocator, pointer value, size_type count) {
        allocator.deallocate(value, count);
    }

    template<class Type, class... Arguments>
    static constexpr void construct(
        Allocator& allocator, Type* pointer, Arguments&&... arguments) {
        if constexpr (requires {
            allocator.construct(
                pointer, std::forward<Arguments>(arguments)...);
        }) {
            allocator.construct(
                pointer, std::forward<Arguments>(arguments)...);
        } else {
            std::construct_at(
                pointer, std::forward<Arguments>(arguments)...);
        }
    }

    template<class Type>
    static constexpr void destroy(
        Allocator& allocator, Type* pointer) {
        if constexpr (requires { allocator.destroy(pointer); }) {
            allocator.destroy(pointer);
        } else {
            std::destroy_at(pointer);
        }
    }

    static constexpr size_type max_size(
        const Allocator& allocator) noexcept {
        if constexpr (requires { allocator.max_size(); }) {
            return allocator.max_size();
        } else {
            return static_cast<size_type>(-1) / sizeof(value_type);
        }
    }

    static constexpr Allocator
    select_on_container_copy_construction(const Allocator& allocator) {
        if constexpr (requires {
            allocator.select_on_container_copy_construction();
        }) {
            return allocator.select_on_container_copy_construction();
        } else {
            return allocator;
        }
    }

    using propagate_on_container_copy_assignment =
        typename __allocator_propagate_on_container_copy_assignment<
            Allocator>::type;
    using propagate_on_container_move_assignment =
        typename __allocator_propagate_on_container_move_assignment<
            Allocator>::type;
    using propagate_on_container_swap =
        typename __allocator_propagate_on_container_swap<
            Allocator>::type;
    using is_always_equal =
        typename __allocator_is_always_equal<Allocator>::type;
};

