template<class Type>
class weak_ptr {
public:
    using element_type = remove_extent_t<Type>;

    constexpr weak_ptr() noexcept : pointer_(nullptr), control_(nullptr) {}

    weak_ptr(const weak_ptr& other) noexcept
        : pointer_(other.pointer_), control_(other.control_) {
        add_reference();
    }

    template<class Other>
        requires is_convertible_v<Other*, Type*>
    weak_ptr(const weak_ptr<Other>& other) noexcept
        : pointer_(other.pointer_), control_(other.control_) {
        add_reference();
    }

    template<class Other>
        requires is_convertible_v<Other*, Type*>
    weak_ptr(const shared_ptr<Other>& other) noexcept
        : pointer_(other.pointer_), control_(other.control_) {
        add_reference();
    }

    weak_ptr(weak_ptr&& other) noexcept
        : pointer_(std::exchange(other.pointer_, nullptr)),
          control_(std::exchange(other.control_, nullptr)) {}

    ~weak_ptr() {
        if (control_ != nullptr) {
            control_->release_weak();
        }
    }

