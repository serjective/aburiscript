template<class Left, class LeftDeleter,
         class Right, class RightDeleter>
_ADINKRA_NODISCARD bool operator==(
    const unique_ptr<Left, LeftDeleter>& left,
    const unique_ptr<Right, RightDeleter>& right) noexcept {
    return left.get() == right.get();
}

template<class Left, class LeftDeleter,
         class Right, class RightDeleter>
_ADINKRA_NODISCARD bool operator<(
    const unique_ptr<Left, LeftDeleter>& left,
    const unique_ptr<Right, RightDeleter>& right) {
    using Pointer = common_type_t<
        typename unique_ptr<Left, LeftDeleter>::pointer,
        typename unique_ptr<Right, RightDeleter>::pointer>;
    return less<Pointer>()(left.get(), right.get());
}

