template<class Type>
inline constexpr unsigned char deleter_type_tag = 0;

class shared_control {
public:
    shared_control() noexcept : strong_(1), weak_(1) {}
    virtual ~shared_control() = default;

    void add_strong() noexcept {
        __atomic_add_fetch(&strong_, 1L, __ATOMIC_RELAXED);
    }

    bool try_add_strong() noexcept {
        long value = __atomic_load_n(&strong_, __ATOMIC_ACQUIRE);
        while (value != 0) {
            if (__atomic_compare_exchange_n(
                    &strong_, &value, value + 1, true,
                    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
                return true;
            }
        }
        return false;
    }

    void release_strong() noexcept {
        if (__atomic_sub_fetch(&strong_, 1L, __ATOMIC_ACQ_REL) == 0) {
            destroy_object();
            release_weak();
        }
    }

    void add_weak() noexcept {
        __atomic_add_fetch(&weak_, 1L, __ATOMIC_RELAXED);
    }

    void release_weak() noexcept {
        if (__atomic_sub_fetch(&weak_, 1L, __ATOMIC_ACQ_REL) == 0) {
            delete this;
        }
    }

    long use_count() const noexcept {
        return __atomic_load_n(&strong_, __ATOMIC_ACQUIRE);
    }

    virtual void* get_deleter(const void*) noexcept {
        return nullptr;
    }

private:
    virtual void destroy_object() noexcept = 0;

    long strong_;
    long weak_;
};

template<class Type, class Deleter>
class pointer_control final : public shared_control {
public:
    pointer_control(Type* pointer, Deleter deleter)
        : pointer_(pointer), deleter_(std::move(deleter)) {}

    void* get_deleter(const void* tag) noexcept override {
        using stored_deleter = remove_cv_t<Deleter>;
        return tag == std::addressof(
                          deleter_type_tag<stored_deleter>)
            ? std::addressof(deleter_)
            : nullptr;
    }

private:
    void destroy_object() noexcept override {
        deleter_(pointer_);
    }

    Type* pointer_;
    [[no_unique_address]] Deleter deleter_;
};

template<class Type>
class inplace_control final : public shared_control {
public:
    template<class... Arguments>
    explicit inplace_control(Arguments&&... arguments)
        : object_(std::forward<Arguments>(arguments)...) {}

    Type* pointer() noexcept {
        return std::addressof(object_);
    }

private:
    void destroy_object() noexcept override {
        object_.~Type();
        object_destroyed_ = true;
    }

    ~inplace_control() override {
        if (!object_destroyed_) {
            object_.~Type();
        }
    }

    union {
        Type object_;
    };
    bool object_destroyed_ = false;
};

