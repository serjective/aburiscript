#ifndef ADINKRA_UNORDERED_SET
#define ADINKRA_UNORDERED_SET

#include <__adinkra/config>
#include <__adinkra/unordered_multi>
#include <cstddef>
#include <initializer_list>
#include <memory>
#include <unordered_map>
#include <utility>

_ADINKRA_BEGIN_NAMESPACE_STD

template<class Key, class Hash = hash<Key>,
         class KeyEqual = equal_to<Key>,
         class Allocator = allocator<Key>>
class unordered_set {
    using map_type =
        unordered_map<
            Key, unsigned char, Hash, KeyEqual,
            allocator<pair<const Key, unsigned char>>>;

public:
    using key_type = Key;
    using value_type = Key;
    using hasher = Hash;
    using key_equal = KeyEqual;
    using allocator_type = Allocator;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using reference = value_type&;
    using const_reference = const value_type&;
    using pointer =
        typename allocator_traits<allocator_type>::pointer;
    using const_pointer =
        typename allocator_traits<allocator_type>::const_pointer;

    class iterator {
        friend class unordered_set;

    public:
        using iterator_category = forward_iterator_tag;
        using value_type = Key;
        using difference_type = ptrdiff_t;
        using pointer = const Key*;
        using reference = const Key&;

        iterator() = default;
        reference operator*() const { return iterator_->first; }
        pointer operator->() const {
            return std::addressof(iterator_->first);
        }
        iterator& operator++() {
            ++iterator_;
            return *this;
        }
        iterator operator++(int) {
            iterator result(*this);
            ++*this;
            return result;
        }
        friend bool operator==(
            const iterator& left, const iterator& right) {
            return left.iterator_ == right.iterator_;
        }

    private:
        typename map_type::const_iterator iterator_;
        explicit iterator(
            typename map_type::const_iterator value)
            : iterator_(value) {}
    };

    using const_iterator = iterator;

    unordered_set() = default;

    explicit unordered_set(const Allocator& allocator)
        : unordered_set(8, Hash(), KeyEqual(), allocator) {}

    explicit unordered_set(
        size_type bucket_count,
        const Hash& hash_value = Hash(),
        const KeyEqual& equal_value = KeyEqual(),
        const Allocator& allocator = Allocator())
        : values_(bucket_count, hash_value, equal_value),
          allocator_(allocator) {}

    unordered_set(
        size_type bucket_count,
        const Allocator& allocator)
        : unordered_set(
              bucket_count, Hash(), KeyEqual(), allocator) {}

    unordered_set(
        size_type bucket_count,
        const Hash& hash_value,
        const Allocator& allocator)
        : unordered_set(
              bucket_count, hash_value, KeyEqual(), allocator) {}

    template<class InputIterator>
    unordered_set(
        InputIterator first, InputIterator last,
        size_type bucket_count = 8,
        const Hash& hash_value = Hash(),
        const KeyEqual& equal_value = KeyEqual(),
        const Allocator& allocator = Allocator())
        : unordered_set(
              bucket_count, hash_value, equal_value, allocator) {
        insert(first, last);
    }

    template<class InputIterator>
    unordered_set(
        InputIterator first, InputIterator last,
        size_type bucket_count,
        const Allocator& allocator)
        : unordered_set(
              first, last, bucket_count,
              Hash(), KeyEqual(), allocator) {}

    template<class InputIterator>
    unordered_set(
        InputIterator first, InputIterator last,
        size_type bucket_count,
        const Hash& hash_value,
        const Allocator& allocator)
        : unordered_set(
              first, last, bucket_count,
              hash_value, KeyEqual(), allocator) {}

    unordered_set(
        initializer_list<Key> values,
        size_type bucket_count = 8,
        const Hash& hash_value = Hash(),
        const KeyEqual& equal_value = KeyEqual(),
        const Allocator& allocator = Allocator())
        : unordered_set(
              values.begin(), values.end(), bucket_count,
              hash_value, equal_value, allocator) {}

    unordered_set(
        initializer_list<Key> values,
        size_type bucket_count,
        const Allocator& allocator)
        : unordered_set(
              values, bucket_count,
              Hash(), KeyEqual(), allocator) {}

    unordered_set(
        initializer_list<Key> values,
        size_type bucket_count,
        const Hash& hash_value,
        const Allocator& allocator)
        : unordered_set(
              values, bucket_count,
              hash_value, KeyEqual(), allocator) {}

    unordered_set(
        const unordered_set& other, const Allocator& allocator)
        : unordered_set(
              other.begin(), other.end(), other.bucket_count(),
              other.hash_function(), other.key_eq(), allocator) {
        max_load_factor(other.max_load_factor());
    }

    unordered_set(
        unordered_set&& other, const Allocator& allocator)
        : values_(std::move(other.values_)),
          allocator_(allocator) {}

    unordered_set& operator=(initializer_list<Key> values) {
        clear();
        insert(values);
        return *this;
    }

    allocator_type get_allocator() const noexcept {
        return allocator_;
    }

    iterator begin() const noexcept {
        return iterator(values_.begin());
    }
    iterator end() const noexcept {
        return iterator(values_.end());
    }
    const_iterator cbegin() const noexcept { return begin(); }
    const_iterator cend() const noexcept { return end(); }
    bool empty() const noexcept { return values_.empty(); }
    size_type size() const noexcept { return values_.size(); }
    size_type max_size() const noexcept {
        return values_.max_size();
    }

    pair<iterator, bool> insert(const Key& value) {
        auto result = values_.try_emplace(value, 0);
        return {iterator(result.first), result.second};
    }
    pair<iterator, bool> insert(Key&& value) {
        auto result =
            values_.try_emplace(std::move(value), 0);
        return {iterator(result.first), result.second};
    }
    iterator insert(const_iterator, const Key& value) {
        return insert(value).first;
    }
    iterator insert(const_iterator, Key&& value) {
        return insert(std::move(value)).first;
    }
    template<class InputIterator>
    void insert(InputIterator first, InputIterator last) {
        for (; first != last; ++first) {
            insert(*first);
        }
    }
    void insert(initializer_list<Key> values) {
        insert(values.begin(), values.end());
    }
    template<class... Arguments>
    pair<iterator, bool> emplace(Arguments&&... arguments) {
        Key value(std::forward<Arguments>(arguments)...);
        return insert(std::move(value));
    }
    template<class... Arguments>
    iterator emplace_hint(
        const_iterator, Arguments&&... arguments) {
        return emplace(
            std::forward<Arguments>(arguments)...).first;
    }

    iterator erase(const_iterator position) {
        return iterator(values_.erase(position.iterator_));
    }
    iterator erase(
        const_iterator first, const_iterator last) {
        return iterator(values_.erase(
            first.iterator_, last.iterator_));
    }
    size_type erase(const Key& key) {
        return values_.erase(key);
    }
    void clear() noexcept { values_.clear(); }
    void swap(unordered_set& other) {
        values_.swap(other.values_);
        std::swap(allocator_, other.allocator_);
    }

    size_type count(const Key& key) const {
        return values_.count(key);
    }
    bool contains(const Key& key) const {
        return values_.contains(key);
    }
    iterator find(const Key& key) const {
        return iterator(values_.find(key));
    }
    pair<iterator, iterator> equal_range(
        const Key& key) const {
        const auto range = values_.equal_range(key);
        return {
            iterator(range.first), iterator(range.second)};
    }

    size_type bucket_count() const noexcept {
        return values_.bucket_count();
    }
    size_type max_bucket_count() const noexcept {
        return values_.max_bucket_count();
    }
    size_type bucket_size(size_type bucket) const {
        return values_.bucket_size(bucket);
    }
    size_type bucket(const Key& key) const {
        return values_.bucket(key);
    }
    float load_factor() const noexcept {
        return values_.load_factor();
    }
    float max_load_factor() const noexcept {
        return values_.max_load_factor();
    }
    void max_load_factor(float value) {
        values_.max_load_factor(value);
    }
    void rehash(size_type count) { values_.rehash(count); }
    void reserve(size_type count) { values_.reserve(count); }
    hasher hash_function() const {
        return values_.hash_function();
    }
    key_equal key_eq() const { return values_.key_eq(); }

private:
    map_type values_;
    _ADINKRA_NO_UNIQUE_ADDRESS Allocator allocator_;
};

template<class Key, class Hash, class KeyEqual, class Allocator>
_ADINKRA_NODISCARD bool operator==(
    const unordered_set<Key, Hash, KeyEqual, Allocator>& left,
    const unordered_set<Key, Hash, KeyEqual, Allocator>& right) {
    if (left.size() != right.size()) {
        return false;
    }
    for (const auto& value : left) {
        if (right.find(value) == right.end()) {
            return false;
        }
    }
    return true;
}

template<class Key, class Hash, class KeyEqual, class Allocator>
void swap(
    unordered_set<Key, Hash, KeyEqual, Allocator>& left,
    unordered_set<Key, Hash, KeyEqual, Allocator>& right)
    noexcept(noexcept(left.swap(right))) {
    left.swap(right);
}

template<class Key, class Hash, class KeyEqual,
         class Allocator, class Predicate>
typename unordered_set<Key, Hash, KeyEqual, Allocator>::size_type
erase_if(
    unordered_set<Key, Hash, KeyEqual, Allocator>& container,
    Predicate predicate) {
    const auto original_size = container.size();
    auto current = container.begin();
    while (current != container.end()) {
        if (predicate(*current)) {
            current = container.erase(current);
        } else {
            ++current;
        }
    }
    return original_size - container.size();
}

template<class Key, class Hash = hash<Key>,
         class KeyEqual = equal_to<Key>,
         class Allocator = allocator<Key>>
class unordered_multiset
    : public __unordered_multi_table<
          Key, Key, __unordered_identity_key<Key>,
          Hash, KeyEqual, Allocator, false> {
    using base_type = __unordered_multi_table<
        Key, Key, __unordered_identity_key<Key>,
        Hash, KeyEqual, Allocator, false>;

public:
    using base_type::base_type;
};

template<class Key, class Hash, class KeyEqual, class Allocator>
bool operator==(
    const unordered_multiset<
        Key, Hash, KeyEqual, Allocator>& left,
    const unordered_multiset<
        Key, Hash, KeyEqual, Allocator>& right) {
    if (left.size() != right.size()) {
        return false;
    }
    for (const auto& value : left) {
        if (left.count(value) != right.count(value)) {
            return false;
        }
    }
    return true;
}

template<class Key, class Hash, class KeyEqual, class Allocator>
void swap(
    unordered_multiset<
        Key, Hash, KeyEqual, Allocator>& left,
    unordered_multiset<
        Key, Hash, KeyEqual, Allocator>& right)
    noexcept(noexcept(left.swap(right))) {
    left.swap(right);
}

template<class Key, class Hash, class KeyEqual,
         class Allocator, class Predicate>
typename unordered_multiset<
    Key, Hash, KeyEqual, Allocator>::size_type
erase_if(
    unordered_multiset<
        Key, Hash, KeyEqual, Allocator>& container,
    Predicate predicate) {
    const auto original_size = container.size();
    auto current = container.begin();
    while (current != container.end()) {
        if (predicate(*current)) {
            current = container.erase(current);
        } else {
            ++current;
        }
    }
    return original_size - container.size();
}

_ADINKRA_END_NAMESPACE_STD

#endif
