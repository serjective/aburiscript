template<class, class Function, class... Arguments>
struct is_invocable_impl : false_type {};

template<class Function, class... Arguments>
struct is_invocable_impl<
    void_t<decltype(
        invoke_expression(
            declval<Function>(), declval<Arguments>()...))>,
    Function, Arguments...> : true_type {};

template<class, class Function, class... Arguments>
struct is_nothrow_invocable_impl : false_type {};

template<class Function, class... Arguments>
struct is_nothrow_invocable_impl<
    void_t<decltype(
        invoke_expression(
            declval<Function>(), declval<Arguments>()...))>,
    Function, Arguments...>
    : bool_constant<noexcept(
          invoke_expression(
              declval<Function>(), declval<Arguments>()...))> {};

template<class, class Return, class Function, class... Arguments>
struct is_invocable_r_impl : false_type {};

template<class Return, class Function, class... Arguments>
struct is_invocable_r_impl<
    void_t<decltype(
        invoke_expression(
            declval<Function>(), declval<Arguments>()...))>,
    Return, Function, Arguments...>
    : bool_constant<
          is_void_v<Return> ||
          __is_convertible(
              decltype(invoke_expression(
                  declval<Function>(),
                  declval<Arguments>()...)),
              Return)> {};

template<class, class Return, class Function, class... Arguments>
struct is_nothrow_invocable_r_impl : false_type {};

template<class Return, class Function, class... Arguments>
struct is_nothrow_invocable_r_impl<
    void_t<decltype(
        invoke_expression(
            declval<Function>(), declval<Arguments>()...))>,
    Return, Function, Arguments...>
    : bool_constant<
          (is_void_v<Return> ||
           __is_convertible(
               decltype(invoke_expression(
                   declval<Function>(),
                   declval<Arguments>()...)),
               Return)) &&
          noexcept(invoke_expression(
              declval<Function>(), declval<Arguments>()...))> {};

} // namespace __type_traits_detail

