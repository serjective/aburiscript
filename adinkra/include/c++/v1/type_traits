template<class Member>
struct member_pointer_class;

template<class Member, class Class>
struct member_pointer_class<Member Class::*> {
    using type = Class;
};

template<class Member, class Object, class... Arguments>
    requires (
        is_member_function_pointer_v<remove_cvref_t<Member>> &&
        __is_base_of(
            typename member_pointer_class<
                remove_cvref_t<Member>>::type,
            remove_cvref_t<Object>))
auto invoke_expression(Member&& member, Object&& object,
                       Arguments&&... arguments)
    noexcept(noexcept(
        (declval<Object>().*declval<Member>())(
            declval<Arguments>()...)))
    -> decltype(
        (declval<Object>().*declval<Member>())(
            declval<Arguments>()...));

template<class Member, class Object, class... Arguments>
    requires (
        is_member_function_pointer_v<remove_cvref_t<Member>> &&
        !__is_base_of(
            typename member_pointer_class<
                remove_cvref_t<Member>>::type,
            remove_cvref_t<Object>) &&
        requires {
            (declval<Object>().get().*declval<Member>())(
                declval<Arguments>()...);
        })
auto invoke_expression(Member&& member, Object&& object,
                       Arguments&&... arguments)
    noexcept(noexcept(
        (declval<Object>().get().*declval<Member>())(
            declval<Arguments>()...)))
    -> decltype(
        (declval<Object>().get().*declval<Member>())(
            declval<Arguments>()...));

template<class Member, class Object, class... Arguments>
    requires (
        is_member_function_pointer_v<remove_cvref_t<Member>> &&
        !__is_base_of(
            typename member_pointer_class<
                remove_cvref_t<Member>>::type,
            remove_cvref_t<Object>) &&
        !requires {
            (declval<Object>().get().*declval<Member>())(
                declval<Arguments>()...);
        } &&
        requires {
            ((*declval<Object>()).*declval<Member>())(
                declval<Arguments>()...);
        })
auto invoke_expression(Member&& member, Object&& object,
                       Arguments&&... arguments)
    noexcept(noexcept(
        ((*declval<Object>()).*declval<Member>())(
            declval<Arguments>()...)))
    -> decltype(
        ((*declval<Object>()).*declval<Member>())(
            declval<Arguments>()...));

template<class Member, class Object>
    requires (
        is_member_object_pointer_v<remove_cvref_t<Member>> &&
        __is_base_of(
            typename member_pointer_class<
                remove_cvref_t<Member>>::type,
            remove_cvref_t<Object>))
auto invoke_expression(Member&& member, Object&& object)
    noexcept(noexcept(declval<Object>().*declval<Member>()))
    -> decltype(declval<Object>().*declval<Member>());

template<class Member, class Object>
    requires (
        is_member_object_pointer_v<remove_cvref_t<Member>> &&
        !__is_base_of(
            typename member_pointer_class<
                remove_cvref_t<Member>>::type,
            remove_cvref_t<Object>) &&
        requires {
            declval<Object>().get().*declval<Member>();
        })
auto invoke_expression(Member&& member, Object&& object)
    noexcept(noexcept(
        declval<Object>().get().*declval<Member>()))
    -> decltype(
        declval<Object>().get().*declval<Member>());

template<class Member, class Object>
    requires (
        is_member_object_pointer_v<remove_cvref_t<Member>> &&
        !__is_base_of(
            typename member_pointer_class<
                remove_cvref_t<Member>>::type,
            remove_cvref_t<Object>) &&
        !requires {
            declval<Object>().get().*declval<Member>();
        } &&
        requires {
            (*declval<Object>()).*declval<Member>();
        })
auto invoke_expression(Member&& member, Object&& object)
    noexcept(noexcept(
        (*declval<Object>()).*declval<Member>()))
    -> decltype(
        (*declval<Object>()).*declval<Member>());

template<class Function, class... Arguments>
    requires (
        !is_member_pointer_v<remove_cvref_t<Function>> &&
        requires {
            declval<Function>()(declval<Arguments>()...);
        })
auto invoke_expression(Function&& function, Arguments&&... arguments)
    noexcept(noexcept(
        declval<Function>()(declval<Arguments>()...)))
    -> decltype(
        declval<Function>()(declval<Arguments>()...));

} // namespace __type_traits_detail

template<class Signature>
struct result_of;

namespace __type_traits_detail {

template<class, class Function, class... Arguments>
struct result_of_impl {};

template<class Function, class... Arguments>
struct result_of_impl<
    void_t<decltype(
        invoke_expression(
            declval<Function>(), declval<Arguments>()...))>,
    Function, Arguments...> {
    using type =
        decltype(invoke_expression(
            declval<Function>(), declval<Arguments>()...));
};

} // namespace __type_traits_detail

template<class Function, class... Arguments>
struct result_of<Function(Arguments...)>
    : __type_traits_detail::result_of_impl<
          void, Function, Arguments...> {};

