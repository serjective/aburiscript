template<size_t Length, class... Types>
struct aligned_union {
private:
    static constexpr size_t max_size() {
        size_t result = Length;
        ((result = result < sizeof(Types) ? sizeof(Types) : result), ...);
        return result;
    }

    static constexpr size_t max_alignment() {
        size_t result = 1;
        ((result = result < alignof(Types) ? alignof(Types) : result), ...);
        return result;
    }

public:
    static constexpr size_t alignment_value = max_alignment();
    using type = aligned_storage_t<max_size(), alignment_value>;
};

template<size_t Length, class... Types>
using aligned_union_t = typename aligned_union<Length, Types...>::type;

