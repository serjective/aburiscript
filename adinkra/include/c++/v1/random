class bernoulli_distribution {
public:
    using result_type = bool;

    class param_type {
    public:
        using distribution_type = bernoulli_distribution;

        explicit param_type(double probability = 0.5)
            : probability_(probability) {}

        double p() const {
            return probability_;
        }

        friend bool operator==(
            const param_type&, const param_type&) = default;

    private:
        double probability_;
    };

    bernoulli_distribution()
        : bernoulli_distribution(0.5) {}

    explicit bernoulli_distribution(double probability)
        : parameters_(probability) {}

    explicit bernoulli_distribution(const param_type& parameters)
        : parameters_(parameters) {}

    void reset() {}

    template<class Generator>
    result_type operator()(Generator& generator) {
        return (*this)(generator, parameters_);
    }

    template<class Generator>
    result_type operator()(
        Generator& generator, const param_type& parameters) {
        if (parameters.p() <= 0.0) {
            return false;
        }
        if (parameters.p() >= 1.0) {
            return true;
        }
        const long double generator_min =
            static_cast<long double>((Generator::min)());
        const long double generator_range =
            static_cast<long double>((Generator::max)()) -
            generator_min + 1.0L;
        const long double unit =
            (static_cast<long double>(generator()) -
             generator_min) /
            generator_range;
        return unit < static_cast<long double>(parameters.p());
    }

    double p() const {
        return parameters_.p();
    }

    param_type param() const {
        return parameters_;
    }

    void param(const param_type& parameters) {
        parameters_ = parameters;
    }

    static constexpr result_type min() {
        return false;
    }

    static constexpr result_type max() {
        return true;
    }

    friend bool operator==(
        const bernoulli_distribution&,
        const bernoulli_distribution&) = default;

private:
    param_type parameters_;
};

template<class IntegerType = int>
class uniform_int_distribution {
    static_assert(is_integral_v<IntegerType>);

public:
    using result_type = IntegerType;

    class param_type {
    public:
        using distribution_type = uniform_int_distribution;

        explicit param_type(
            result_type lower = result_type(0),
            result_type upper =
                (numeric_limits<result_type>::max)())
            : lower_(lower), upper_(upper) {}

        result_type a() const {
            return lower_;
        }

        result_type b() const {
            return upper_;
        }

    private:
        result_type lower_;
        result_type upper_;
    };

    uniform_int_distribution()
        : uniform_int_distribution(
              result_type(0),
              (numeric_limits<result_type>::max)()) {}

    explicit uniform_int_distribution(
        result_type lower,
        result_type upper =
            (numeric_limits<result_type>::max)())
        : parameters_(lower, upper) {}

    explicit uniform_int_distribution(const param_type& parameters)
        : parameters_(parameters) {}

    void reset() {}

    template<class Generator>
    result_type operator()(Generator& generator) {
        return (*this)(generator, parameters_);
    }

    template<class Generator>
    result_type operator()(
        Generator& generator,
        const param_type& parameters) {
        using result_unsigned = make_unsigned_t<result_type>;
        using generator_result = typename Generator::result_type;
        using generator_unsigned =
            make_unsigned_t<generator_result>;
        using wide_type = unsigned __int128;

        const result_unsigned lower =
            static_cast<result_unsigned>(parameters.a());
        const result_unsigned upper =
            static_cast<result_unsigned>(parameters.b());
        const wide_type width =
            static_cast<wide_type>(
                static_cast<result_unsigned>(upper - lower)) +
            1U;

        const generator_unsigned generator_min =
            static_cast<generator_unsigned>((Generator::min)());
        const generator_unsigned generator_max =
            static_cast<generator_unsigned>((Generator::max)());
        const wide_type generator_width =
            static_cast<wide_type>(
                static_cast<generator_unsigned>(
                    generator_max - generator_min)) +
            1U;

        const auto draw = [&]() -> wide_type {
            return static_cast<wide_type>(
                static_cast<generator_unsigned>(
                    static_cast<generator_unsigned>(generator()) -
                    generator_min));
        };

        wide_type sample = 0;
        wide_type sample_width = generator_width;
        do {
            sample = draw();
            sample_width = generator_width;
            while (sample_width < width) {
                sample =
                    sample * generator_width + draw();
                sample_width *= generator_width;
            }
        } while (
            sample >=
            sample_width - sample_width % width);

        const result_unsigned result =
            static_cast<result_unsigned>(
                lower +
                static_cast<result_unsigned>(sample % width));
        return static_cast<result_type>(result);
    }

    result_type a() const {
        return parameters_.a();
    }

    result_type b() const {
        return parameters_.b();
    }

    param_type param() const {
        return parameters_;
    }

    void param(const param_type& parameters) {
        parameters_ = parameters;
    }

    result_type min() const {
        return a();
    }

    result_type max() const {
        return b();
    }

private:
    param_type parameters_;
};

template<class RealType = double>
class uniform_real_distribution {
public:
    using result_type = RealType;

    class param_type {
    public:
        using distribution_type = uniform_real_distribution;

        explicit param_type(
            result_type lower = result_type(0),
            result_type upper = result_type(1))
            : lower_(lower), upper_(upper) {}

        result_type a() const {
            return lower_;
        }

        result_type b() const {
            return upper_;
        }

    private:
        result_type lower_;
        result_type upper_;
    };

    uniform_real_distribution()
        : uniform_real_distribution(result_type(0), result_type(1)) {}

    explicit uniform_real_distribution(
        result_type lower,
        result_type upper = result_type(1))
        : parameters_(lower, upper) {}

    explicit uniform_real_distribution(const param_type& parameters)
        : parameters_(parameters) {}

    void reset() {}

    template<class Generator>
    result_type operator()(Generator& generator) {
        return (*this)(generator, parameters_);
    }

    template<class Generator>
    result_type operator()(
        Generator& generator,
        const param_type& parameters) {
        const long double generator_min =
            static_cast<long double>((Generator::min)());
        const long double generator_range =
            static_cast<long double>((Generator::max)()) -
            generator_min + 1.0L;
        const long double unit =
            (static_cast<long double>(generator()) - generator_min) /
            generator_range;
        return static_cast<result_type>(
            static_cast<long double>(parameters.a()) +
            unit *
                (static_cast<long double>(parameters.b()) -
                 static_cast<long double>(parameters.a())));
    }

    result_type a() const {
        return parameters_.a();
    }

    result_type b() const {
        return parameters_.b();
    }

    param_type param() const {
        return parameters_;
    }

    void param(const param_type& parameters) {
        parameters_ = parameters;
    }

    result_type min() const {
        return a();
    }

    result_type max() const {
        return b();
    }

private:
    param_type parameters_;
};

template<class RealType = double>
class normal_distribution {
    static_assert(is_floating_point_v<RealType>);

public:
    using result_type = RealType;

    class param_type {
    public:
        using distribution_type = normal_distribution;

        explicit param_type(
            result_type mean = result_type(0),
            result_type standard_deviation = result_type(1))
            : mean_(mean),
              standard_deviation_(standard_deviation) {}

        result_type mean() const {
            return mean_;
        }

        result_type stddev() const {
            return standard_deviation_;
        }

        friend bool operator==(
            const param_type&, const param_type&) = default;

    private:
        result_type mean_;
        result_type standard_deviation_;
    };

    normal_distribution()
        : normal_distribution(result_type(0), result_type(1)) {}

    explicit normal_distribution(
        result_type mean,
        result_type standard_deviation = result_type(1))
        : parameters_(mean, standard_deviation),
          spare_(0),
          has_spare_(false) {}

    explicit normal_distribution(const param_type& parameters)
        : parameters_(parameters),
          spare_(0),
          has_spare_(false) {}

    void reset() {
        has_spare_ = false;
    }

    template<class Generator>
    result_type operator()(Generator& generator) {
        return (*this)(generator, parameters_);
    }

    template<class Generator>
    result_type operator()(
        Generator& generator, const param_type& parameters) {
        result_type standard_value;
        if (has_spare_) {
            standard_value = spare_;
            has_spare_ = false;
        } else {
            uniform_real_distribution<result_type> uniform(
                result_type(0), result_type(1));
            result_type left;
            result_type right;
            result_type radius_squared;
            do {
                left = result_type(2) * uniform(generator) -
                    result_type(1);
                right = result_type(2) * uniform(generator) -
                    result_type(1);
                radius_squared = left * left + right * right;
            } while (
                radius_squared <= result_type(0) ||
                radius_squared >= result_type(1));

            const result_type multiplier = std::sqrt(
                result_type(-2) * std::log(radius_squared) /
                radius_squared);
            standard_value = left * multiplier;
            spare_ = right * multiplier;
            has_spare_ = true;
        }
        return parameters.mean() +
            parameters.stddev() * standard_value;
    }

    result_type mean() const {
        return parameters_.mean();
    }

    result_type stddev() const {
        return parameters_.stddev();
    }

    param_type param() const {
        return parameters_;
    }

    void param(const param_type& parameters) {
        parameters_ = parameters;
    }

    static constexpr result_type min() {
        return (numeric_limits<result_type>::lowest)();
    }

    static constexpr result_type max() {
        return (numeric_limits<result_type>::max)();
    }

private:
    param_type parameters_;
    result_type spare_;
    bool has_spare_;
};

