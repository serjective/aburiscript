class random_device {
public:
    using result_type = uint32_t;

    random_device() = default;

    explicit random_device(const char*) {}

    static constexpr result_type min() {
        return (numeric_limits<result_type>::min)();
    }

    static constexpr result_type max() {
        return (numeric_limits<result_type>::max)();
    }

    double entropy() const noexcept {
#if defined(__APPLE__) || defined(__FreeBSD__) || defined(__OpenBSD__) || \
    defined(__NetBSD__)
        return 32.0;
#else
        return 0.0;
#endif
    }

    result_type operator()() {
#if defined(__APPLE__) || defined(__FreeBSD__) || defined(__OpenBSD__) || \
    defined(__NetBSD__)
        return ::arc4random();
#else
        const result_type high =
            static_cast<result_type>(::rand());
        const result_type low =
            static_cast<result_type>(::rand());
        return (high << 16U) ^ low;
#endif
    }
};

class seed_seq {
public:
    using result_type = uint32_t;

    seed_seq() noexcept = default;

    template<class InputIterator>
    seed_seq(InputIterator first, InputIterator last) {
        while (first != last) {
            append(static_cast<result_type>(*first++));
        }
    }

    template<class Type>
    seed_seq(initializer_list<Type> values)
        : seed_seq(values.begin(), values.end()) {}

    ~seed_seq() {
        ::free(values_);
    }

    seed_seq(const seed_seq&) = delete;
    seed_seq& operator=(const seed_seq&) = delete;

    template<class RandomAccessIterator>
    void generate(
        RandomAccessIterator first,
        RandomAccessIterator last) {
        const size_t output_size =
            static_cast<size_t>(last - first);
        if (output_size == 0) {
            return;
        }

        for (RandomAccessIterator current = first;
             current != last; ++current) {
            *current = static_cast<result_type>(0x8b8b8b8bU);
        }

        const size_t mix_distance =
            output_size >= 623 ? 11
            : output_size >= 68 ? 7
            : output_size >= 39 ? 5
            : output_size >= 7 ? 3
                               : (output_size - 1) / 2;
        const size_t first_offset =
            (output_size - mix_distance) / 2;
        const size_t second_offset =
            first_offset + mix_distance;
        const size_t mix_count =
            size_ + 1 > output_size ? size_ + 1 : output_size;

        for (size_t index = 0; index < mix_count; ++index) {
            const size_t previous =
                index == 0 ? output_size - 1
                           : (index - 1) % output_size;
            result_type mixed = static_cast<result_type>(
                first[index % output_size] ^
                first[(index + first_offset) % output_size] ^
                first[previous]);
            mixed ^= mixed >> 27U;
            const result_type first_result =
                static_cast<result_type>(1664525U * mixed);

            result_type second_result = first_result;
            if (index == 0) {
                second_result += static_cast<result_type>(size_);
            } else {
                second_result +=
                    static_cast<result_type>(index % output_size);
                if (index <= size_) {
                    second_result += values_[index - 1];
                }
            }

            first[(index + first_offset) % output_size] +=
                first_result;
            first[(index + second_offset) % output_size] +=
                second_result;
            first[index % output_size] = second_result;
        }

        for (size_t index = mix_count;
             index < mix_count + output_size; ++index) {
            const size_t previous = (index - 1) % output_size;
            result_type mixed = static_cast<result_type>(
                first[index % output_size] +
                first[(index + first_offset) % output_size] +
                first[previous]);
            mixed ^= mixed >> 27U;
            const result_type first_result =
                static_cast<result_type>(1566083941U * mixed);
            const result_type second_result =
                first_result -
                static_cast<result_type>(index % output_size);

            first[(index + first_offset) % output_size] ^=
                first_result;
            first[(index + second_offset) % output_size] ^=
                second_result;
            first[index % output_size] = second_result;
        }
    }

    size_t size() const noexcept {
        return size_;
    }

    template<class OutputIterator>
    void param(OutputIterator output) const {
        for (size_t index = 0; index < size_; ++index) {
            *output++ = values_[index];
        }
    }

private:
    result_type* values_ = nullptr;
    size_t size_ = 0;
    size_t capacity_ = 0;

    void append(result_type value) {
        if (size_ == capacity_) {
            const size_t next_capacity =
                capacity_ == 0 ? 8 : capacity_ * 2;
            void* allocation = ::realloc(
                values_, next_capacity * sizeof(result_type));
            if (allocation == nullptr) {
                ::free(values_);
                values_ = nullptr;
                size_ = 0;
                capacity_ = 0;
                throw bad_alloc();
            }
            values_ = static_cast<result_type*>(allocation);
            capacity_ = next_capacity;
        }
        values_[size_++] = value;
    }
};

template<class UIntType, UIntType Multiplier, UIntType Increment,
         UIntType Modulus>
class linear_congruential_engine {
    static_assert(is_unsigned_v<UIntType>);

public:
    using result_type = UIntType;

    static constexpr result_type multiplier = Multiplier;
    static constexpr result_type increment = Increment;
    static constexpr result_type modulus = Modulus;
    static constexpr result_type default_seed = 1U;

    explicit constexpr linear_congruential_engine(
        result_type seed_value = default_seed) {
        seed(seed_value);
    }

    template<class SeedSequence>
        requires (!is_convertible_v<SeedSequence&, result_type>)
    explicit linear_congruential_engine(SeedSequence& sequence) {
        seed(sequence);
    }

    constexpr void seed(result_type seed_value = default_seed) {
        if constexpr (modulus != 0) {
            state_ = seed_value % modulus;
        } else {
            state_ = seed_value;
        }
        if constexpr (increment == 0) {
            if (state_ == 0) {
                state_ = 1;
            }
        }
    }

    template<class SeedSequence>
        requires (!is_convertible_v<SeedSequence&, result_type>)
    void seed(SeedSequence& sequence) {
        constexpr size_t word_count =
            (numeric_limits<result_type>::digits + 31U) / 32U;
        uint32_t generated[word_count + 3]{};
        sequence.generate(
            generated, generated + word_count + 3);
        unsigned __int128 seed_value = 0;
        for (size_t index = 0; index < word_count; ++index) {
            seed_value |=
                static_cast<unsigned __int128>(
                    generated[index + 3])
                << (index * 32U);
        }
        seed(static_cast<result_type>(seed_value));
    }

    static constexpr result_type min() {
        return increment == 0 ? result_type(1) : result_type(0);
    }

    static constexpr result_type max() {
        return modulus == 0
            ? (numeric_limits<result_type>::max)()
            : static_cast<result_type>(modulus - 1);
    }

    constexpr result_type operator()() {
        if constexpr (modulus == 0) {
            state_ = static_cast<result_type>(
                multiplier * state_ + increment);
        } else {
            state_ = static_cast<result_type>(
                (static_cast<unsigned __int128>(multiplier) *
                     state_ +
                 increment) %
                modulus);
        }
        return state_;
    }

    constexpr void discard(unsigned long long count) {
        while (count-- != 0) {
            (void)(*this)();
        }
    }

    friend constexpr bool operator==(
        const linear_congruential_engine&,
        const linear_congruential_engine&) = default;

private:
    result_type state_ = default_seed;
};

using minstd_rand0 =
    linear_congruential_engine<uint_fast32_t, 16807, 0, 2147483647>;
using minstd_rand =
    linear_congruential_engine<uint_fast32_t, 48271, 0, 2147483647>;

class mt19937 {
public:
    using result_type = uint32_t;

    static constexpr result_type default_seed = 5489U;

    explicit mt19937(result_type seed_value = default_seed) {
        seed(seed_value);
    }

    template<class SeedSequence>
        requires (!is_convertible_v<SeedSequence&, result_type>)
    explicit mt19937(SeedSequence& sequence) {
        seed(sequence);
    }

    void seed(result_type seed_value = default_seed) {
        state_[0] = seed_value;
        for (size_t index = 1; index < state_size; ++index) {
            state_[index] =
                1812433253U *
                    (state_[index - 1] ^
                     (state_[index - 1] >> 30U)) +
                static_cast<result_type>(index);
        }
        index_ = state_size;
    }

    template<class SeedSequence>
        requires (!is_convertible_v<SeedSequence&, result_type>)
    void seed(SeedSequence& sequence) {
        uint32_t generated[state_size];
        sequence.generate(
            generated, generated + state_size);
        bool all_zero = true;
        for (size_t index = 0; index < state_size; ++index) {
            state_[index] = generated[index];
            all_zero = all_zero && state_[index] == 0;
        }
        if (all_zero) {
            state_[0] = 0x80000000U;
        }
        index_ = state_size;
    }

    static constexpr result_type min() {
        return 0U;
    }

    static constexpr result_type max() {
        return 0xffffffffU;
    }

    result_type operator()() {
        if (index_ >= state_size) {
            twist();
        }

        result_type value = state_[index_++];
        value ^= value >> 11U;
        value ^= (value << 7U) & 0x9d2c5680U;
        value ^= (value << 15U) & 0xefc60000U;
        value ^= value >> 18U;
        return value;
    }

    void discard(unsigned long long count) {
        while (count-- != 0) {
            (void)(*this)();
        }
    }

private:
    static constexpr size_t state_size = 624;
    static constexpr size_t shift_size = 397;
    result_type state_[state_size]{};
    size_t index_ = state_size;

    void twist() {
        for (size_t index = 0; index < state_size; ++index) {
            const result_type combined =
                (state_[index] & 0x80000000U) |
                (state_[(index + 1) % state_size] & 0x7fffffffU);
            result_type shifted = combined >> 1U;
            if ((combined & 1U) != 0U) {
                shifted ^= 0x9908b0dfU;
            }
            state_[index] =
                state_[(index + shift_size) % state_size] ^ shifted;
        }
        index_ = 0;
    }
};

class mt19937_64 {
public:
    using result_type = uint64_t;

    static constexpr result_type default_seed = 5489U;

    explicit mt19937_64(result_type seed_value = default_seed) {
        seed(seed_value);
    }

    template<class SeedSequence>
        requires (!is_convertible_v<SeedSequence&, result_type>)
    explicit mt19937_64(SeedSequence& sequence) {
        seed(sequence);
    }

    void seed(result_type seed_value = default_seed) {
        state_[0] = seed_value;
        for (size_t index = 1; index < state_size; ++index) {
            state_[index] =
                6364136223846793005ULL *
                    (state_[index - 1] ^
                     (state_[index - 1] >> 62U)) +
                static_cast<result_type>(index);
        }
        index_ = state_size;
    }

    template<class SeedSequence>
        requires (!is_convertible_v<SeedSequence&, result_type>)
    void seed(SeedSequence& sequence) {
        uint32_t generated[state_size * 2];
        sequence.generate(
            generated, generated + state_size * 2);
        bool all_zero = true;
        for (size_t index = 0; index < state_size; ++index) {
            state_[index] =
                static_cast<result_type>(generated[index * 2]) |
                (static_cast<result_type>(
                     generated[index * 2 + 1]) << 32U);
            all_zero = all_zero && state_[index] == 0;
        }
        if (all_zero) {
            state_[0] = 0x8000000000000000ULL;
        }
        index_ = state_size;
    }

    static constexpr result_type min() {
        return 0;
    }

    static constexpr result_type max() {
        return 0xffffffffffffffffULL;
    }

    result_type operator()() {
        if (index_ >= state_size) {
            twist();
        }

        result_type value = state_[index_++];
        value ^= (value >> 29U) & 0x5555555555555555ULL;
        value ^= (value << 17U) & 0x71d67fffeda60000ULL;
        value ^= (value << 37U) & 0xfff7eee000000000ULL;
        value ^= value >> 43U;
        return value;
    }

    void discard(unsigned long long count) {
        while (count-- != 0) {
            (void)(*this)();
        }
    }

private:
    static constexpr size_t state_size = 312;
    static constexpr size_t shift_size = 156;
    static constexpr result_type lower_mask =
        (result_type(1) << 31U) - 1U;
    static constexpr result_type upper_mask = ~lower_mask;

    result_type state_[state_size]{};
    size_t index_ = state_size;

    void twist() {
        for (size_t index = 0; index < state_size; ++index) {
            const result_type combined =
                (state_[index] & upper_mask) |
                (state_[(index + 1) % state_size] & lower_mask);
            result_type shifted = combined >> 1U;
            if ((combined & 1U) != 0U) {
                shifted ^= 0xb5026f5aa96619e9ULL;
            }
            state_[index] =
                state_[(index + shift_size) % state_size] ^ shifted;
        }
        index_ = 0;
    }
};

