template<class Key, class Mapped, class Hash = hash<Key>,
         class KeyEqual = equal_to<Key>,
         class Allocator = allocator<pair<const Key, Mapped>>>
class unordered_multimap
    : public __unordered_multi_table<
          Key, pair<const Key, Mapped>,
          __unordered_pair_key<Key, Mapped>,
          Hash, KeyEqual, Allocator, true> {
    using base_type = __unordered_multi_table<
        Key, pair<const Key, Mapped>,
        __unordered_pair_key<Key, Mapped>,
        Hash, KeyEqual, Allocator, true>;

public:
    using mapped_type = Mapped;
    using base_type::base_type;
};

template<class Key, class Mapped, class Hash,
         class KeyEqual, class Allocator>
bool operator==(
    const unordered_multimap<
        Key, Mapped, Hash, KeyEqual, Allocator>& left,
    const unordered_multimap<
        Key, Mapped, Hash, KeyEqual, Allocator>& right) {
    if (left.size() != right.size()) {
        return false;
    }
    for (const auto& value : left) {
        size_t left_count = 0;
        size_t right_count = 0;
        for (const auto& candidate : left) {
            if (candidate == value) {
                ++left_count;
            }
        }
        for (const auto& candidate : right) {
            if (candidate == value) {
                ++right_count;
            }
        }
        if (left_count != right_count) {
            return false;
        }
    }
    return true;
}

