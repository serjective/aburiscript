    template<class... Arguments>
    constexpr Type& emplace(Arguments&&... arguments) {
        reset();
        std::construct_at(
            std::addressof(value_), std::forward<Arguments>(arguments)...);
        engaged_ = true;
        return value_;
    }

    template<class Element, class... Arguments>
    constexpr Type& emplace(
        initializer_list<Element> values,
        Arguments&&... arguments) {
        reset();
        std::construct_at(
            std::addressof(value_), values,
            std::forward<Arguments>(arguments)...);
        engaged_ = true;
        return value_;
    }

    constexpr void reset() noexcept {
        if (engaged_) {
            std::destroy_at(std::addressof(value_));
            engaged_ = false;
        }
    }

    constexpr void swap(optional& other)
        noexcept(is_nothrow_move_constructible_v<Type> &&
                 noexcept(std::swap(declval<Type&>(), declval<Type&>()))) {
        if (engaged_ && other.engaged_) {
            std::swap(value_, other.value_);
        } else if (engaged_) {
            other.emplace(std::move(value_));
            reset();
        } else if (other.engaged_) {
            emplace(std::move(other.value_));
            other.reset();
        }
    }

private:
#if __cplusplus >= 202302L
    template<class>
    friend class optional;

    template<class Function, class Value>
    constexpr optional(
        __optional_construct_from_invoke_t,
        Function&& function, Value&& value)
        : __base(
              __optional_construct_from_invoke_t{},
              std::forward<Function>(function),
              std::forward<Value>(value)) {}
#endif
};

template<class Type>
optional(Type) -> optional<Type>;

template<class Type, class... Arguments>
_ADINKRA_NODISCARD constexpr optional<Type>
make_optional(Arguments&&... arguments) {
    return optional<Type>(
        in_place, std::forward<Arguments>(arguments)...);
}

template<class Type>
_ADINKRA_NODISCARD constexpr optional<decay_t<Type>>
make_optional(Type&& value) {
    return optional<decay_t<Type>>(std::forward<Type>(value));
}

template<class Type, class Other>
    requires requires(
        const Type& left, const Other& right) {
        { left == right } -> convertible_to<bool>;
    }
_ADINKRA_NODISCARD constexpr bool
operator==(const optional<Type>& left,
           const optional<Other>& right) {
    if (left.has_value() != right.has_value()) {
        return false;
    }
    return !left.has_value() || *left == *right;
}

template<class Type, class Other>
    requires requires(
        const Type& left, const Other& right) {
        { left != right } -> convertible_to<bool>;
    }
_ADINKRA_NODISCARD constexpr bool
operator!=(const optional<Type>& left,
           const optional<Other>& right) {
    if (left.has_value() != right.has_value()) {
        return true;
    }
    return left.has_value() && *left != *right;
}

template<class Type>
_ADINKRA_NODISCARD constexpr bool
operator==(const optional<Type>& value, nullopt_t) noexcept {
    return !value.has_value();
}

template<class Type, class Value>
    requires (!__is_optional_specialization_v<remove_cv_t<Value>>) &&
             requires(
                 const Type& left, const Value& right) {
                 { left == right } -> convertible_to<bool>;
             }
_ADINKRA_NODISCARD constexpr bool
operator==(const optional<Type>& optional_value,
           const Value& value) {
    return optional_value.has_value() && *optional_value == value;
}

