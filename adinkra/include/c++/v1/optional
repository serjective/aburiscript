    _ADINKRA_NODISCARD constexpr auto and_then(Function&& function) & {
        using result =
            remove_cvref_t<invoke_result_t<Function, Type&>>;
        static_assert(__is_optional_specialization_v<result>);
        if (engaged_) {
            return std::invoke(
                std::forward<Function>(function), value_);
        }
        return result();
    }

    template<class Function>
    _ADINKRA_NODISCARD constexpr auto and_then(
        Function&& function) const& {
        using result =
            remove_cvref_t<invoke_result_t<Function, const Type&>>;
