template<class First, class Second>
struct pair {
    using first_type = First;
    using second_type = Second;

    First first;
    Second second;

    constexpr pair()
        requires is_default_constructible_v<First> &&
                 is_default_constructible_v<Second>
        : first(), second() {}

    constexpr explicit(
        !is_convertible_v<const First&, First> ||
        !is_convertible_v<const Second&, Second>)
    pair(const First& first_value, const Second& second_value)
        : first(first_value), second(second_value) {}

    template<class OtherFirst, class OtherSecond>
        requires (
            is_constructible_v<First, OtherFirst&&> &&
            is_constructible_v<Second, OtherSecond&&>)
    constexpr explicit(
        !is_convertible_v<OtherFirst&&, First> ||
        !is_convertible_v<OtherSecond&&, Second>)
    pair(OtherFirst&& first_value, OtherSecond&& second_value)
        : first(std::forward<OtherFirst>(first_value)),
          second(std::forward<OtherSecond>(second_value)) {}

    template<class OtherFirst, class OtherSecond>
        requires (
            is_constructible_v<First, const OtherFirst&> &&
            is_constructible_v<Second, const OtherSecond&>)
    constexpr explicit(
        !is_convertible_v<const OtherFirst&, First> ||
        !is_convertible_v<const OtherSecond&, Second>)
    pair(const pair<OtherFirst, OtherSecond>& other)
        : first(other.first), second(other.second) {}

    template<class OtherFirst, class OtherSecond>
        requires (
            is_constructible_v<First, OtherFirst&&> &&
            is_constructible_v<Second, OtherSecond&&>)
    constexpr explicit(
        !is_convertible_v<OtherFirst&&, First> ||
        !is_convertible_v<OtherSecond&&, Second>)
    pair(pair<OtherFirst, OtherSecond>&& other)
        : first(std::forward<OtherFirst>(other.first)),
          second(std::forward<OtherSecond>(other.second)) {}

    template<class... FirstArguments, class... SecondArguments>
    constexpr pair(
        piecewise_construct_t,
        tuple<FirstArguments...> first_arguments,
        tuple<SecondArguments...> second_arguments);

    constexpr pair(const pair&) = default;
    constexpr pair(pair&&) = default;

    constexpr pair& operator=(const pair& other)
        requires is_assignable_v<First&, const First&> &&
                 is_assignable_v<Second&, const Second&> {
        first = other.first;
        second = other.second;
        return *this;
    }

    constexpr pair& operator=(pair&& other)
        requires is_assignable_v<First&, First&&> &&
                 is_assignable_v<Second&, Second&&> {
        first = std::forward<First>(other.first);
        second = std::forward<Second>(other.second);
        return *this;
    }

    template<class OtherFirst, class OtherSecond>
    constexpr pair& operator=(
        const pair<OtherFirst, OtherSecond>& other)
        requires is_assignable_v<First&, const OtherFirst&> &&
                 is_assignable_v<Second&, const OtherSecond&> {
        first = other.first;
        second = other.second;
        return *this;
    }

    template<class OtherFirst, class OtherSecond>
    constexpr pair& operator=(
        pair<OtherFirst, OtherSecond>&& other)
        requires is_assignable_v<First&, OtherFirst&&> &&
                 is_assignable_v<Second&, OtherSecond&&> {
        first = std::forward<OtherFirst>(other.first);
        second = std::forward<OtherSecond>(other.second);
        return *this;
    }

    constexpr void swap(pair& other)
        noexcept(noexcept(std::swap(first, other.first)) &&
                 noexcept(std::swap(second, other.second))) {
        std::swap(first, other.first);
        std::swap(second, other.second);
    }

private:
    template<class... FirstArguments, class... SecondArguments,
             size_t... FirstIndexes, size_t... SecondIndexes>
    constexpr pair(
        tuple<FirstArguments...>&& first_arguments,
        tuple<SecondArguments...>&& second_arguments,
        index_sequence<FirstIndexes...>,
        index_sequence<SecondIndexes...>);
};

template<class First, class Second>
pair(First, Second) -> pair<First, Second>;

template<class First, class Second>
_ADINKRA_NODISCARD constexpr pair<decay_t<First>, decay_t<Second>>
make_pair(First&& first, Second&& second) {
    return {std::forward<First>(first), std::forward<Second>(second)};
}

template<class First, class Second>
_ADINKRA_NODISCARD constexpr bool
operator==(const pair<First, Second>& left,
           const pair<First, Second>& right) {
    return left.first == right.first && left.second == right.second;
}

template<class First, class Second>
_ADINKRA_NODISCARD constexpr bool
operator<(const pair<First, Second>& left,
          const pair<First, Second>& right) {
    return left.first < right.first ||
           (!(right.first < left.first) &&
            left.second < right.second);
}

template<class First, class Second>
_ADINKRA_NODISCARD constexpr bool
operator>(const pair<First, Second>& left,
          const pair<First, Second>& right) {
    return right < left;
}

template<class First, class Second>
_ADINKRA_NODISCARD constexpr bool
operator<=(const pair<First, Second>& left,
           const pair<First, Second>& right) {
    return !(right < left);
}

template<class First, class Second>
_ADINKRA_NODISCARD constexpr bool
operator>=(const pair<First, Second>& left,
           const pair<First, Second>& right) {
    return !(left < right);
}

template<class First, class Second>
_ADINKRA_NODISCARD constexpr auto
operator<=>(const pair<First, Second>& left,
            const pair<First, Second>& right)
    -> conditional_t<
        is_convertible_v<decltype(left.first <=> right.first),
                         decltype(left.second <=> right.second)>,
        decltype(left.second <=> right.second),
        decltype(left.first <=> right.first)> {
    using Comparison = conditional_t<
        is_convertible_v<decltype(left.first <=> right.first),
                         decltype(left.second <=> right.second)>,
        decltype(left.second <=> right.second),
        decltype(left.first <=> right.first)>;
    Comparison comparison = left.first <=> right.first;
    if (comparison != 0) {
        return comparison;
    }
    return left.second <=> right.second;
}

template<class First, class Second>
constexpr void swap(pair<First, Second>& left, pair<First, Second>& right)
    noexcept(noexcept(left.swap(right))) {
    left.swap(right);
}

template<size_t Index, class First, class Second>
constexpr conditional_t<Index == 0, First, Second>&
get(pair<First, Second>& value) noexcept {
    static_assert(Index < 2);
    if constexpr (Index == 0) {
        return value.first;
    } else {
        return value.second;
    }
}

template<size_t Index, class First, class Second>
constexpr const conditional_t<Index == 0, First, Second>&
get(const pair<First, Second>& value) noexcept {
    static_assert(Index < 2);
    if constexpr (Index == 0) {
        return value.first;
    } else {
        return value.second;
    }
}

template<size_t Index, class First, class Second>
constexpr conditional_t<Index == 0, First, Second>&&
get(pair<First, Second>&& value) noexcept {
    using Result = conditional_t<Index == 0, First, Second>&&;
    return static_cast<Result>(get<Index>(value));
}

template<size_t Index, class First, class Second>
constexpr const conditional_t<Index == 0, First, Second>&&
get(const pair<First, Second>&& value) noexcept {
    using Result =
        const conditional_t<Index == 0, First, Second>&&;
    return static_cast<Result>(get<Index>(value));
}

