template<class Left, class Right>
_ADINKRA_NODISCARD constexpr bool cmp_equal(
    Left left, Right right) noexcept {
    static_assert(is_integral_v<Left> && is_integral_v<Right>);
    if constexpr (is_signed_v<Left> == is_signed_v<Right>) {
        return left == right;
    } else if constexpr (is_signed_v<Left>) {
        return left >= 0 &&
            static_cast<make_unsigned_t<Left>>(left) == right;
    } else {
        return right >= 0 &&
            left == static_cast<make_unsigned_t<Right>>(right);
    }
}

template<class Left, class Right>
_ADINKRA_NODISCARD constexpr bool cmp_not_equal(
    Left left, Right right) noexcept {
    return !std::cmp_equal(left, right);
}

template<class Left, class Right>
_ADINKRA_NODISCARD constexpr bool cmp_less(
    Left left, Right right) noexcept {
    static_assert(is_integral_v<Left> && is_integral_v<Right>);
    if constexpr (is_signed_v<Left> == is_signed_v<Right>) {
        return left < right;
    } else if constexpr (is_signed_v<Left>) {
        return left < 0 ||
            static_cast<make_unsigned_t<Left>>(left) < right;
    } else {
        return right >= 0 &&
            left < static_cast<make_unsigned_t<Right>>(right);
    }
}

template<class Left, class Right>
_ADINKRA_NODISCARD constexpr bool cmp_greater(
    Left left, Right right) noexcept {
    return std::cmp_less(right, left);
}

template<class Left, class Right>
_ADINKRA_NODISCARD constexpr bool cmp_less_equal(
    Left left, Right right) noexcept {
    return !std::cmp_less(right, left);
}

template<class Left, class Right>
_ADINKRA_NODISCARD constexpr bool cmp_greater_equal(
    Left left, Right right) noexcept {
    return !std::cmp_less(left, right);
}

template<class Target, class Source>
_ADINKRA_NODISCARD constexpr bool in_range(Source value) noexcept {
    static_assert(is_integral_v<Target> && is_integral_v<Source>);
    return std::cmp_greater_equal(
               value, numeric_limits<Target>::min()) &&
           std::cmp_less_equal(
               value, numeric_limits<Target>::max());
}

template<class Type>
constexpr void swap(Type& left, Type& right)
    noexcept(is_nothrow_move_constructible_v<Type> &&
             is_nothrow_move_assignable_v<Type>) {
    Type temporary = std::move(left);
    left = std::move(right);
    right = std::move(temporary);
}

template<class Type, size_t Size>
constexpr void swap(Type (&left)[Size], Type (&right)[Size])
    noexcept(noexcept(swap(left[0], right[0]))) {
    for (size_t index = 0; index < Size; ++index) {
        swap(left[index], right[index]);
    }
}

template<class Type, class Other = Type>
constexpr Type exchange(Type& value, Other&& replacement)
    noexcept(is_nothrow_move_constructible_v<Type> &&
             is_nothrow_assignable_v<Type&, Other>) {
    Type previous = std::move(value);
    value = std::forward<Other>(replacement);
    return previous;
}

