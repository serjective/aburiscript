template<class Type>
class reference_wrapper {
public:
    using type = Type;

    constexpr reference_wrapper(Type& value) noexcept
        : pointer_(std::addressof(value)) {}
    reference_wrapper(Type&&) = delete;

    template<class Value>
        requires (!is_same_v<remove_cvref_t<Value>, reference_wrapper>) &&
                 requires(Value&& value) {
                     __functional_detail::reference_wrapper_target<Type>(
                         std::forward<Value>(value));
                 }
    constexpr reference_wrapper(Value&& value)
        noexcept(noexcept(
            __functional_detail::reference_wrapper_target<Type>(
                std::forward<Value>(value))))
        : pointer_(std::addressof(
              __functional_detail::reference_wrapper_target<Type>(
                  std::forward<Value>(value)))) {}

    template<class Other>
        requires is_convertible_v<Other*, Type*>
    constexpr reference_wrapper(
        const reference_wrapper<Other>& other) noexcept
        : pointer_(std::addressof(other.get())) {}

    constexpr operator Type&() const noexcept {
        return *pointer_;
    }

    _ADINKRA_NODISCARD constexpr Type& get() const noexcept {
        return *pointer_;
    }

    template<class... Arguments>
    constexpr invoke_result_t<Type&, Arguments...>
    operator()(Arguments&&... arguments) const
        noexcept(noexcept(std::invoke(
            get(), std::forward<Arguments>(arguments)...))) {
        return std::invoke(get(), std::forward<Arguments>(arguments)...);
    }

private:
    Type* pointer_;
};

