template<class Signature>
class function;

template<class Result, class... Arguments>
class function<Result(Arguments...)> {
    struct callable_base {
        virtual ~callable_base() = default;
        virtual callable_base* clone() const = 0;
        virtual Result call(Arguments&&... arguments) const = 0;
#if _ADINKRA_HAS_RTTI
        virtual const type_info& target_type() const noexcept = 0;
        virtual void* target(const type_info&) noexcept = 0;
        virtual const void* target(const type_info&) const noexcept = 0;
#endif
    };

    template<class Callable>
    struct callable final : callable_base {
        template<class Value>
        explicit callable(Value&& value) : value_(std::forward<Value>(value)) {}

        callable_base* clone() const override {
            return new callable(value_);
        }

        Result call(Arguments&&... arguments) const override {
            if constexpr (is_void_v<Result>) {
                std::invoke(value_, std::forward<Arguments>(arguments)...);
            } else {
                return std::invoke(
                    value_, std::forward<Arguments>(arguments)...);
            }
        }

#if _ADINKRA_HAS_RTTI
        const type_info& target_type() const noexcept override {
            return typeid(Callable);
        }

        void* target(const type_info& requested) noexcept override {
            return requested == typeid(Callable) ? std::addressof(value_)
                                                  : nullptr;
        }

        const void* target(const type_info& requested) const noexcept override {
            return requested == typeid(Callable) ? std::addressof(value_)
                                                  : nullptr;
        }
#endif

        mutable Callable value_;
    };

public:
    using result_type = Result;

    function() noexcept : callable_(nullptr) {}
    function(nullptr_t) noexcept : callable_(nullptr) {}

    function(const function& other)
        : callable_(other.callable_ == nullptr
                        ? nullptr
                        : other.callable_->clone()) {}

    function(function&& other) noexcept
        : callable_(exchange(other.callable_, nullptr)) {}

    template<class Callable>
        requires (!is_same_v<remove_cvref_t<Callable>, function>) &&
                 (!is_same_v<decay_t<Callable>, nullptr_t>) &&
                 is_invocable_r_v<
                     Result, decay_t<Callable>&, Arguments...> &&
                 is_copy_constructible_v<decay_t<Callable>>
    function(Callable&& value)
        : callable_(new callable<decay_t<Callable>>(
              std::forward<Callable>(value))) {}

    ~function() {
        delete callable_;
    }

    function& operator=(const function& other) {
        function replacement(other);
        swap(replacement);
        return *this;
    }

    function& operator=(function&& other) noexcept {
        function replacement(std::move(other));
        swap(replacement);
        return *this;
    }

    function& operator=(nullptr_t) noexcept {
        delete exchange(callable_, nullptr);
        return *this;
    }

    template<class Callable>
        requires is_invocable_r_v<
            Result, decay_t<Callable>&, Arguments...>
    function& operator=(Callable&& value) {
        function replacement(std::forward<Callable>(value));
        swap(replacement);
        return *this;
    }

    explicit operator bool() const noexcept {
        return callable_ != nullptr;
    }

    Result operator()(Arguments... arguments) const {
        if (callable_ == nullptr) {
            throw bad_function_call();
        }
        if constexpr (is_void_v<Result>) {
            callable_->call(std::forward<Arguments>(arguments)...);
        } else {
            return callable_->call(std::forward<Arguments>(arguments)...);
        }
    }

    void swap(function& other) noexcept {
        std::swap(callable_, other.callable_);
    }

#if _ADINKRA_HAS_RTTI
    const type_info& target_type() const noexcept {
        return callable_ == nullptr ? typeid(void)
                                    : callable_->target_type();
    }

    template<class Type>
    Type* target() noexcept {
        return callable_ == nullptr
            ? nullptr
            : static_cast<Type*>(callable_->target(typeid(Type)));
    }

    template<class Type>
    const Type* target() const noexcept {
        return callable_ == nullptr
            ? nullptr
            : static_cast<const Type*>(callable_->target(typeid(Type)));
    }
#endif

private:
    callable_base* callable_;
};

template<class Result, class... Arguments>
_ADINKRA_NODISCARD bool operator==(
    const function<Result(Arguments...)>& value,
    nullptr_t) noexcept {
    return !value;
}

template<class Result, class... Arguments>
void swap(function<Result(Arguments...)>& left,
          function<Result(Arguments...)>& right) noexcept {
    left.swap(right);
}

template<class Type>
struct hash;

template<class Type>
class shared_ptr;

namespace __functional_detail {

template<class Type>
struct scalar_hash {
    using argument_type = Type;
    using result_type = size_t;

    size_t operator()(Type value) const noexcept {
        if constexpr (is_pointer_v<Type>) {
            return static_cast<size_t>(
                reinterpret_cast<uintptr_t>(value) >> 4);
        } else if constexpr (is_same_v<Type, bool>) {
            return value ? size_t(1) : size_t(0);
        } else {
            using Unsigned = make_unsigned_t<Type>;
            Unsigned bits = static_cast<Unsigned>(value);
            if constexpr (sizeof(Unsigned) <= sizeof(size_t)) {
                return static_cast<size_t>(bits);
            } else {
                return static_cast<size_t>(
                    bits ^ (bits >> (sizeof(size_t) * 8)));
            }
        }
    }
};

template<class Type>
struct floating_hash {
    using argument_type = Type;
    using result_type = size_t;

    size_t operator()(Type value) const noexcept {
        if (value == Type(0)) {
            return 0;
        }
        const unsigned char* bytes =
            reinterpret_cast<const unsigned char*>(&value);
        size_t result =
            sizeof(size_t) == 8
                ? static_cast<size_t>(1469598103934665603ULL)
                : static_cast<size_t>(2166136261U);
        const size_t prime =
            sizeof(size_t) == 8
                ? static_cast<size_t>(1099511628211ULL)
                : static_cast<size_t>(16777619U);
        for (size_t index = 0; index < sizeof(Type); ++index) {
            result ^= static_cast<size_t>(bytes[index]);
            result *= prime;
        }
        return result;
    }
};

} // namespace __functional_detail

template<class Type>
struct hash {
    using argument_type = Type;
    using result_type = size_t;

    size_t operator()(Type value) const noexcept
        requires is_enum_v<Type> {
        using Underlying = underlying_type_t<Type>;
        return __functional_detail::scalar_hash<Underlying>{}(
            static_cast<Underlying>(value));
    }
};

#define _ADINKRA_HASH_SCALAR(Type) \
    template<> struct hash<Type> : __functional_detail::scalar_hash<Type> {}

_ADINKRA_HASH_SCALAR(bool);
_ADINKRA_HASH_SCALAR(char);
_ADINKRA_HASH_SCALAR(signed char);
_ADINKRA_HASH_SCALAR(unsigned char);
_ADINKRA_HASH_SCALAR(short);
_ADINKRA_HASH_SCALAR(unsigned short);
_ADINKRA_HASH_SCALAR(int);
_ADINKRA_HASH_SCALAR(unsigned int);
_ADINKRA_HASH_SCALAR(long);
_ADINKRA_HASH_SCALAR(unsigned long);
_ADINKRA_HASH_SCALAR(long long);
_ADINKRA_HASH_SCALAR(unsigned long long);
_ADINKRA_HASH_SCALAR(char16_t);
_ADINKRA_HASH_SCALAR(char32_t);

#undef _ADINKRA_HASH_SCALAR

template<>
struct hash<float> : __functional_detail::floating_hash<float> {};

template<>
struct hash<double> : __functional_detail::floating_hash<double> {};

template<>
struct hash<long double>
    : __functional_detail::floating_hash<long double> {};

template<class Type>
struct hash<Type*> : __functional_detail::scalar_hash<Type*> {};

template<class Type>
struct hash<shared_ptr<Type>> {
    using argument_type = shared_ptr<Type>;
    using result_type = size_t;

    size_t operator()(const shared_ptr<Type>& value) const noexcept {
        return hash<Type*>{}(value.get());
    }
};

