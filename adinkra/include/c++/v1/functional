namespace __functional_detail {

template<size_t Index, class First, class... Rest>
struct bind_type_at
    : bind_type_at<Index - 1, Rest...> {};

template<class First, class... Rest>
struct bind_type_at<0, First, Rest...> {
    using type = First;
};

template<size_t Index, class Type>
struct bind_leaf {
    template<class Value>
    explicit constexpr bind_leaf(Value&& input)
        : value(std::forward<Value>(input)) {}

    _ADINKRA_NO_UNIQUE_ADDRESS Type value;
};

template<class Sequence, class... Types>
struct bind_storage;

template<size_t... Indexes, class... Types>
struct bind_storage<index_sequence<Indexes...>, Types...>
    : bind_leaf<Indexes, Types>... {
    template<class... Values>
    explicit constexpr bind_storage(Values&&... values)
        : bind_leaf<Indexes, Types>(
              std::forward<Values>(values))... {}
};

template<size_t Index, size_t... Indexes, class... Types>
constexpr decltype(auto) bind_get(
    bind_storage<index_sequence<Indexes...>, Types...>& storage) {
    using Type = typename bind_type_at<Index, Types...>::type;
    return static_cast<bind_leaf<Index, Type>&>(storage).value;
}

template<size_t Index, size_t... Indexes, class... Types>
constexpr decltype(auto) bind_get(
    const bind_storage<index_sequence<Indexes...>, Types...>& storage) {
    using Type = typename bind_type_at<Index, Types...>::type;
    return static_cast<const bind_leaf<Index, Type>&>(storage).value;
}

template<size_t Index, class First, class... Rest>
constexpr decltype(auto) bind_call_argument(
    First&& first, Rest&&... rest) {
    if constexpr (Index == 0) {
        return std::forward<First>(first);
    } else {
        return bind_call_argument<Index - 1>(
            std::forward<Rest>(rest)...);
    }
}

template<class Type>
struct is_reference_wrapper : false_type {};

template<class Type>
struct is_reference_wrapper<reference_wrapper<Type>> : true_type {};

template<class Bound, class... CallArguments>
constexpr decltype(auto) resolve_bound(
    Bound&& bound, CallArguments&&... call_arguments) {
    using Decayed = decay_t<Bound>;
    constexpr int placeholder = is_placeholder_v<Decayed>;
    if constexpr (placeholder != 0) {
        return bind_call_argument<
            static_cast<size_t>(placeholder - 1)>(
            std::forward<CallArguments>(call_arguments)...);
    } else if constexpr (is_reference_wrapper<Decayed>::value) {
        return bound.get();
    } else if constexpr (is_bind_expression_v<Decayed>) {
        return std::forward<Bound>(bound)(
            std::forward<CallArguments>(call_arguments)...);
    } else {
        return std::forward<Bound>(bound);
    }
}

template<class Function, class... BoundArguments>
class bind_expression {
    using storage_type = bind_storage<
        index_sequence_for<BoundArguments...>,
        BoundArguments...>;

    template<class Self, size_t... Indexes, class... CallArguments>
    static constexpr auto invoke_impl(
        Self&& self, index_sequence<Indexes...>,
        CallArguments&&... arguments)
        -> decltype(std::invoke(
            std::forward<Self>(self).function_,
            resolve_bound(
                bind_get<Indexes>(
                    std::forward<Self>(self).arguments_),
                std::forward<CallArguments>(arguments)...)...)) {
        return std::invoke(
            std::forward<Self>(self).function_,
            resolve_bound(
                bind_get<Indexes>(
                    std::forward<Self>(self).arguments_),
                std::forward<CallArguments>(arguments)...)...);
    }

public:
    constexpr bind_expression(const bind_expression&) = default;
    constexpr bind_expression(bind_expression&&) = default;
    constexpr bind_expression& operator=(
        const bind_expression&) = default;
    constexpr bind_expression& operator=(
        bind_expression&&) = default;

    template<class FunctionValue, class... ArgumentValues>
        requires (
            !is_same_v<remove_cvref_t<FunctionValue>, bind_expression> &&
            sizeof...(ArgumentValues) == sizeof...(BoundArguments))
    explicit constexpr bind_expression(
        FunctionValue&& function, ArgumentValues&&... arguments)
        : function_(std::forward<FunctionValue>(function)),
          arguments_(std::forward<ArgumentValues>(arguments)...) {}

    template<class... CallArguments>
    constexpr auto operator()(CallArguments&&... arguments)
        -> decltype(invoke_impl(
            *this, index_sequence_for<BoundArguments...>{},
            std::forward<CallArguments>(arguments)...)) {
        return invoke_impl(
            *this, index_sequence_for<BoundArguments...>{},
            std::forward<CallArguments>(arguments)...);
    }

    template<class... CallArguments>
    constexpr auto operator()(CallArguments&&... arguments) const
        -> decltype(invoke_impl(
            *this, index_sequence_for<BoundArguments...>{},
            std::forward<CallArguments>(arguments)...)) {
        return invoke_impl(
            *this, index_sequence_for<BoundArguments...>{},
            std::forward<CallArguments>(arguments)...);
    }

private:
    _ADINKRA_NO_UNIQUE_ADDRESS Function function_;
    _ADINKRA_NO_UNIQUE_ADDRESS storage_type arguments_;
};

} // namespace __functional_detail

template<class Function, class... Arguments>
struct is_bind_expression<
    __functional_detail::bind_expression<Function, Arguments...>>
    : true_type {};

template<class Function, class... Arguments>
_ADINKRA_NODISCARD constexpr auto
bind(Function&& function, Arguments&&... arguments) {
    using result_type = __functional_detail::bind_expression<
        decay_t<Function>, decay_t<Arguments>...>;
    return result_type(
        std::forward<Function>(function),
        std::forward<Arguments>(arguments)...);
}

template<class Predicate>
class __not_fn {
public:
    template<class Value>
    explicit constexpr __not_fn(Value&& predicate)
        : predicate_(std::forward<Value>(predicate)) {}

    template<class... Arguments>
    constexpr bool operator()(Arguments&&... arguments) &
        noexcept(noexcept(!std::invoke(
            predicate_, std::forward<Arguments>(arguments)...))) {
        return !std::invoke(
            predicate_, std::forward<Arguments>(arguments)...);
    }

    template<class... Arguments>
    constexpr bool operator()(Arguments&&... arguments) const&
        noexcept(noexcept(!std::invoke(
            predicate_, std::forward<Arguments>(arguments)...))) {
        return !std::invoke(
            predicate_, std::forward<Arguments>(arguments)...);
    }

    template<class... Arguments>
    constexpr bool operator()(Arguments&&... arguments) &&
        noexcept(noexcept(!std::invoke(
            std::move(predicate_),
            std::forward<Arguments>(arguments)...))) {
        return !std::invoke(
            std::move(predicate_),
            std::forward<Arguments>(arguments)...);
    }

private:
    Predicate predicate_;
};

template<class Predicate>
_ADINKRA_NODISCARD constexpr auto not_fn(Predicate&& predicate) {
    return __not_fn<decay_t<Predicate>>(
        std::forward<Predicate>(predicate));
}

