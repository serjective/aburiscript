namespace __functional_detail {

template<class Member>
struct member_pointer_class;

template<class Member, class Class>
struct member_pointer_class<Member Class::*> {
    using type = Class;
};

template<class Member, class Object>
    requires is_base_of_v<
        typename member_pointer_class<decay_t<Member>>::type,
        decay_t<Object>>
constexpr auto member_object(Member member, Object&& object)
    -> decltype(std::forward<Object>(object).*member) {
    return std::forward<Object>(object).*member;
}

template<class Member, class Object>
    requires (
        !is_base_of_v<
            typename member_pointer_class<decay_t<Member>>::type,
            decay_t<Object>> &&
        requires {
            declval<Object>().get().*declval<Member>();
        })
constexpr auto member_object(Member member, Object&& object)
    -> decltype(object.get().*member) {
    return object.get().*member;
}

template<class Member, class Object>
    requires (
        !is_base_of_v<
            typename member_pointer_class<decay_t<Member>>::type,
            decay_t<Object>> &&
        !requires {
            declval<Object>().get().*declval<Member>();
        } &&
        requires {
            (*declval<Object>()).*declval<Member>();
        })
constexpr auto member_object(Member member, Object&& object)
    -> decltype((*std::forward<Object>(object)).*member) {
    return (*std::forward<Object>(object)).*member;
}

template<class Member, class Object, class... Arguments>
    requires is_base_of_v<
        typename member_pointer_class<decay_t<Member>>::type,
        decay_t<Object>>
constexpr auto invoke_member_function(
    Member&& member, Object&& object, Arguments&&... arguments)
    -> decltype((std::forward<Object>(object).*member)(
        std::forward<Arguments>(arguments)...)) {
    return (std::forward<Object>(object).*member)(
        std::forward<Arguments>(arguments)...);
}

template<class Member, class Object, class... Arguments>
    requires (
        !is_base_of_v<
            typename member_pointer_class<decay_t<Member>>::type,
            decay_t<Object>> &&
        requires {
            (declval<Object>().get().*declval<Member>())(
                declval<Arguments>()...);
        })
constexpr auto invoke_member_function(
    Member&& member, Object&& object, Arguments&&... arguments)
    -> decltype((object.get().*member)(
        std::forward<Arguments>(arguments)...)) {
    return (object.get().*member)(
        std::forward<Arguments>(arguments)...);
}

template<class Member, class Object, class... Arguments>
    requires (
        !is_base_of_v<
            typename member_pointer_class<decay_t<Member>>::type,
            decay_t<Object>> &&
        !requires {
            (declval<Object>().get().*declval<Member>())(
                declval<Arguments>()...);
        } &&
        requires {
            ((*declval<Object>()).*declval<Member>())(
                declval<Arguments>()...);
        })
constexpr auto invoke_member_function(
    Member&& member, Object&& object, Arguments&&... arguments)
    -> decltype(((*std::forward<Object>(object)).*member)(
        std::forward<Arguments>(arguments)...)) {
    return ((*std::forward<Object>(object)).*member)(
        std::forward<Arguments>(arguments)...);
}

} // namespace __functional_detail

template<class Function, class Object, class... Arguments>
    requires (
        is_member_function_pointer_v<decay_t<Function>> &&
        requires {
            __functional_detail::invoke_member_function(
                declval<Function>(), declval<Object>(),
                declval<Arguments>()...);
        })
constexpr decltype(auto) invoke(
    Function&& function, Object&& object, Arguments&&... arguments) {
    return __functional_detail::invoke_member_function(
        std::forward<Function>(function),
        std::forward<Object>(object),
        std::forward<Arguments>(arguments)...);
}

template<class Function, class Object>
    requires (
        is_member_object_pointer_v<decay_t<Function>> &&
        requires {
            __functional_detail::member_object(
                declval<Function>(), declval<Object>());
        })
constexpr decltype(auto) invoke(Function&& function, Object&& object) {
    return __functional_detail::member_object(
        std::forward<Function>(function),
        std::forward<Object>(object));
}

template<class Function, class... Arguments>
    requires (
        !is_member_pointer_v<decay_t<Function>> &&
        requires(Function&& function, Arguments&&... arguments) {
            std::forward<Function>(function)(
                std::forward<Arguments>(arguments)...);
        })
constexpr auto invoke(
    Function&& function, Arguments&&... arguments)
    -> decltype(
        std::forward<Function>(function)(
            std::forward<Arguments>(arguments)...)) {
    return std::forward<Function>(function)(
        std::forward<Arguments>(arguments)...);
}

template<class Member>
class __mem_fn {
public:
    explicit constexpr __mem_fn(Member member) noexcept
        : member_(member) {}

    template<class... Arguments>
    constexpr decltype(auto) operator()(Arguments&&... arguments) const
        noexcept(noexcept(std::invoke(
            member_, std::forward<Arguments>(arguments)...))) {
        return std::invoke(
            member_, std::forward<Arguments>(arguments)...);
    }

private:
    Member member_;
};

template<class Member>
    requires is_member_pointer_v<Member>
_ADINKRA_NODISCARD constexpr __mem_fn<Member>
mem_fn(Member member) noexcept {
    return __mem_fn<Member>(member);
}

