#ifndef ADINKRA_CSTDDEF
#define ADINKRA_CSTDDEF

#include <__adinkra/config>
#include <stddef.h>

#ifndef __cpp_lib_byte
#define __cpp_lib_byte 201603L
#endif

_ADINKRA_BEGIN_NAMESPACE_STD

using ::max_align_t;
using ::ptrdiff_t;
using ::size_t;

using nullptr_t = decltype(nullptr);

enum class byte : unsigned char {};

template<class IntegerType>
    requires __is_integral(IntegerType)
_ADINKRA_NODISCARD constexpr IntegerType to_integer(byte value) noexcept {
    return static_cast<IntegerType>(value);
}

_ADINKRA_NODISCARD constexpr byte operator|(byte left, byte right) noexcept {
    return static_cast<byte>(
        static_cast<unsigned char>(left) | static_cast<unsigned char>(right));
}

_ADINKRA_NODISCARD constexpr byte operator&(byte left, byte right) noexcept {
    return static_cast<byte>(
        static_cast<unsigned char>(left) & static_cast<unsigned char>(right));
}

_ADINKRA_NODISCARD constexpr byte operator^(byte left, byte right) noexcept {
    return static_cast<byte>(
        static_cast<unsigned char>(left) ^ static_cast<unsigned char>(right));
}

_ADINKRA_NODISCARD constexpr byte operator~(byte value) noexcept {
    return static_cast<byte>(~static_cast<unsigned char>(value));
}

template<class IntegerType>
    requires __is_integral(IntegerType)
_ADINKRA_NODISCARD constexpr byte operator<<(byte value, IntegerType shift) noexcept {
    return static_cast<byte>(
        static_cast<unsigned int>(static_cast<unsigned char>(value)) << shift);
}

template<class IntegerType>
    requires __is_integral(IntegerType)
_ADINKRA_NODISCARD constexpr byte operator>>(byte value, IntegerType shift) noexcept {
    return static_cast<byte>(
        static_cast<unsigned int>(static_cast<unsigned char>(value)) >> shift);
}

constexpr byte& operator|=(byte& left, byte right) noexcept {
    return left = left | right;
}

constexpr byte& operator&=(byte& left, byte right) noexcept {
    return left = left & right;
}

constexpr byte& operator^=(byte& left, byte right) noexcept {
    return left = left ^ right;
}

template<class IntegerType>
    requires __is_integral(IntegerType)
constexpr byte& operator<<=(byte& value, IntegerType shift) noexcept {
    return value = value << shift;
}

template<class IntegerType>
    requires __is_integral(IntegerType)
constexpr byte& operator>>=(byte& value, IntegerType shift) noexcept {
    return value = value >> shift;
}

_ADINKRA_END_NAMESPACE_STD

#endif
