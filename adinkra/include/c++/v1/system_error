template<class Type>
struct is_error_condition_enum : false_type {};

template<class Type>
inline constexpr bool is_error_code_enum_v =
    is_error_code_enum<Type>::value;

template<class Type>
inline constexpr bool is_error_condition_enum_v =
    is_error_condition_enum<Type>::value;

