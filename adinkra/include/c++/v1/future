template<class Type>
class future {
public:
    constexpr future() noexcept = default;

    future(future&&) noexcept = default;
    future& operator=(future&&) noexcept = default;

    future(const future&) = delete;
    future& operator=(const future&) = delete;

    bool valid() const noexcept {
        return static_cast<bool>(state_);
    }

    Type get() {
        require_state();
        shared_ptr<__future_detail::state<Type>> state =
            std::move(state_);
        state->wait();
        if (state->exception) {
            rethrow_exception(state->exception);
        }
        return std::move(state->value());
    }

    void wait() const {
        require_state();
        state_->wait();
    }

    template<class Representation, class Period>
    future_status wait_for(
        const chrono::duration<Representation, Period>& duration) const {
        require_state();
        return state_->wait_for(duration);
    }

    template<class Clock, class Duration>
    future_status wait_until(
        const chrono::time_point<Clock, Duration>& deadline) const {
        return wait_for(deadline - Clock::now());
    }

    shared_future<Type> share() noexcept;

private:
    explicit future(
        shared_ptr<__future_detail::state<Type>> state) noexcept
        : state_(std::move(state)) {}

    shared_ptr<__future_detail::state<Type>> state_;

    void require_state() const {
        if (!state_) {
            throw future_error(future_errc::no_state);
        }
    }

    friend class promise<Type>;
    friend class shared_future<Type>;
};

