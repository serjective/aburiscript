template<class Type>
shared_future<Type> future<Type>::share() noexcept {
    return shared_future<Type>(std::move(state_));
}

inline shared_future<void> future<void>::share() noexcept {
    return shared_future<void>(std::move(state_));
}

template<class Type>
class promise {
public:
    promise()
        : state_(make_shared<__future_detail::state<Type>>()) {}

    template<class Allocator>
    promise(allocator_arg_t, const Allocator&)
        : promise() {}

    promise(promise&&) noexcept = default;
    promise& operator=(promise&&) noexcept = default;

    promise(const promise&) = delete;
    promise& operator=(const promise&) = delete;

    ~promise() {
        abandon();
    }

    future<Type> get_future() {
        require_state();
        if (retrieved_) {
            throw future_error(future_errc::future_already_retrieved);
        }
        retrieved_ = true;
        return future<Type>(state_);
    }

    void set_value(const Type& value) {
        require_state();
        state_->set_value(value);
    }

    void set_value(Type&& value) {
        require_state();
        state_->set_value(std::move(value));
    }

    void set_exception(exception_ptr value) {
        require_state();
        state_->set_exception(value);
    }

    void swap(promise& other) noexcept {
        state_.swap(other.state_);
        std::swap(retrieved_, other.retrieved_);
    }

private:
    shared_ptr<__future_detail::state<Type>> state_;
    bool retrieved_ = false;

    void require_state() const {
        if (!state_) {
            throw future_error(future_errc::no_state);
        }
    }

    void abandon() noexcept {
        if (!state_) {
            return;
        }
        try {
            lock_guard<mutex> lock(state_->mutex_value);
            if (!state_->ready) {
                state_->exception = make_exception_ptr(
                    future_error(future_errc::broken_promise));
                state_->ready = true;
                state_->condition.notify_all();
            }
        } catch (...) {
        }
    }
};

