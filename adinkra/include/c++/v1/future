template<class Type>
void swap(promise<Type>& left, promise<Type>& right) noexcept {
    left.swap(right);
}

template<class Result, class... Arguments>
class packaged_task<Result(Arguments...)> {
    class callable_base {
    public:
        virtual ~callable_base() = default;
        virtual Result invoke(Arguments&&... arguments) = 0;
    };

    template<class Function>
    class callable final : public callable_base {
    public:
        explicit callable(Function&& function)
            : function_(std::move(function)) {}

        Result invoke(Arguments&&... arguments) override {
            if constexpr (is_void_v<Result>) {
                std::invoke(
                    function_,
                    std::forward<Arguments>(arguments)...);
            } else {
                return std::invoke(
                    function_,
                    std::forward<Arguments>(arguments)...);
            }
        }

    private:
        Function function_;
    };

public:
    packaged_task() noexcept = default;

    template<class Function>
        requires (!is_same_v<remove_cvref_t<Function>, packaged_task>)
    explicit packaged_task(Function&& function)
        : callable_(make_unique<callable<decay_t<Function>>>(
              std::forward<Function>(function))) {}

    packaged_task(packaged_task&&) noexcept = default;
    packaged_task& operator=(packaged_task&&) noexcept = default;

    packaged_task(const packaged_task&) = delete;
    packaged_task& operator=(const packaged_task&) = delete;

    bool valid() const noexcept {
        return static_cast<bool>(callable_);
    }

    future<Result> get_future() {
        require_state();
        return promise_.get_future();
    }

    void operator()(Arguments... arguments) {
        require_state();
        try {
            if constexpr (is_void_v<Result>) {
                callable_->invoke(
                    std::forward<Arguments>(arguments)...);
                promise_.set_value();
            } else {
                promise_.set_value(callable_->invoke(
                    std::forward<Arguments>(arguments)...));
            }
        } catch (...) {
            promise_.set_exception(current_exception());
        }
    }

private:
    unique_ptr<callable_base> callable_;
    promise<Result> promise_;

    void require_state() const {
        if (!callable_) {
            throw future_error(future_errc::no_state);
        }
    }
};

template<class Function, class... Arguments>
auto async(launch, Function&& function, Arguments&&... arguments)
    -> future<invoke_result_t<decay_t<Function>, decay_t<Arguments>...>> {
    using Result =
        invoke_result_t<decay_t<Function>, decay_t<Arguments>...>;
    packaged_task<Result()> task(
        [
            function_value = decay_t<Function>(
                std::forward<Function>(function)),
            arguments_value = tuple<decay_t<Arguments>...>(
                std::forward<Arguments>(arguments)...)
        ]() mutable -> Result {
            return std::apply(
                [&function_value](auto&... values) -> Result {
                    return std::invoke(
                        function_value, std::move(values)...);
                },
                arguments_value);
        });
    future<Result> result = task.get_future();
    thread(std::move(task)).detach();
    return result;
}

template<class Function, class... Arguments>
auto async(Function&& function, Arguments&&... arguments)
    -> future<invoke_result_t<decay_t<Function>, decay_t<Arguments>...>> {
    return std::async(
        launch::async,
        std::forward<Function>(function),
        std::forward<Arguments>(arguments)...);
}

