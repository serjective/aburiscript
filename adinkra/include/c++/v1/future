enum class future_status {
    ready,
    timeout,
    deferred
};

enum class launch {
    async = 1,
    deferred = 2
};

constexpr launch operator|(launch left, launch right) noexcept {
    return static_cast<launch>(
        static_cast<int>(left) | static_cast<int>(right));
}

constexpr launch operator&(launch left, launch right) noexcept {
    return static_cast<launch>(
        static_cast<int>(left) & static_cast<int>(right));
}

enum class future_errc {
    broken_promise = 1,
    future_already_retrieved,
    promise_already_satisfied,
    no_state
};

class future_error : public logic_error {
public:
    explicit future_error(future_errc value)
        : logic_error(message(value)), value_(value) {}

    future_errc code() const noexcept {
        return value_;
    }

private:
    future_errc value_;

    static const char* message(future_errc value) noexcept {
        switch (value) {
        case future_errc::broken_promise:
            return "broken promise";
        case future_errc::future_already_retrieved:
            return "future already retrieved";
        case future_errc::promise_already_satisfied:
            return "promise already satisfied";
        case future_errc::no_state:
            return "future has no state";
        }
        return "future error";
    }
};

namespace __future_detail {

class state_base {
public:
    mutable mutex mutex_value;
    mutable condition_variable condition;
    bool ready = false;
    exception_ptr exception;

    virtual ~state_base() = default;

    void wait() const {
        unique_lock<mutex> lock(mutex_value);
        condition.wait(lock, [this] {
            return ready;
        });
    }

    template<class Representation, class Period>
    future_status wait_for(
        const chrono::duration<Representation, Period>& duration) const {
        unique_lock<mutex> lock(mutex_value);
        return condition.wait_for(lock, duration, [this] {
            return ready;
        }) ? future_status::ready : future_status::timeout;
    }

    void set_exception(exception_ptr value) {
        lock_guard<mutex> lock(mutex_value);
        if (ready) {
            throw future_error(future_errc::promise_already_satisfied);
        }
        exception = value;
        ready = true;
        condition.notify_all();
    }
};

template<class Type>
class state final : public state_base {
public:
    alignas(Type) unsigned char storage[sizeof(Type)];
    bool engaged = false;

    ~state() override {
        if (engaged) {
            value().~Type();
        }
    }

    Type& value() noexcept {
        return *std::launder(reinterpret_cast<Type*>(storage));
    }

    template<class Value>
    void set_value(Value&& input) {
        lock_guard<mutex> lock(this->mutex_value);
        if (this->ready) {
            throw future_error(future_errc::promise_already_satisfied);
        }
        ::new (static_cast<void*>(storage))
            Type(std::forward<Value>(input));
        engaged = true;
        this->ready = true;
        this->condition.notify_all();
    }
};

template<>
class state<void> final : public state_base {
public:
    void set_value() {
        lock_guard<mutex> lock(mutex_value);
        if (ready) {
            throw future_error(future_errc::promise_already_satisfied);
        }
        ready = true;
        condition.notify_all();
    }
};

} // namespace __future_detail

