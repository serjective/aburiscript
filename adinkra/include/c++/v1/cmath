template<class From, class To>
    requires (
        (is_integral_v<From> || is_floating_point_v<From>) &&
        (is_integral_v<To> || is_floating_point_v<To>) &&
        !(is_same_v<remove_cv_t<From>, float> &&
          is_same_v<remove_cv_t<To>, float>) &&
        !(is_same_v<remove_cv_t<From>, double> &&
          is_same_v<remove_cv_t<To>, double>) &&
        !(is_same_v<remove_cv_t<From>, long double> &&
          is_same_v<remove_cv_t<To>, long double>))
inline auto nextafter(From from, To to) noexcept {
    using result = conditional_t<
        is_integral_v<From> && is_integral_v<To>,
        double,
        common_type_t<From, To>>;
    return std::nextafter(
        static_cast<result>(from), static_cast<result>(to));
}

template<class Floating>
constexpr Floating __lerp(
    Floating left, Floating right, Floating amount) noexcept {
    if ((left <= 0 && right >= 0) ||
        (left >= 0 && right <= 0)) {
        return amount * right + (1 - amount) * left;
    }
    if (amount == 1) {
        return right;
    }
    const Floating result = left + amount * (right - left);
    if ((amount > 1) == (right > left)) {
        return right < result ? result : right;
    }
    return result < right ? result : right;
}

inline constexpr float lerp(
    float left, float right, float amount) noexcept {
    return std::__lerp(left, right, amount);
}

inline constexpr double lerp(
    double left, double right, double amount) noexcept {
    return std::__lerp(left, right, amount);
}

inline constexpr long double lerp(
    long double left, long double right,
    long double amount) noexcept {
    return std::__lerp(left, right, amount);
}

template<class Left, class Right, class Amount>
    requires (
        is_arithmetic_v<Left> &&
        is_arithmetic_v<Right> &&
        is_arithmetic_v<Amount> &&
        !(is_same_v<remove_cv_t<Left>, remove_cv_t<Right>> &&
          is_same_v<remove_cv_t<Left>, remove_cv_t<Amount>>))
inline constexpr auto lerp(
    Left left, Right right, Amount amount) noexcept {
    using result = conditional_t<
        is_integral_v<Left> &&
        is_integral_v<Right> &&
        is_integral_v<Amount>,
        double,
        common_type_t<Left, Right, Amount>>;
    return std::__lerp(
        static_cast<result>(left),
        static_cast<result>(right),
        static_cast<result>(amount));
}

template<class Type>
    requires is_integral_v<Type> && is_signed_v<Type>
constexpr Type abs(Type value) noexcept {
    return value < 0 ? static_cast<Type>(-value) : value;
}

template<class Type>
    requires is_integral_v<Type>
constexpr bool isinf(Type value) noexcept {
    return __builtin_isinf(static_cast<double>(value));
}

inline constexpr bool isinf(float value) noexcept {
    return __builtin_isinf(value);
}

inline constexpr bool isinf(double value) noexcept {
    return __builtin_isinf(value);
}

inline constexpr bool isinf(long double value) noexcept {
    return __builtin_isinf(value);
}

template<class Type>
    requires (is_integral_v<Type> || is_floating_point_v<Type>)
constexpr bool isfinite(Type value) noexcept {
    return __builtin_isfinite(value);
}

inline constexpr bool isfinite(float value) noexcept {
    return __builtin_isfinite(value);
}

inline constexpr bool isfinite(double value) noexcept {
    return __builtin_isfinite(value);
}

inline constexpr bool isfinite(long double value) noexcept {
    return __builtin_isfinite(value);
}

template<class Type>
    requires is_integral_v<Type>
constexpr bool isnan(Type) noexcept {
    return false;
}

inline constexpr bool isnan(float value) noexcept {
    return __builtin_isnan(value);
}

inline constexpr bool isnan(double value) noexcept {
    return __builtin_isnan(value);
}

inline constexpr bool isnan(long double value) noexcept {
    return __builtin_isnan(value);
}

template<class Type>
    requires (
        !is_integral_v<Type> &&
        !is_same_v<remove_cv_t<Type>, float> &&
        !is_same_v<remove_cv_t<Type>, double> &&
        !is_same_v<remove_cv_t<Type>, long double> &&
        requires(Type value) {
            __builtin_isnan(value);
        })
inline constexpr bool isnan(Type value) noexcept {
    return __builtin_isnan(value);
}

template<class Type>
    requires (is_integral_v<Type> || is_floating_point_v<Type>)
constexpr bool isnormal(Type value) noexcept {
    return __builtin_isnormal(value);
}

template<class Left, class Right>
    requires (
        (is_integral_v<Left> || is_floating_point_v<Left>) &&
        (is_integral_v<Right> || is_floating_point_v<Right>))
constexpr bool isunordered(Left left, Right right) noexcept {
    return __builtin_isunordered(left, right);
}

template<class Type>
    requires (is_integral_v<Type> || is_floating_point_v<Type>)
constexpr int fpclassify(Type value) noexcept {
    return __builtin_fpclassify(
        FP_NAN, FP_INFINITE, FP_NORMAL, FP_SUBNORMAL, FP_ZERO,
        value);
}

template<class Type>
    requires (is_integral_v<Type> || is_floating_point_v<Type>)
constexpr bool signbit(Type value) noexcept {
    return __builtin_signbit(value);
}
