#define ADINKRA_MATH_MIXED_BINARY_OVERLOAD(function)                    \
    template<class Left, class Right>                                     \
        requires (                                                        \
            is_arithmetic_v<Left> && is_arithmetic_v<Right> &&            \
            !(is_integral_v<Left> && is_integral_v<Right>) &&             \
            !is_same_v<remove_cv_t<Left>, remove_cv_t<Right>>)            \
    inline auto function(Left left, Right right) noexcept {                \
        using result = conditional_t<                                     \
            is_integral_v<Left> && is_integral_v<Right>,                  \
            double, common_type_t<Left, Right>>;                          \
        return std::function(                                             \
            static_cast<result>(left), static_cast<result>(right));       \
    }

