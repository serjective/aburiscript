inline float hypot(
    float first, float second, float third) noexcept {
    return std::hypot(std::hypot(first, second), third);
}

inline double hypot(
    double first, double second, double third) noexcept {
    return std::hypot(std::hypot(first, second), third);
}

inline long double hypot(
    long double first,
    long double second,
    long double third) noexcept {
    return std::hypot(std::hypot(first, second), third);
}

template<class First, class Second, class Third>
    requires (
        is_arithmetic_v<First> &&
        is_arithmetic_v<Second> &&
        is_arithmetic_v<Third>)
inline auto hypot(
    First first, Second second, Third third) noexcept {
    using result = conditional_t<
        is_integral_v<First> &&
        is_integral_v<Second> &&
        is_integral_v<Third>,
        double,
        common_type_t<First, Second, Third>>;
    return std::hypot(
        static_cast<result>(first),
        static_cast<result>(second),
        static_cast<result>(third));
}

