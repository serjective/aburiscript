#ifndef ADINKRA_FLOAT_ABS_DEFINED
#define ADINKRA_FLOAT_ABS_DEFINED
inline constexpr float abs(float value) noexcept {
    return __builtin_fabsf(value);
}

inline constexpr double abs(double value) noexcept {
    return __builtin_fabs(value);
}

inline constexpr long double abs(long double value) noexcept {
    return __builtin_fabsl(value);
}
