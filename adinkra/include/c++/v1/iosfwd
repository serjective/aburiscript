using streamoff = long long;
using streamsize = ptrdiff_t;
using streampos = long long;
using wstreampos = long long;

template<class State>
class fpos {
public:
    constexpr fpos() : offset_(0), state_() {}
    constexpr fpos(streamoff offset) : offset_(offset), state_() {}

    constexpr operator streamoff() const { return offset_; }
    constexpr State state() const { return state_; }
    constexpr void state(State value) { state_ = value; }

    constexpr fpos& operator+=(streamoff offset) {
        offset_ += offset;
        return *this;
    }
    constexpr fpos& operator-=(streamoff offset) {
        offset_ -= offset;
        return *this;
    }

private:
    streamoff offset_;
    State state_;
};

