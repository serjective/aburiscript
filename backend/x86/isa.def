

#ifndef ABURI_X86_ISA
#error "define ABURI_X86_ISA before including isa.def"
#endif

#define ABURI_X86_GRP1(Stem, stem, base, ext)                                 \
    ABURI_X86_ISA(Stem##BAcc, stem "b", Plain, 0, (base) + 0x04,              \
                  (Imm8u, Acc8), RF_NONE, 0)                                  \
    ABURI_X86_ISA(Stem##BImm, stem "b", Modrm, 0, 0x80, (Imm8u, Rm8),         \
                  RF_NONE, ext)                                               \
    ABURI_X86_ISA(Stem##BMr, stem "b", Modrm, 0, (base) + 0x00, (Gpr8, Rm8),  \
                  RF_NONE, 0)                                                 \
    ABURI_X86_ISA(Stem##BRm, stem "b", Modrm, 0, (base) + 0x02, (Mem, Gpr8),  \
                  RF_NONE, 0)                                                 \
    ABURI_X86_ISA(Stem##WImm8, stem "w", Modrm, 0x66, 0x83, (Imm8s, Rm16),    \
                  RF_NONE, ext)                                               \
    ABURI_X86_ISA(Stem##WAcc, stem "w", Plain, 0x66, (base) + 0x05,           \
                  (Imm16, Acc16), RF_NONE, 0)                                 \
    ABURI_X86_ISA(Stem##WImm, stem "w", Modrm, 0x66, 0x81, (Imm16, Rm16),     \
                  RF_NONE, ext)                                               \
    ABURI_X86_ISA(Stem##WMr, stem "w", Modrm, 0x66, (base) + 0x01,            \
                  (Gpr16, Rm16), RF_NONE, 0)                                  \
    ABURI_X86_ISA(Stem##WRm, stem "w", Modrm, 0x66, (base) + 0x03,            \
                  (Mem, Gpr16), RF_NONE, 0)                                   \
    ABURI_X86_ISA(Stem##LImm8, stem "l", Modrm, 0, 0x83, (Imm8s, Rm32),       \
                  RF_NONE, ext)                                               \
    ABURI_X86_ISA(Stem##LAcc, stem "l", Plain, 0, (base) + 0x05,              \
                  (Imm32, Acc32), RF_NONE, 0)                                 \
    ABURI_X86_ISA(Stem##LImm, stem "l", Modrm, 0, 0x81, (Imm32, Rm32),        \
                  RF_NONE, ext)                                               \
    ABURI_X86_ISA(Stem##LMr, stem "l", Modrm, 0, (base) + 0x01,               \
                  (Gpr32, Rm32), RF_NONE, 0)                                  \
    ABURI_X86_ISA(Stem##LRm, stem "l", Modrm, 0, (base) + 0x03,               \
                  (Mem, Gpr32), RF_NONE, 0)                                   \
    ABURI_X86_ISA(Stem##QImm8, stem "q", Modrm, 0, 0x83, (Imm8s, Rm64), RF_W, \
                  ext)                                                        \
    ABURI_X86_ISA(Stem##QAcc, stem "q", Plain, 0, (base) + 0x05,              \
                  (Imm32, Acc64), RF_W, 0)                                    \
    ABURI_X86_ISA(Stem##QImm, stem "q", Modrm, 0, 0x81, (Imm32, Rm64), RF_W,  \
                  ext)                                                        \
    ABURI_X86_ISA(Stem##QMr, stem "q", Modrm, 0, (base) + 0x01, (Gpr64, Rm64),\
                  RF_W, 0)                                                    \
    ABURI_X86_ISA(Stem##QRm, stem "q", Modrm, 0, (base) + 0x03, (Mem, Gpr64), \
                  RF_W, 0)

#define ABURI_X86_SHIFT(Stem, stem, ext)                                      \
    ABURI_X86_ISA(Stem##B1, stem "b", Modrm, 0, 0xD0, (ImmOne, Rm8), RF_NONE, \
                  ext)                                                        \
    ABURI_X86_ISA(Stem##BI, stem "b", Modrm, 0, 0xC0, (Imm8u, Rm8), RF_NONE,  \
                  ext)                                                        \
    ABURI_X86_ISA(Stem##BCl, stem "b", Modrm, 0, 0xD2, (Cl, Rm8), RF_NONE,    \
                  ext)                                                        \
    ABURI_X86_ISA(Stem##W1, stem "w", Modrm, 0x66, 0xD1, (ImmOne, Rm16),      \
                  RF_NONE, ext)                                               \
    ABURI_X86_ISA(Stem##WI, stem "w", Modrm, 0x66, 0xC1, (Imm8u, Rm16),       \
                  RF_NONE, ext)                                               \
    ABURI_X86_ISA(Stem##WCl, stem "w", Modrm, 0x66, 0xD3, (Cl, Rm16),         \
                  RF_NONE, ext)                                               \
    ABURI_X86_ISA(Stem##L1, stem "l", Modrm, 0, 0xD1, (ImmOne, Rm32),         \
                  RF_NONE, ext)                                               \
    ABURI_X86_ISA(Stem##LI, stem "l", Modrm, 0, 0xC1, (Imm8u, Rm32), RF_NONE, \
                  ext)                                                        \
    ABURI_X86_ISA(Stem##LCl, stem "l", Modrm, 0, 0xD3, (Cl, Rm32), RF_NONE,   \
                  ext)                                                        \
    ABURI_X86_ISA(Stem##Q1, stem "q", Modrm, 0, 0xD1, (ImmOne, Rm64), RF_W,   \
                  ext)                                                        \
    ABURI_X86_ISA(Stem##QI, stem "q", Modrm, 0, 0xC1, (Imm8u, Rm64), RF_W,    \
                  ext)                                                        \
    ABURI_X86_ISA(Stem##QCl, stem "q", Modrm, 0, 0xD3, (Cl, Rm64), RF_W, ext)

#define ABURI_X86_UNARY(Stem, stem, ext)                                      \
    ABURI_X86_ISA(Stem##B, stem "b", Modrm, 0, 0xF6, (Rm8), RF_NONE, ext)     \
    ABURI_X86_ISA(Stem##W, stem "w", Modrm, 0x66, 0xF7, (Rm16), RF_NONE, ext) \
    ABURI_X86_ISA(Stem##L, stem "l", Modrm, 0, 0xF7, (Rm32), RF_NONE, ext)    \
    ABURI_X86_ISA(Stem##Q, stem "q", Modrm, 0, 0xF7, (Rm64), RF_W, ext)

#define ABURI_X86_SSE_ARITH(Stem, stem, opcode)                               \
    ABURI_X86_ISA(Stem##SS, stem "ss", Modrm, 0xF3, opcode, (RmX, Xmm),       \
                  RF_NONE, 0)                                                 \
    ABURI_X86_ISA(Stem##SD, stem "sd", Modrm, 0xF2, opcode, (RmX, Xmm),       \
                  RF_NONE, 0)                                                 \
    ABURI_X86_ISA(Stem##PS, stem "ps", Modrm, 0, opcode, (RmX, Xmm), RF_NONE, \
                  0)                                                          \
    ABURI_X86_ISA(Stem##PD, stem "pd", Modrm, 0x66, opcode, (RmX, Xmm),       \
                  RF_NONE, 0)

ABURI_X86_ISA(MovBMr, "movb", Modrm, 0, 0x88, (Gpr8, Rm8), RF_NONE, 0)
